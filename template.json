        {"name": "pandoc", "options": {"from": "html", "to": "docx", "args": "--filter=pandoc-docx-pagebreakpy --lua-filter=src/word/pilot.lua --lua-filter=src/word/preservation-reading.lua --reference-doc=src/word/reference.docx"}}
