{# PDF-only: bounded rows in an ordinary 4..32-row table. Original captured
   fragments remain authoritative. No whole-table keep or prose reconstruction. #}
{%- macro classify(row, result) -%}
  {%- set result.ok = true -%}
  {%- set fixed = [
    'div class="answer-detail"',
    'div class="answer-detail" data-fact-id="resource-justification" data-status="complete"',
    'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-justification" data-status="missing"',
    'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-allocation" data-status="missing"',
    'p data-fact-id="resource-amount-value" data-status="complete"',
    'p data-fact-id="resource-currency" data-status="complete"',
    'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-amount" data-status="missing"',
    'p data-fact-id="cost-coverage" data-status="complete"',
    'p class="data-gap" data-fact-id="grant-number" data-status="missing"',
    'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="cost-coverage" data-status="missing"'
  ] -%}
  {%- for value, limit, paragraphs, tokenLimit in [(row.title, 80, 1, 40), (row.purpose, 240, 3, 40), (row.budget, 80, 3, 12), (row.funding, 100, 3, 20)] -%}
    {%- set visible = (value|striptags).split()|join(' ') -%}
    {%- set size = namespace(width=0, token=0) -%}
    {%- if not visible or value|length > 3000 or not 1 <= value.count('<p') <= paragraphs -%}{%- set result.ok = false -%}{%- endif -%}
    {%- for character in visible -%}
      {%- set size.width = size.width + (2 if character >= '⺀' else 1) -%}
      {%- set size.token = 0 if character >= '⺀' or character in ' -/' else size.token + 1 -%}
      {%- if size.token > tokenLimit -%}{%- set result.ok = false -%}{%- endif -%}
    {%- endfor -%}
    {%- if size.width > limit -%}{%- set result.ok = false -%}{%- endif -%}
    {%- set stack = [] -%}
    {%- if value.split('<', 1)[0]|trim -%}{%- set result.ok = false -%}{%- endif -%}
    {%- for fragment in value.split('<')[1:] -%}
      {%- set tag = fragment.split('>', 1)[0] -%}
      {%- set content = fragment.split('>', 1)[-1] -%}
      {%- set name = tag.split(' ', 1)[0] -%}
      {%- if tag.startswith('/') -%}
        {%- if stack and stack[-1] == tag[1:] -%}{%- do stack.pop() -%}
        {%- else -%}{%- set result.ok = false -%}{%- endif -%}
      {%- else -%}
        {%- if tag not in ['p', 'strong', 'em', 'code'] and tag not in fixed -%}{%- set result.ok = false -%}{%- endif -%}
        {%- set parent = stack[-1] if stack else '' -%}
        {%- if (name == 'div' and parent != '') or (name == 'p' and parent not in ['', 'div']) or (name in ['strong', 'em', 'code'] and parent != 'p') -%}{%- set result.ok = false -%}{%- endif -%}
        {%- do stack.append(name) -%}
      {%- endif -%}
      {%- if content|trim and (not stack or stack[-1] not in ['p', 'strong', 'em', 'code']) -%}{%- set result.ok = false -%}{%- endif -%}
    {%- endfor -%}
    {%- if stack -%}{%- set result.ok = false -%}{%- endif -%}
  {%- endfor -%}
{%- endmacro -%}

{%- macro table(original, rows) -%}
  {%- set result = namespace(value=original) -%}
  {%- if 4 <= rows|length <= 32 and original.count('<table class="resource-table">') == 1 and original.count('<tr data-item-id=') == rows|length -%}
    {%- for row in rows -%}
      {%- set eligible = namespace(ok=false) -%}
      {{- classify(row, eligible) -}}
      {%- set identity = row.id if row.id is string else '' -%}
      {%- if not 1 <= identity|length <= 256 -%}{%- set eligible.ok = false -%}{%- endif -%}
      {%- for character in identity -%}{%- if character not in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._' -%}{%- set eligible.ok = false -%}{%- endif -%}{%- endfor -%}
      {%- set opening = '<tr data-item-id="' + identity + '">' -%}
      {%- if eligible.ok and row.original is string and (row.original|trim).startswith(opening) and (row.original|trim).endswith('</tr>') and row.original.count('<td>') == row.original.count('</td>') == 3 and original.count(row.original) == 1 and original.count(opening) == 1 -%}
        {%- set hint = '<tr data-item-id="' + identity + '" class="pdf-short-resource-row" style="break-inside: avoid">' -%}
        {%- set replacement = row.original|replace(opening, hint|safe, 1) -%}
        {%- set result.value = result.value|replace(row.original, replacement|safe, 1) -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {{- result.value -}}
{%- endmacro -%}
