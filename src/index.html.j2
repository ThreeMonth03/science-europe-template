<!DOCTYPE HTML>
{%- set document_language -%}{%- include 'src/locales/language.j2' -%}{%- endset -%}
{%- set km = ctx.knowledgeModel -%}
{%- set repliesMap = ctx.project.replies -%}
{%- set report = ctx.report -%}
{%- set dc = ctx|to_context_obj -%}
{% import "src/macros.html.j2" as macros with context %}
{% import "src/uuids.j2" as uuids with context %}
{% import "src/globals.j2" as globals with context %}
<html lang="{{ document_language }}">
  <head>
    <title>{{ pgettext("index", "Data Management Plan") }}</title>
    <meta charset="utf-8">
    <style>
      {% if document_language == 'zh-Hant' %}{% include 'src/locales/zh-Hant/style.css' %}{% else %}{% include "src/style.css" %}{% endif %}
      {% include "src/layout.css" %}
    </style>
  </head>
  <body>
    <article class="dmp">
      {% include "src/frontmatter.html.j2" with context %}
      {% if dc.project.versions|length > 0 %}{% include "src/versions.html.j2" with context %}{% endif %}
      {% include "src/projects.html.j2" with context %}
      {% include "src/contributors.html.j2" with context %}
      {% include "src/content.html.j2" with context %}
      {% include "src/document-provenance.html.j2" with context %}
    </article>
  </body>
</html>
