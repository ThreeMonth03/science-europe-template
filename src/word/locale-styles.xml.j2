{# Stock enrich-docx: keep English Pandoc styles byte-for-byte, and change only
   the English/Chinese prepared-reference differences for the supported locale.
   Do not replace styles.xml wholesale: Pandoc may add user/custom styles. #}
{%- set document_language -%}{%- include 'src/locales/language.j2' -%}{%- endset -%}
{%- if document_language == 'en' -%}
  {{- content|safe -}}
{%- else -%}
  {%- macro require(ok) -%}
    {%- if not ok -%}{{ locale_styles_xml_contract_mismatch.raise_error() }}{%- endif -%}
  {%- endmacro -%}
  {# These 74 reference-owned styles differ only in run language, except for
     the five separately guarded line-spacing changes below. Unknown styles
     and docDefaults are intentionally not rewritten. #}
  {%- set language_styles = [
    'Normal', 'Heading1', 'Heading2', 'Heading3', 'Heading4', 'Heading5',
    'Heading6', 'Heading7', 'Heading8', 'Heading9', 'DefaultParagraphFont',
    'BodyText', 'FirstParagraph', 'Compact', 'Title', 'Subtitle', 'Author',
    'Date', 'Abstract', 'Bibliography', 'BlockText', 'FootnoteText',
    'DefinitionTerm', 'Definition', 'Caption', 'TableCaption', 'ImageCaption',
    'Figure', 'CaptionedFigure', 'CaptionChar', 'VerbatimChar', 'SectionNumber',
    'FootnoteReference', 'Hyperlink', 'TOCHeading', 'SourceCode', 'KeywordTok',
    'DataTypeTok', 'DecValTok', 'BaseNTok', 'FloatTok', 'ConstantTok', 'CharTok',
    'SpecialCharTok', 'StringTok', 'VerbatimStringTok', 'SpecialStringTok',
    'ImportTok', 'CommentTok', 'DocumentationTok', 'AnnotationTok', 'CommentVarTok',
    'OtherTok', 'FunctionTok', 'VariableTok', 'ControlFlowTok', 'OperatorTok',
    'BuiltInTok', 'ExtensionTok', 'PreprocessorTok', 'AttributeTok', 'RegionMarkerTok',
    'InformationTok', 'WarningTok', 'AlertTok', 'ErrorTok', 'NormalTok', 'Header',
    'HeaderChar', 'Footer', 'FooterChar', 'PlaceholderText', 'UnresolvedMention',
    'FollowedHyperlink'
  ] -%}
  {%- set old_language = '<w:lang w:eastAsia="zh-TW" w:val="en-GB" />' -%}
  {%- set new_language = '<w:lang w:eastAsia="zh-TW" w:val="zh-TW" />' -%}
  {%- for identifier in language_styles -%}
    {{- require(content.count('w:styleId="' ~ identifier ~ '"') == 1) -}}
  {%- endfor -%}
  {%- set pieces = content.split('<w:style ') -%}
  {{- require(pieces|length > 1) -}}
  {{- pieces[0]|safe -}}
  {%- for piece in pieces[1:] -%}
    {%- set parts = piece.split('</w:style>', 1) -%}
    {{- require(parts|length == 2) -}}
    {%- set style = parts[0] -%}
    {%- set opening = style.split('>', 1)[0] -%}
    {{- require(opening.count('w:styleId="') == 1) -}}
    {%- set identifier = opening.split('w:styleId="', 1)[1].split('"', 1)[0] -%}
    {%- if identifier in language_styles -%}
      {{- require(style.count(old_language) == 1) -}}
      {%- set style = style.replace(old_language, new_language, 1) -%}
      {%- if identifier in ['Normal', 'BodyText', 'FirstParagraph', 'Compact'] -%}
        {%- set after = '40' if identifier == 'Compact' else '80' -%}
        {%- set old_spacing = '<w:spacing w:after="' ~ after ~ '" w:before="0" w:line="288" w:lineRule="auto" />' -%}
        {%- set new_spacing = '<w:spacing w:after="' ~ after ~ '" w:before="0" w:line="216" w:lineRule="auto" />' -%}
        {{- require(style.count(old_spacing) == 1) -}}
        {%- set style = style.replace(old_spacing, new_spacing, 1) -%}
      {%- elif identifier == 'Heading1' -%}
        {%- set old_spacing = '<w:spacing w:after="120" w:before="240" w:line="288" w:lineRule="auto" />' -%}
        {%- set new_spacing = '<w:spacing w:after="120" w:before="240" w:line="525" w:lineRule="atLeast" />' -%}
        {{- require(style.count(old_spacing) == 1) -}}
        {%- set style = style.replace(old_spacing, new_spacing, 1) -%}
      {%- endif -%}
    {%- endif -%}
    {{- ('<w:style ' ~ style ~ '</w:style>' ~ parts[1])|safe -}}
  {%- endfor -%}
{%- endif -%}
