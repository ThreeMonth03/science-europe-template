{# Consume only Lua-generated bounded-table markers in stock Pandoc XML.
   A changed serialization fails the render; never globally rewrite all rows.
   User text is already XML-escaped by Pandoc. Never unescape or reinterpret it. #}
{%- macro require(ok) -%}
  {%- if not ok -%}{{ short_table_xml_contract_mismatch.raise_error() }}{%- endif -%}
{%- endmacro -%}
{# The scoped first-section Lua guard marks only a real frontmatter boundary.
   Add a paragraph property to Heading2; never insert a blank page-break paragraph. #}
{%- set body_marker = '<!--DSW:SE:body-start:v1-->' -%}
{%- if body_marker in content -%}
  {{- require(content.count(body_marker) == 1) -}}
  {%- set boundary = content.split(body_marker, 1) -%}
  {%- set heading = boundary[1].split('</w:pPr>', 1) -%}
  {{- require(heading|length == 2 and heading[0].count('<w:p>') == 1 and heading[0].count('<w:pPr>') == 1 and heading[0].rstrip().endswith('<w:pStyle w:val="Heading2" />') and '<w:pageBreakBefore' not in heading[0]) -}}
  {%- set content = boundary[0] + heading[0] + '<w:pageBreakBefore/></w:pPr>' + heading[1] -%}
{%- endif -%}
{# A generated large Chinese Word roster starts at its own unchanged Heading2. #}
{%- set roster_marker = '<!--DSW:SE:roster-start:v1-->' -%}
{%- if roster_marker in content -%}
  {{- require(content.count(roster_marker) == 1) -}}
  {%- set boundary = content.split(roster_marker, 1) -%}
  {%- set heading = boundary[1].split('</w:pPr>', 1) -%}
  {{- require(heading|length == 2 and heading[0].count('<w:p>') == 1 and heading[0].count('<w:pPr>') == 1 and heading[0].rstrip().endswith('<w:pStyle w:val="Heading2" />') and '<w:pageBreakBefore' not in heading[0]) -}}
  {%- set content = boundary[0] + heading[0] + '<w:pageBreakBefore/></w:pPr>' + heading[1] -%}
{%- endif -%}
{# Independent Q15 authored-row contract. Lua has bounded each ordinary cell;
   preserve its two paragraphs/cells exactly and keep only this one body row. #}
{#- Q8 uses the same exact two-cell contract after its independent ownership guard. -#}
{%- set content = content.replace('<!--DSW:SE:authored-reuse-row:v1-->', '<!--DSW:SE:authored-resource-row:v1-->') -%}
{#- Q10 authorization rows share the same independent bounded two-cell contract. -#}
{%- set content = content.replace('<!--DSW:SE:authored-authorization-row:v1-->', '<!--DSW:SE:authored-resource-row:v1-->') -%}
{#- Q2 non-standard-format reasons use the same bounded body-row contract. -#}
{%- set content = content.replace('<!--DSW:SE:authored-format-row:v1-->', '<!--DSW:SE:authored-resource-row:v1-->') -%}
{%- set authored_marker = '<!--DSW:SE:authored-resource-row:v1-->' -%}
{%- if authored_marker in content -%}
  {%- set authored_rows = content.split('<w:tr>') -%}
  {{- require(authored_marker not in authored_rows[0]) -}}
  {%- set content -%}
    {{- authored_rows[0]|safe -}}
    {%- for chunk in authored_rows[1:] -%}
      <w:tr>
      {%- if authored_marker not in chunk -%}{{- chunk|safe -}}{%- else -%}
        {%- set parts = chunk.split('</w:tr>', 1) -%}
        {{- require(parts|length == 2 and parts[0].count(authored_marker) == 1 and authored_marker not in parts[1]) -}}
        {%- set row = parts[0] -%}
        {%- set prefix = row.split(authored_marker)[0] -%}
        {{- require(row.startswith('<w:tc>') and prefix.count('<w:tc>') == 1 and '<w:p>' not in prefix and prefix.rstrip().endswith(('</w:tcPr>', '<w:tcPr />'))) -}}
        {{- require(row.count('<w:tc>') == 2 and row.count('</w:tc>') == 2 and row.count('<w:p>') == 2) -}}
        {{- require('<w:tbl' not in row and '<w:trPr' not in row and '<w:cantSplit' not in row and '<w:gridSpan' not in row and '<w:vMerge' not in row) -}}
        {%- for cell in row.split('<w:tc>')[1:] -%}
          {{- require(cell.split('</w:tc>', 1)[0].count('<w:p>') == 1) -}}
        {%- endfor -%}
        {%- for paragraphToken in row.split('<w:p')[1:] -%}
          {{- require(paragraphToken.startswith('>') or paragraphToken.startswith('Pr>') or paragraphToken.startswith('Style ')) -}}
        {%- endfor -%}
        <w:trPr><w:cantSplit/></w:trPr>{{- row.replace(authored_marker, '', 1)|safe -}}</w:tr>{{- parts[1]|safe -}}
      {%- endif -%}
    {%- endfor -%}
  {%- endset -%}
{%- endif -%}
{# Independent two-cell contract; never relax the historical three-cell marker.
   Only the scoped Lua metadata guard may emit this marker, not authored text. #}
{%- set funding_marker = '<!--DSW:SE:funding-metadata-row:v1-->' -%}
{%- if funding_marker in content -%}
  {%- set funding_rows = content.split('<w:tr>') -%}
  {{- require(funding_marker not in funding_rows[0]) -}}
  {%- set content -%}
    {{- funding_rows[0]|safe -}}
    {%- for chunk in funding_rows[1:] -%}
      <w:tr>
      {%- if funding_marker not in chunk -%}{{- chunk|safe -}}{%- else -%}
        {%- set parts = chunk.split('</w:tr>', 1) -%}
        {{- require(parts|length == 2 and parts[0].count(funding_marker) == 1 and funding_marker not in parts[1]) -}}
        {%- set row = parts[0] -%}
        {%- set prefix = row.split(funding_marker)[0] -%}
        {{- require(row.startswith('<w:tc>') and prefix.count('<w:tc>') == 1 and '<w:p>' not in prefix and prefix.rstrip().endswith(('</w:tcPr>', '<w:tcPr />'))) -}}
        {{- require(row.count('<w:tc>') == 2 and row.count('</w:tc>') == 2 and row.count('<w:p>') <= 7) -}}
        {{- require('<w:tbl' not in row and '<w:trPr' not in row and '<w:cantSplit' not in row and '<w:gridSpan' not in row and '<w:vMerge' not in row) -}}
        <w:trPr><w:cantSplit/></w:trPr>{{- row.replace(funding_marker, '', 1)|safe -}}</w:tr>{{- parts[1]|safe -}}
      {%- endif -%}
    {%- endfor -%}
  {%- endset -%}
{%- endif -%}
{# Only a Lua-validated short final full-width budget row may not split.
   This is independent of ordinary three-cell row keeps; do not relax those
   guards or prevent a long authored paragraph from spanning pages. #}
{%- set tail_marker = '<!--DSW:SE:long-budget-tail:v1-->' -%}
{%- if tail_marker in content -%}
  {%- set tail_rows = content.split('<w:tr>') -%}
  {{- require(tail_marker not in tail_rows[0]) -}}
  {%- set content -%}
    {{- tail_rows[0]|safe -}}
    {%- for chunk in tail_rows[1:] -%}
      <w:tr>
      {%- if tail_marker not in chunk -%}{{- chunk|safe -}}{%- else -%}
        {%- set parts = chunk.split('</w:tr>', 1) -%}
        {{- require(parts|length == 2 and parts[0].count(tail_marker) == 1 and tail_marker not in parts[1]) -}}
        {%- set row = parts[0] -%}
        {%- set prefix = row.split(tail_marker)[0] -%}
        {{- require(row.startswith('<w:tc>') and prefix.rstrip().endswith('</w:tcPr>') and '<w:p>' not in prefix) -}}
        {{- require(row.count('<w:tc>') == 1 and row.count('</w:tc>') == 1 and row.count('<w:p>') == 1) -}}
        {{- require(row.count('<w:gridSpan w:val="3" />') == 1 and '<w:vMerge' not in row and '<w:tbl' not in row and '<w:trPr' not in row) -}}
        {{- require(parts[1].lstrip().startswith('</w:tbl>')) -}}
        <w:trPr><w:cantSplit/></w:trPr>{{- row.replace(tail_marker, '', 1)|safe -}}</w:tr>{{- parts[1]|safe -}}
      {%- endif -%}
    {%- endfor -%}
  {%- endset -%}
{%- endif -%}
{# Only Lua-validated short Q15 rows receive this marker. Preserve every cell,
   paragraph and run; long/complex rows and other tables remain unchanged. #}
{%- set budget_marker = '<!--DSW:SE:budget-row:v1-->' -%}
{# Only the existing whole-short-budget guard emits this alias on nonfinal rows.
   It joins at most three bounded rows, never a long table or later content. #}
{%- set budget_next_marker = '<!--DSW:SE:bounded-budget-next-row:v1-->' -%}
{# Keep marker identity until each row is checked: history rows must not receive
   the budget-label override. Authored text cannot forge these escaped markers. #}
{%- set history_marker = '<!--DSW:SE:history-row:v1-->' -%}
{%- if budget_marker in content or history_marker in content or budget_next_marker in content -%}
  {%- set budget_rows = content.split('<w:tr>') -%}
  {{- require(budget_marker not in budget_rows[0] and history_marker not in budget_rows[0] and budget_next_marker not in budget_rows[0]) -}}
  {%- set content -%}
    {{- budget_rows[0]|safe -}}
    {%- for chunk in budget_rows[1:] -%}
      <w:tr>
      {%- set history_row = history_marker in chunk -%}
      {%- set budget_next_row = budget_next_marker in chunk -%}
      {%- set chunk = chunk.replace(history_marker, budget_marker|safe).replace(budget_next_marker, budget_marker|safe) -%}
      {%- if budget_marker not in chunk -%}{{- chunk|safe -}}{%- else -%}
        {%- set parts = chunk.split('</w:tr>', 1) -%}
        {{- require(parts|length == 2 and parts[0].count(budget_marker) == 1 and budget_marker not in parts[1]) -}}
        {%- set row = parts[0] -%}
        {%- set prefix = row.split(budget_marker)[0] -%}
        {{- require(prefix.count('<w:tc>') == 1 and '<w:p>' not in prefix and prefix.rstrip().endswith(('</w:tcPr>', '<w:tcPr />'))) -}}
        {{- require(row.count('<w:tc>') == 3 and row.count('</w:tc>') == 3 and row.count('<w:p>') <= 10) -}}
        {{- require('<w:tbl>' not in row and '<w:cantSplit' not in row and '<w:gridSpan' not in row and '<w:vMerge' not in row) -}}
        {%- set row = row.replace(budget_marker, '', 1) -%}
        {# cantSplit already keeps this bounded row intact. A label's inherited
           keepNext can instead push the whole budget to the next page in Writer.
           Override only its first paragraph; never headers or unbounded rows. #}
        {%- set label_style = '<w:pPr><w:pStyle w:val="PilotBudgetLabel" />' -%}
        {%- set first_cell = row.split('</w:tc>', 1)[0] -%}
        {%- set first_paragraph = first_cell.split('<w:p>', 1)[1].split('</w:p>', 1)[0] if '<w:p>' in first_cell else '' -%}
        {%- if budget_next_row -%}
          {{- require(not history_row and '<w:tblHeader' not in row and '<w:keepNext' not in row) -}}
          {{- require(3 <= row.count('<w:p>') <= 10 and row.count('</w:p>') == row.count('<w:p>')) -}}
          {%- for token in row.split('<w:p')[1:] -%}
            {{- require(token.startswith('>') or token.startswith('Pr>') or token.startswith('Style ')) -}}
          {%- endfor -%}
          {%- set paragraphs = row.split('<w:p>') -%}
          {%- set row -%}
            {{- paragraphs[0]|safe -}}
            {%- for paragraph in paragraphs[1:] -%}
              <w:p>
              {%- if paragraph.startswith('<w:pPr>') -%}
                {{- require(paragraph.count('<w:pPr>') == 1 and paragraph.count('</w:pPr>') == 1) -}}
                {{- paragraph.replace('</w:pPr>', '<w:keepNext/></w:pPr>'|safe, 1)|safe -}}
              {%- else -%}
                {{- require('<w:pPr' not in paragraph) -}}
                <w:pPr><w:keepNext/></w:pPr>{{- paragraph|safe -}}
              {%- endif -%}
            {%- endfor -%}
          {%- endset -%}
        {%- elif not history_row and '<w:tblHeader' not in row and first_paragraph.startswith(label_style) -%}
          {{- require('<w:keepNext' not in first_paragraph) -}}
          {%- set row = row.replace(label_style, (label_style + '<w:keepNext w:val="0"/>')|safe, 1) -%}
        {%- endif -%}
        {%- if row.startswith('<w:trPr>') -%}
          {{- require(row.count('<w:trPr>') == 1 and row.count('</w:trPr>') == 1) -}}
          {{- row.replace('</w:trPr>', '<w:cantSplit/></w:trPr>'|safe, 1)|safe -}}
        {%- else -%}
          {{- require(row.startswith('<w:tc>') and '<w:trPr' not in row) -}}
          <w:trPr><w:cantSplit/></w:trPr>{{- row|safe -}}
        {%- endif -%}
        </w:tr>{{- parts[1]|safe -}}
      {%- endif -%}
    {%- endfor -%}
  {%- endset -%}
{%- endif -%}
{%- set begin = '<!--DSW:SE:short-table:v1:begin-->\n    ' -%}
{%- set end = '\n    <!--DSW:SE:short-table:v1:end-->' -%}
{{- require(content is string) -}}
{%- set pieces = content.split(begin) -%}
{{- require(content.count('<!--DSW:SE:short-table:v1:begin-->') == pieces|length - 1) -}}
{{- require(content.count('<!--DSW:SE:short-table:v1:end-->') == pieces|length - 1) -}}
{{- require(end not in pieces[0]) -}}
{{- pieces[0]|safe -}}
{%- for piece in pieces[1:] -%}
  {%- set parts = piece.split(end) -%}
  {{- require(parts|length == 2) -}}
  {%- set table = parts[0] -%}
  {{- require(table.startswith('<w:tbl>') and table.endswith('</w:tbl>')) -}}
  {{- require(table.count('<w:tbl>') == 1 and table.count('</w:tbl>') == 1) -}}
  {{- require('<w:cantSplit' not in table and '<w:gridSpan' not in table and '<w:vMerge' not in table) -}}
  {%- set rows = table.split('<w:tr>') -%}
  {{- require(3 <= rows|length <= 5 and table.count('</w:tr>') == rows|length - 1) -}}
  {{- rows[0]|safe -}}
  {%- for row in rows[1:] -%}
    {%- set cells = row.count('<w:tc>') -%}
    {{- require(2 <= cells <= 4 and row.count('</w:tc>') == cells and row.count('<w:p>') == cells) -}}
    {# Reject self-closing/attributed/additional paragraph variants as well. #}
    {%- for paragraphToken in row.split('<w:p')[1:] -%}
      {{- require(paragraphToken.startswith('>') or paragraphToken.startswith('Pr>') or paragraphToken.startswith('Style ')) -}}
    {%- endfor -%}
    {%- set style = 'Compact' if loop.last else 'PilotTableLead' -%}
    {{- require(row.count('<w:pStyle w:val="' + style + '" />') == cells) -}}
    <w:tr>
    {%- if row.startswith('<w:trPr>') -%}
      {{- require(row.count('<w:trPr>') == 1 and row.count('</w:trPr>') == 1) -}}
      {{- row.replace('</w:trPr>', '<w:cantSplit/></w:trPr>', 1)|safe -}}
    {%- else -%}
      {{- require(row.startswith('<w:tc>') and '<w:trPr' not in row) -}}
      <w:trPr><w:cantSplit/></w:trPr>{{- row|safe -}}
    {%- endif -%}
  {%- endfor -%}
  {{- parts[1]|safe -}}
{%- endfor -%}
