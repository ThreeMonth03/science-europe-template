<h2>{{ pgettext("word/versions", "History of changes") }}</h2>

{% if dc.project.versions|length > 0 %}
<table class="version-history">
  <thead>
    <tr>
      <th>{{ pgettext("word/versions", "Version") }}</th>
      <th>{{ pgettext("word/versions", "Publication date") }}</th>
      <th>{{ pgettext("word/versions", "Changes") }}</th>
    </tr>
  </thead>
  <tbody>
  {% for version in dc.project.versions|reverse %}
    <tr>
      <td>{{ version.name }}</td>
      <td>{{ version.created_at|datetime_format("%d %b %Y") }}</td>
      <td>{{ version.description }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
{{ pgettext("word/versions", "<p><em>There are no named versions.</em></p>") }}
{% endif %}
