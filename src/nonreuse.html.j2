{# Source/location is metadata, never an unfinished sentence prefix. Authored
   reasons remain Markdown blocks outside the template-owned paragraph. #}
{%- import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
{%- macro render(source, reason, detail, noData, noAspect, noQuality, noConditions, other) -%}
  {%- set nonreuseSentences = [] -%}
  {%- set decisionSentence -%}{{ pgettext("nonreuse", "This dataset was considered but will not be re-used.") }}{%- endset -%}
  {%- do nonreuseSentences.append(decisionSentence) -%}
  {%- if reason == noData -%}
    {%- set reasonSentence -%}<span data-fact-id="nonreuse-reason" data-status="complete">{{ pgettext("nonreuse", "It does not contain the data required for this project.") }}</span>{%- endset -%}
    {%- do nonreuseSentences.append(reasonSentence) -%}
  {%- elif reason == noAspect -%}
    {%- set reasonSentence -%}<span data-fact-id="nonreuse-reason" data-status="complete">{{ pgettext("nonreuse", "It does not cover the aspects required for this project.") }}</span>{%- endset -%}
    {%- do nonreuseSentences.append(reasonSentence) -%}
  {%- elif reason == noQuality -%}
    {%- set reasonSentence -%}<span data-fact-id="nonreuse-reason" data-status="complete">{{ pgettext("nonreuse", "Its quality is insufficient for this project.") }}</span>{%- endset -%}
    {%- do nonreuseSentences.append(reasonSentence) -%}
  {%- elif reason == noConditions -%}
    {%- set reasonSentence -%}<span data-fact-id="nonreuse-reason" data-status="complete">{{ pgettext("nonreuse", "Its conditions of use do not permit the intended re-use.") }}</span>{%- endset -%}
    {%- do nonreuseSentences.append(reasonSentence) -%}
  {%- endif -%}
  <p class="nonreuse-summary" data-fact-id="reuse-decision" data-status="explicit-no">{{ nonreuseSentences|join("" if document_language|default('en') == 'zh-Hant' else " ") }}</p>
  {{ location(source) }}
  {% if reason == other and detail|trim %}
    <div class="answer-detail" data-fact-id="nonreuse-reason" data-status="complete">{{ pgettext("nonreuse", "<p><strong>Reason for not re-using this dataset</strong></p>") }}{{ answerMarkdown.markdown(detail) }}</div>
  {% elif reason not in [noData, noAspect, noQuality, noConditions] and output_profile|default('review') != 'submission' %}
    {% set reasonStatus = 'needs-review' if reason and reason != other else 'missing' %}
    {{ pgettext("nonreuse", "<p class=\"data-gap\" data-fact-id=\"nonreuse-reason\" data-status=\"%(reasonStatus)s\"><strong>Information not provided:</strong> why this dataset will not be re-used.</p>", reasonStatus=reasonStatus) }}
  {% endif %}
{%- endmacro -%}

{# Independent metadata survives an unanswered re-use decision. #}
{%- macro location(source) -%}
  {% if source|trim %}
    {% if source.startswith('https://') or source.startswith('http://') or source.startswith('ftp://') %}
      <p class="dataset-source" data-fact-id="dataset-source" data-status="complete">{{ pgettext("nonreuse", "Source: <a href=\"%(source)s\">%(source)s</a>", source=source) }}</p>
    {% else %}
      <p class="dataset-source" data-fact-id="dataset-source" data-status="complete">{{ pgettext("nonreuse", "Source: %(source)s", source=source) }}</p>
    {% endif %}
  {% endif %}
{%- endmacro -%}

{%- macro undecided(source) -%}
  {{ location(source) }}
  {% if output_profile|default('review') != 'submission' %}{{ pgettext("nonreuse", "<p class=\"data-gap\" data-fact-id=\"reuse-decision\" data-status=\"missing\"><strong>Information not provided:</strong> whether this dataset will be re-used.</p>") }}{% endif %}
{%- endmacro -%}
