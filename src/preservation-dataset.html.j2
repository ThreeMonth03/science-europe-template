{# Included inside Q11's dataset-policy. Only direct owned paragraphs may join.
   Description and stage are context, not evidence of preservation decisions. #}
{% set producedDescription = repliesMap[[pathPrefix, uuids.producedDataDescriptionQUuid]|reply_path]|reply_str_value %}
{% if producedDescription|trim %}
  <div class="answer-detail" data-fact-id="preservation-dataset-description" data-status="complete">{{ producedDescription|markdown }}</div>
{% endif %}
{% set stagePath = [pathPrefix, uuids.producedDataStageQUuid]|reply_path %}
{% set stage = repliesMap[stagePath]|reply_str_value %}
{% if stage == uuids.producedDataStageRawAUuid %}
  <p data-fact-id="preservation-data-stage" data-status="complete">This dataset contains raw data.</p>
{% elif stage == uuids.producedDataStageIntermediateAUuid %}
  <p data-fact-id="preservation-data-stage" data-status="complete">This dataset contains intermediate data.</p>
{% elif stage == uuids.producedDataStageUnpublishableAUuid %}
  <p data-fact-id="preservation-data-stage" data-status="complete">This dataset contains processed data leading to unpublishable results.</p>
{% elif stage == uuids.producedDataStagePublishedAUuid %}
  <p data-fact-id="preservation-data-stage" data-status="complete">This dataset contains processed data leading to published results.</p>
{% endif %}
