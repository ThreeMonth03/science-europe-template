{%- import 'src/active-answer.j2' as activeAnswer with context -%}
{%- import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
{%- macro render(parts) -%}
  {%- set ownerPath = activeAnswer.path(parts, 'ValueQuestion') -%}
  {%- set owner = repliesMap[ownerPath]|reply_str_value if ownerPath else '' -%}
  {%- if owner|trim -%}
    <div class="answer-detail" data-fact-id="reuse-rightsholder" data-status="complete">
      {{ pgettext("reuse-rightsholder", "<p><strong>Data rights holder and contact information</strong></p>") }}
      {{ answerMarkdown.markdown(owner) }}
    </div>
  {%- endif -%}
{%- endmacro -%}

{%- macro nonReferenceArrangements(parts) -%}
  {# Keep dataset-specific facts separate from project-wide collaboration or
     licence statements. A stale No follow-up is not an access requirement. #}
  {%- set sentences = [] -%}
  {%- set ownersPath = activeAnswer.path(parts + [uuids.nrefDataOwnersQUuid], 'OptionsQuestion') -%}
  {%- set owners = repliesMap[ownersPath]|reply_str_value if ownersPath else '' -%}
  {%- if ownersPath and owners in km.entities.questions[uuids.nrefDataOwnersQUuid].answerUuids and owners in km.entities.answers -%}
    {%- if owners == uuids.nrefDataOwnersYesAUuid -%}
      {%- do sentences.append(pgettext("reuse-rightsholder", "The rights holder will collaborate with us on this research.")) -%}
    {%- elif owners == uuids.nrefDataOwnersWeAUuid -%}
      {%- do sentences.append(pgettext("reuse-rightsholder", "We are the rights holder of this dataset.")) -%}
    {%- elif owners == uuids.nrefDataOwnersNoAUuid -%}
      {%- do sentences.append(pgettext("reuse-rightsholder", "The rights holder will not collaborate with us on this research.")) -%}
      {%- set requestPath = activeAnswer.path(parts + [uuids.nrefDataOwnersQUuid, uuids.nrefDataOwnersNoAUuid, uuids.nrefDataOwnersNoReqQUuid], 'OptionsQuestion') -%}
      {%- set request = repliesMap[requestPath]|reply_str_value if requestPath else '' -%}
      {%- if requestPath and request in km.entities.questions[uuids.nrefDataOwnersNoReqQUuid].answerUuids and request in km.entities.answers -%}
        {%- if request == uuids.nrefDataOwnersNoReqYesAUuid -%}
          {%- do sentences.append(pgettext("reuse-rightsholder", "We need to apply for access to this dataset.")) -%}
        {%- elif request == uuids.nrefDataOwnersNoReqNoAUuid -%}
          {%- do sentences.append(pgettext("reuse-rightsholder", "No application for data access is required.")) -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- set accessPath = activeAnswer.path(parts + [uuids.nrefDataAccessQUuid], 'OptionsQuestion') -%}
  {%- set access = repliesMap[accessPath]|reply_str_value if accessPath else '' -%}
  {%- if accessPath and access in km.entities.questions[uuids.nrefDataAccessQUuid].answerUuids and access in km.entities.answers -%}
    {%- if access == uuids.nrefDataAccessHaveCopyAUuid -%}
      {%- do sentences.append(pgettext("reuse-rightsholder", "We already have a copy of this dataset.")) -%}
    {%- elif access == uuids.nrefDataAccessWillDownloadAUuid -%}
      {%- do sentences.append(pgettext("reuse-rightsholder", "We will download or obtain a copy of this dataset.")) -%}
    {%- elif access == uuids.nrefDataAccessWillOnlineAUuid -%}
      {%- do sentences.append(pgettext("reuse-rightsholder", "We will use this dataset online.")) -%}
    {%- endif -%}
  {%- endif -%}
  {%- if sentences -%}
    <p class="dataset-policy" data-fact-id="reuse-access-arrangements" data-status="complete">{{ sentences|join("" if document_language|default('en') == 'zh-Hant' else " ") }}</p>
  {%- endif -%}
{%- endmacro -%}
