{# Translate complete statements, not independent positive/negative fragments.
   Both fact markers remain when two known answers share one sentence. #}
{%- set personalKnown = containPersonal in [uuids.containPersonalYesAUuid, uuids.containPersonalNoAUuid] -%}
{%- set sensitiveKnown = containSensitive in [uuids.containSensitiveYesAUuid, uuids.containSensitiveNoAUuid] -%}
{%- if personalKnown or sensitiveKnown -%}
<span class="ethical-data-statement">
{%- if personalKnown -%}<span data-fact-id="dataset-personal-data" data-status="{{ 'complete' if containPersonal == uuids.containPersonalYesAUuid else 'explicit-no' }}">{%- endif -%}
{%- if sensitiveKnown -%}<span data-fact-id="dataset-sensitive-data" data-status="{{ 'complete' if containSensitive == uuids.containSensitiveYesAUuid else 'explicit-no' }}">{%- endif -%}
{%- if personalKnown and sensitiveKnown -%}
  {%- if containPersonal == uuids.containPersonalYesAUuid and containSensitive == uuids.containSensitiveYesAUuid -%}
    {{ pgettext("ethics-data-summary", "This dataset contains personal and sensitive data.") }}
  {%- elif containPersonal == uuids.containPersonalYesAUuid -%}
    {{ pgettext("ethics-data-summary", "This dataset contains personal data but no sensitive data.") }}
  {%- elif containSensitive == uuids.containSensitiveYesAUuid -%}
    {{ pgettext("ethics-data-summary", "This dataset contains sensitive data but no personal data.") }}
  {%- else -%}
    {{ pgettext("ethics-data-summary", "This dataset contains neither personal nor sensitive data.") }}
  {%- endif -%}
{%- elif personalKnown -%}
  {%- if containPersonal == uuids.containPersonalYesAUuid -%}
    {{ pgettext("ethics-data-summary", "This dataset contains personal data.") }}
  {%- else -%}
    {{ pgettext("ethics-data-summary", "This dataset does not contain personal data.") }}
  {%- endif -%}
{%- else -%}
  {%- if containSensitive == uuids.containSensitiveYesAUuid -%}
    {{ pgettext("ethics-data-summary", "This dataset contains sensitive data.") }}
  {%- else -%}
    {{ pgettext("ethics-data-summary", "This dataset does not contain sensitive data.") }}
  {%- endif -%}
{%- endif -%}
{%- if sensitiveKnown -%}</span>{%- endif -%}
{%- if personalKnown -%}</span>{%- endif -%}
</span>
{%- endif -%}
