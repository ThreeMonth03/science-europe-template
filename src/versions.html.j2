<div id="dmp-versions">
  <table>
    <thead>
      <tr>
        <th colspan="3" class="title">{{ pgettext("versions", "History of changes") }}</th>
      </tr>
      <tr>
        <th>{{ pgettext("versions", "Version") }}</th>
        <th>{{ pgettext("versions", "Publication date") }}</th>
        <th>{{ pgettext("versions", "Changes") }}</th>
      </tr>
    </thead>
    <tbody>
      {% for version in dc.project.versions|reverse %}
        <tr>
          <td class="version-name">{{ version.name }}</td>
          <td class="version-date">{{ version.created_at|datetime_format("%d %b %Y") }}</td>
          <td class="version-changes">{{ version.description }}</td>
        </tr>
      {% else %}
        <tr>
          <td colspan="3" class="no-versions">{{ pgettext("versions", "There are no named versions") }}</tr>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
