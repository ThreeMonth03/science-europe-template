{%- import 'src/active-answer.j2' as active with context -%}
{%- set projectListParts = [uuids.adminDetailsCUuid, uuids.projectsQUuid] -%}
{%- set projectsPath = active.path(projectListParts, 'ListQuestion') -%}
{%- set projectsItems = repliesMap[projectsPath]|reply_items if projectsPath else [] -%}
{% if projectsItems or output_profile|default('review') != 'submission' %}
  {% set projectOverviewContent %}
  {% for projectsItem in projectsItems %}
    {%- set projectParts = projectListParts + [projectsItem] -%}
    {%- set projectNamePath = active.path(projectParts + [uuids.projectNameQUuid], 'ValueQuestion') -%}
    {%- set projectName = repliesMap[projectNamePath]|reply_str_value if projectNamePath else '' -%}
    {% set projectContent %}
    {%- set projectAcronymPath = active.path(projectParts + [uuids.projectAcronymQUuid], 'ValueQuestion') -%}
    {%- set projectAcronym = repliesMap[projectAcronymPath]|reply_str_value if projectAcronymPath else '' -%}
    {%- set projectNumberPath = active.path(projectParts + [uuids.projectNumberQUuid], 'ValueQuestion') -%}
    {%- set projectNumber = repliesMap[projectNumberPath]|reply_str_value if projectNumberPath else '' -%}
    {%- set projectStartPath = active.path(projectParts + [uuids.projectStartQUuid], 'ValueQuestion') -%}
    {%- set projectStart = repliesMap[projectStartPath]|reply_str_value if projectStartPath else '' -%}
    {%- set projectEndPath = active.path(projectParts + [uuids.projectEndQUuid], 'ValueQuestion') -%}
    {%- set projectEnd = repliesMap[projectEndPath]|reply_str_value if projectEndPath else '' -%}
    {%- set funderParts = projectParts + [uuids.fundersQUuid] -%}
    {%- set fundersPath = active.path(funderParts, 'ListQuestion') -%}
    {%- set fundersItems = repliesMap[fundersPath]|reply_items if fundersPath else [] -%}
    {% set fundingItems %}
      {% for fundersItem in fundersItems %}
        {%- set funderNamePath = active.path(funderParts + [fundersItem, uuids.funderNameQUuid], 'IntegrationQuestion') -%}
        {%- set funderLabel = macros.integrationCrossref(repliesMap[funderNamePath]) -%}
        {%- set grantNumberPath = active.path(funderParts + [fundersItem, uuids.grantNumberQUuid], 'ValueQuestion') -%}
        {%- set grantNumber = repliesMap[grantNumberPath]|reply_str_value -%}
        {%- set funderStatusPath = active.path(funderParts + [fundersItem, uuids.funderStatusQUuid], 'OptionsQuestion') -%}
        {%- set funderStatus = repliesMap[funderStatusPath]|reply_str_value -%}
        {% set fundingStatus %}{% if funderStatusPath and funderStatus in km.entities.questions[uuids.funderStatusQUuid].answerUuids and funderStatus in km.entities.answers %}{% if funderStatus == uuids.funderStatusPlannedAUuid %}{{ pgettext("projects", "(planned)") }}{% elif funderStatus == uuids.funderStatusAppliedAUuid %}{{ pgettext("projects", "(applied)") }}{% elif funderStatus == uuids.funderStatusGrantedAUuid %}{{ pgettext("projects", "(granted)") }}{% elif funderStatus == uuids.funderStatusRejectedAUuid %}{{ pgettext("projects", "(rejected)") }}{% endif %}{% endif %}{% endset %}
        {% if output_profile|default('review') != 'submission' or funderLabel|striptags|trim or grantNumber|trim or fundingStatus|trim %}
          <li data-item-id="{{ fundersItem }}">{% if funderLabel|striptags|trim %}{{ funderLabel }}{% endif %}{% if grantNumber|trim or output_profile|default('review') != 'submission' %}{% if funderLabel|striptags|trim %}{{ pgettext("projects", ": ") }}{% endif %}{{ grantNumber|e if grantNumber|trim else pgettext("projects", "grant number not yet given") }}{% endif %}{% if fundingStatus|trim %} {{ fundingStatus }}{% endif %}</li>
        {% endif %}
      {% endfor %}
    {% endset %}
      {% if projectAcronym|trim or projectNumber|trim or projectStart|trim or projectEnd|trim or output_profile|default('review') != 'submission' %}<table class="project-details"><tbody>
        {% if projectAcronym|trim %}<tr data-fact-id="project-acronym" data-status="complete"><th scope="row">{{ pgettext("projects", "Project acronym") }}</th><td>{{ projectAcronym|e }}</td></tr>{% endif %}
        {% if projectNumber|trim or output_profile|default('review') != 'submission' %}<tr data-fact-id="project-number"><th scope="row">{{ pgettext("projects", "Project Number") }}</th><td>{{ projectNumber|e if projectNumber|trim else pgettext("projects", "N/A") }}</td></tr>{% endif %}
        {% if projectStart|trim or output_profile|default('review') != 'submission' %}<tr data-fact-id="project-start"><th scope="row">{{ pgettext("projects", "Start date") }}</th><td>{{ projectStart|e if projectStart|trim else pgettext("projects", "N/A") }}</td></tr>{% endif %}
        {% if projectEnd|trim or output_profile|default('review') != 'submission' %}<tr data-fact-id="project-end"><th scope="row">{{ pgettext("projects", "End date") }}</th><td>{{ projectEnd|e if projectEnd|trim else pgettext("projects", "N/A") }}</td></tr>{% endif %}
      </tbody></table>{% endif %}
      {% if fundingItems|trim or output_profile|default('review') != 'submission' %}<div class="project-funding" data-fact-id="project-funding"><h4>{{ pgettext("projects", "Funding") }}</h4>
          {%- if fundingItems|trim %}
            <ul>{{ fundingItems }}</ul>
          {%- else -%}
            <p>{{ pgettext("projects", "Funding information has not been provided.") }}</p>
          {%- endif -%}
      </div>{% endif %}

    {%- set projectAbstractPath = active.path(projectParts + [uuids.projectAbstractQUuid], 'ValueQuestion') -%}
    {%- set projectAbstract = repliesMap[projectAbstractPath]|reply_str_value if projectAbstractPath else '' -%}
    {%- if projectAbstract|trim %}
      <section class="abstract">
        {{ projectAbstract|markdown }}
      </section>
    {%- endif -%}
    {% endset %}
    {% if output_profile|default('review') != 'submission' or (projectName|trim and projectsItems|length > 1) or projectContent|striptags|trim or '<img' in projectContent|lower or '<table' in projectContent|lower %}
      <div class="project" data-item-id="{{ projectsItem }}">
        {%- if projectName|trim and projectsItems|length > 1 -%}
          <h3>{{ projectName|e }}</h3>
        {%- elif not projectName|trim -%}
          {% if output_profile|default('review') == 'submission' %}<h3>{{ macros.projectLabel(projectsItems.index(projectsItem) + 1) }}</h3>{% else %}<h3 class="empty-value">{{ pgettext("projects", "(project name not given)") }}</h3>{% endif %}
        {%- endif -%}
        {{ projectContent }}
      </div>
    {% endif %}
  {% else %}
    <div style="font-style:italic;">{{ pgettext("projects", "There are no projects described for this DMP.") }}</div>
  {% endfor %}
  {% endset %}
  {% if output_profile|default('review') != 'submission' or projectOverviewContent|striptags|trim or '<img' in projectOverviewContent|lower or '<table' in projectOverviewContent|lower %}
    <div id="dmp-projects">
      <h2>{{ pgettext("projects", "Research overview") }}</h2>
      {{ projectOverviewContent }}
    </div>
  {% endif %}
{% endif %}
