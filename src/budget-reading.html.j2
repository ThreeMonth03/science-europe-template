{# Presentation only. Capture original fragments once in Q15; never parse them
   into replacement prose or modify their text/attributes/paragraph boundaries. #}
{%- macro classify(row, result) -%}
  {# Conservative height bounds, not a complete HTML parser or text validator.
     Unknown tags/attributes fall back to the original table, never lose data. #}
  {%- set result.long = row.purpose.count('<p>') >= 12 and row.purpose.count('<p>') <= 160 and row.purpose|striptags|length <= 30000 -%}
  {%- for fragment in row.purpose.split('<')[1:] -%}
    {%- set tag = fragment.split('>')[0] -%}
      {%- if tag not in ['p', '/p', 'strong', '/strong', 'em', '/em', 'code', '/code', 'ul', '/ul', 'li', '/li', '/a', '/div', 'div class="answer-detail" data-fact-id="resource-justification" data-status="complete"', 'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-allocation" data-status="missing"'] and not tag.startswith('a href="') -%}
      {%- set result.long = false -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for paragraph in row.purpose.split('<p>')[1:] -%}
    {%- if paragraph.split('</p>')[0]|striptags|length > 400 -%}{%- set result.long = false -%}{%- endif -%}
  {%- endfor -%}
  {%- if row.purpose.count('<ul>') > 1 or row.purpose.count('<li>') > 8 -%}{%- set result.long = false -%}{%- endif -%}
  {%- for value, limit in [(row.title, 80), (row.budget, 80), (row.funding, 100)] -%}
    {# Collapse source indentation for the height estimate only, never output.
       Missing values retain the original facts, wording and attributes. #}
    {%- set visible = (value|striptags).split()|join(' ') -%}
    {%- if not visible or visible|length > limit or value|length > 2000 or value.count('<p') > 3 -%}{%- set result.long = false -%}{%- endif -%}
    {%- for fragment in value.split('<')[1:] -%}
      {%- set tag = fragment.split('>')[0] -%}
      {%- if tag not in ['p', '/p', 'strong', '/strong', 'div class="answer-detail"', '/div',
        'p data-fact-id="resource-amount-value" data-status="complete"',
        'p data-fact-id="resource-currency" data-status="complete"',
        'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-amount" data-status="missing"',
        'p data-fact-id="cost-coverage" data-status="complete"',
        'p class="data-gap" data-fact-id="grant-number" data-status="missing"',
        'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="cost-coverage" data-status="missing"'] -%}{%- set result.long = false -%}{%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endmacro -%}

{%- macro short_table(original, rows, word=false) -%}
  {# An output-specific hint, not a new answer renderer. Unknown or large fragments
     retain the original table. Never trim/rewrite the captured output. #}
  {%- set selection = namespace(short=1 <= rows|length <= 3, gap=false) -%}
  {%- for row in rows -%}
    {%- set selection.gap = selection.gap or 'data-fact-id="resource-amount" data-status="missing"' in row.budget -%}
    {%- for field, value, limit, paragraphs in [('title', row.title, 80, 1), ('purpose', row.purpose, 200, 2), ('budget', row.budget, 80, 3), ('funding', row.funding, 100, 3)] -%}
      {%- set visible = (value|striptags).split()|join(' ') -%}
      {# Submission may omit scalar metadata. Truly empty cells add no height;
         empty markup, titles/purposes and Word retain the original fallback. #}
      {%- set emptyMetadata = not word and field in ['budget', 'funding'] and not value|trim -%}
      {%- if (not visible and not emptyMetadata) or visible|length > limit or value|length > 2000 or value.count('<p') > paragraphs -%}
        {%- set selection.short = false -%}
      {%- endif -%}
      {%- for fragment in value.split('<')[1:] -%}
        {%- set tag = fragment.split('>')[0] -%}
        {%- if tag not in ['p', '/p', 'strong', '/strong', 'em', '/em', 'code', '/code', '/div',
          'div class="answer-detail"',
          'div class="answer-detail" data-fact-id="resource-justification" data-status="complete"',
          'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-justification" data-status="missing"',
          'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-allocation" data-status="missing"',
          'p data-fact-id="resource-amount-value" data-status="complete"',
          'p data-fact-id="resource-currency" data-status="complete"',
          'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-amount" data-status="missing"',
          'p data-fact-id="cost-coverage" data-status="complete"',
          'p class="data-gap" data-fact-id="grant-number" data-status="missing"',
          'p class="data-gap" data-requirement-id="SE-6b" data-fact-id="cost-coverage" data-status="missing"'] -%}
          {%- set selection.short = false -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- if selection.short and selection.gap -%}
    {%- if word -%}
      {{- original|replace('<table class="resource-table">', '<table class="resource-table word-short-budget">'|safe, 1) -}}
    {%- else -%}
      {{- original|replace('<table class="resource-table">', '<table class="resource-table pdf-short-budget">'|safe, 1) -}}
    {%- endif -%}
  {%- elif selection.short and not word -%}
    {{- original|replace('<table class="resource-table">', '<table class="resource-table pdf-bounded-budget">'|safe, 1) -}}
  {%- else -%}{{ original }}{%- endif -%}
{%- endmacro -%}

{%- macro funding_records(header, rows, metadataHeader, fundingLabel, word=false) -%}
  {# A funding table must not be nested in the narrow third budget cell.
     Keep each original fragment and ordinal; only its presentation changes. #}
  {%- set pending = [] -%}
  {%- for row in rows -%}
    {%- if '<table' in row.funding -%}
      {%- if pending -%}{{ funding_fallback(header, pending, word) }}{%- do pending.clear() -%}{%- endif -%}
      <table class="{{ 'word' if word else 'pdf' }}-rich-funding-metadata" data-item-id="{{ row.id }}"><colgroup><col class="resource-purpose"><col class="resource-budget"></colgroup><thead><tr>{{ metadataHeader }}</tr></thead><tbody><tr data-item-id="{{ row.id }}"><td>{{ row.title }}</td><td>{{ row.budget }}</td></tr></tbody></table>
      {%- if row.purpose|trim -%}
        <div class="{{ 'word-rich-resource-purpose' if word else 'pdf-rich-funding-purpose' }}" data-item-id="{{ row.id }}">{{ row.purpose }}</div>
      {%- endif -%}
      <div class="{{ 'word-rich-resource-funding' if word else 'pdf-rich-funding-detail' }}" data-item-id="{{ row.id }}"><div class="answer-lead"><p><strong>{{ fundingLabel }}</strong></p></div>{{ row.funding }}</div>
    {%- else -%}{%- do pending.append(row) -%}{%- endif -%}
  {%- endfor -%}
  {%- if pending -%}{{ funding_fallback(header, pending, word) }}{%- endif -%}
{%- endmacro -%}

{%- macro funding_fallback(header, rows, word) -%}
  {%- set original -%}<table class="resource-table"><colgroup><col class="resource-purpose"><col class="resource-budget"><col class="resource-funding"></colgroup><thead>{{ header }}</thead><tbody>{% for row in rows %}{{ row.original }}{% endfor %}</tbody></table>{%- endset -%}
  {{- word_table(original, header, rows) if word else render(original, header, rows) -}}
{%- endmacro -%}

{%- macro word_table(original, header, rows, metadataHeader='', fundingLabel='') -%}
  {# Word readers mispaginate tables nested in a resource row. Keep authored
     table purposes as standalone blocks; reuse all captured text unchanged.
     Ordinary purposes retain their existing table and pagination path. #}
  {%- set selection = namespace(table=false, funding=false) -%}
  {%- for row in rows -%}
    {%- set selection.table = selection.table or '<table' in row.purpose -%}
    {%- set selection.funding = selection.funding or '<table' in row.funding -%}
  {%- endfor -%}
  {%- if selection.funding and metadataHeader and fundingLabel -%}{{ funding_records(header, rows, metadataHeader, fundingLabel, true) }}
  {%- elif not selection.table -%}{{ short_table(original, rows, true) }}
  {%- else -%}
    {%- for row in rows -%}
      <table class="resource-table word-rich-budget-metadata"><colgroup><col class="resource-purpose"><col class="resource-budget"><col class="resource-funding"></colgroup><thead>{{ header }}</thead><tbody><tr data-item-id="{{ row.id }}"><td>{{ row.title }}</td><td>{{ row.budget }}</td><td>{{ row.funding }}</td></tr></tbody></table>
      <div class="word-rich-resource-purpose" data-item-id="{{ row.id }}">{{ row.purpose }}</div>
    {%- endfor -%}
  {%- endif -%}
{%- endmacro -%}

{%- macro ordinary(header, rows) -%}
{%- if rows|length > 32 -%}
  {%- for group in rows|batch(32) -%}{{ ordinary(header, group) }}{%- endfor -%}
{%- else -%}
{%- set original -%}<table class="resource-table"><colgroup><col class="resource-purpose"><col class="resource-budget"><col class="resource-funding"></colgroup><thead>{{ header }}</thead><tbody>{% for row in rows %}{{ row.original }}{% endfor %}</tbody></table>{%- endset -%}
{%- import 'src/pdf/short-resource-rows.html.j2' as shortRows -%}
{{- shortRows.table(original, rows) -}}
{%- endif -%}
{%- endmacro -%}

{%- macro render(original, header, rows, metadataHeader='', fundingLabel='') -%}
  {%- set selection = namespace(any=false, eligible=[], funding=false) -%}
  {%- for row in rows -%}
    {%- set result = namespace(long=false) -%}
    {{ classify(row, result) }}
    {%- do selection.eligible.append(result.long) -%}
    {%- set selection.any = selection.any or result.long -%}
    {%- set selection.funding = selection.funding or '<table' in row.funding -%}
  {%- endfor -%}
  {%- if selection.funding and metadataHeader and fundingLabel -%}{{ funding_records(header, rows, metadataHeader, fundingLabel) }}
  {%- elif not selection.any -%}
    {%- import 'src/pdf/short-resource-rows.html.j2' as shortRows -%}
    {{- short_table(shortRows.table(original, rows), rows) -}}
  {%- else -%}
    {%- set pending = [] -%}
    {%- for row in rows -%}
      {%- if selection.eligible[loop.index0] -%}
        {%- if pending -%}{{ ordinary(header, pending) }}{%- do pending.clear() -%}{%- endif -%}
        <table class="resource-table pdf-resource-reading" data-item-id="{{ row.id }}"><colgroup><col class="resource-purpose"><col class="resource-budget"><col class="resource-funding"></colgroup><thead>{{ header }}<tr><td>{{ row.title }}</td><td>{{ row.budget }}</td><td>{{ row.funding }}</td></tr></thead><tbody style="break-inside: avoid"><tr><td colspan="3">{{ row.purpose }}</td></tr></tbody></table>
      {%- else -%}{%- do pending.append(row) -%}{%- endif -%}
    {%- endfor -%}
    {%- if pending -%}{{ ordinary(header, pending) }}{%- endif -%}
  {%- endif -%}
{%- endmacro -%}
