{%- set contributorsPath = [uuids.adminDetailsCUuid, uuids.contributorsQUuid]|join(".") -%}
{%- set contributorsItems = repliesMap[contributorsPath]|reply_items -%}
  {% set contributors = [] %}
  {%- for contributor in contributorsItems -%}
    {%- set pathPrefix = [contributorsPath, contributor]|reply_path ~ "." -%}
    {%- set contributorName = repliesMap[pathPrefix ~ uuids.contributorNameQUuid]|reply_str_value -%}
    {%- set contributorEmail = repliesMap[pathPrefix ~ uuids.contributorEmailQUuid]|reply_str_value -%}
    {%- set contributorEmail = contributorEmail if contributorEmail|trim else '' -%}
    {%- set contributorOrcid = repliesMap[pathPrefix ~ uuids.contributorOrcidQUuid] -%}
    {%- set contributorOrcid = contributorOrcid if contributorOrcid and (contributorOrcid.value.value.value|default('', true)|trim or contributorOrcid.value.value.raw|default(none)) else none -%}
    {%- set contributorRoles = repliesMap[pathPrefix ~ uuids.contributorRoleQUuid]|reply_items -%}
    {%- set contributorAffiliationReply = repliesMap[pathPrefix ~ uuids.contributorAffiliationQUuid] -%}
    {%- set contributorAffiliationReply = contributorAffiliationReply if contributorAffiliationReply and (contributorAffiliationReply.value.value.value|default('', true)|trim or contributorAffiliationReply.value.value.raw|default(none)) else none -%}
    {%- set roles = [] -%}
    {%- for role in contributorRoles -%}
      {%- if role in dc.e.choices.keys() -%}
        {%- do roles.append(dc.e.choices[role].label) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if contributorName|trim or contributorEmail or contributorOrcid or roles or contributorAffiliationReply -%}
      {%- do contributors.append({
        'name': contributorName,
        'email': contributorEmail,
        'orcid': contributorOrcid,
        'roles': roles|sort,
        'affiliation': contributorAffiliationReply,
        'index': contributorsItems.index(contributor) + 1,
      }) -%}
    {%- endif -%}
  {%- endfor -%}

{% if contributors or dc.project.created_by or output_profile|default('review') != 'submission' %}<div id="dmp-contributors">
  <h2>{{ pgettext("contributors", "People and responsibilities") }}</h2>

  {%- if contributors|length > 0 -%}
  <ul>
  {% for contributor in contributors %}
    <li class="contributor">
      <span class="name"><strong>{% if contributor.name|trim %}{{ contributor.name|e }}{% elif output_profile|default('review') == 'submission' %}{{ macros.contributorLabel(contributor.index) }}{% else %}{{ pgettext("contributors", "(name not given)") }}{% endif %}</strong></span>
      {%- if contributor.email and contributor.orcid %}
        <br>{{ macros.formatEmail(contributor.email) }}, {{ macros.formatOrcid(contributor.orcid) }}
      {%- elif contributor.email %}
        <br>{{ macros.formatEmail(contributor.email) }}
      {%- elif contributor.orcid %}
        <br>{{ macros.formatOrcid(contributor.orcid) }}
      {%- endif -%}
      {%- if contributor.roles|length > 0 %}
        <br>{% if contributor.roles|length == 0 %}{{ pgettext("contributors", "Role") }}{% else %}{{ pgettext("contributors", "Roles") }}{% endif %}{{ pgettext("contributors", ": ") }}{% for role in contributor.roles %}<span class="role">{{ role }}</span>{% if not loop.last %}{{ pgettext("contributors", ", ") }}{% endif %}{% endfor %}
      {%- endif %}
      {%- if contributor.affiliation %}
        <br>{{ pgettext("contributors", "Affiliation:") }} <span class="affiliation">{{ macros.integrationROR(contributor.affiliation) }}</span>
      {%- endif %}
    </li>
  {% endfor %}
  </ul>
  {%- elif dc.project.created_by -%}
  <ul>
    <li class="contributor">
      <span class="name">{{ dc.project.created_by.first_name }} {{ dc.project.created_by.last_name }}</span>
      <br>{{ macros.formatEmail(dc.project.created_by.email) }}
      {%- if dc.project.created_by.affiliation %}
      <br>{{ pgettext("contributors", "Affiliation: <span class=\"affiliation\">%(dc_project_created_by_affiliation)s</span>", dc_project_created_by_affiliation=dc.project.created_by.affiliation) }}
      {%- endif %}
    </li>
  </ul>
  {%- else -%}
  <div style="font-style:italic;">{{ pgettext("contributors", "There are no contributors described for this DMP.") }}</div>
  {%- endif -%}
</div>{% endif %}
