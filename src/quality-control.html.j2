{% import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
{# Shared by Q1/Q4. Only selected fixed methods form a sentence; free Markdown
   remains an independent block. The PO locale supplies the list separator.
   Do not join user-provided paragraphs or append punctuation to list entries. #}
{% set measuredDataQualityPath = [pathPrefix, uuids.measuredDataQualityQUuid]|reply_path %}
{% set qualityAnswer = repliesMap[measuredDataQualityPath]|reply_str_value %}
{% if measuredDataName|trim %}
  {% set qualityName = measuredDataName|e %}
{% else %}
  {% set qualityName %}{% if output_profile|default('review') == 'submission' %}<span>{{ macros.datasetLabel(macros.DATASET_INSTRUMENT, measuredDataItems.index(datasetItem) + 1) }}</span>{% else %}<span>{{ pgettext("quality-control", "(no name given)") }}</span>{% endif %}{% endset %}
{% endif %}
{% if qualityAnswer == uuids.measuredDataQualityNoAUuid %}
  <p class="quality-summary" data-fact-id="quality-control" data-status="explicit-no">{{ pgettext("quality-control", "No quality control processes will be used for <strong>%(qualityName)s</strong>.", qualityName=qualityName) }}</p>
{% elif qualityAnswer == uuids.measuredDataQualityYesAUuid %}
  {% set mdqPrefix = [measuredDataQualityPath, uuids.measuredDataQualityYesAUuid]|reply_path %}
  {% set qualityMethods = [] %}
  {% if repliesMap[[mdqPrefix, uuids.mdQualityCalibratingQUuid]|reply_path]|reply_str_value == uuids.mdQualityCalibratingYesAUuid %}
    {% do qualityMethods.append(pgettext("quality-control", "measurement calibration")) %}
  {% endif %}
  {% if repliesMap[[mdqPrefix, uuids.mdQualityRepetitionQUuid]|reply_path]|reply_str_value == uuids.mdQualityRepetitionYesAUuid %}
    {% do qualityMethods.append(pgettext("quality-control", "repeat sampling or measurement")) %}
  {% endif %}
  {% if repliesMap[[mdqPrefix, uuids.mdQualityStandardizedQUuid]|reply_path]|reply_str_value == uuids.mdQualityStandardizedYesAUuid %}
    {% do qualityMethods.append(pgettext("quality-control", "standardized data capture or recording")) %}
  {% endif %}
  {% if repliesMap[[mdqPrefix, uuids.mdQualityValidationQUuid]|reply_path]|reply_str_value == uuids.mdQualityValidationYesAUuid %}
    {% do qualityMethods.append(pgettext("quality-control", "data entry validation")) %}
  {% endif %}
  {% if repliesMap[[mdqPrefix, uuids.mdQualityPeerReviewQUuid]|reply_path]|reply_str_value == uuids.mdQualityPeerReviewYesAUuid %}
    {% do qualityMethods.append(pgettext("quality-control", "data peer review")) %}
  {% endif %}
  {% if repliesMap[[mdqPrefix, uuids.mdQualityVocabulariesQUuid]|reply_path]|reply_str_value == uuids.mdQualityVocabulariesYesAUuid %}
    {% do qualityMethods.append(pgettext("quality-control", "use of controlled vocabularies")) %}
  {% endif %}
  {% if repliesMap[[mdqPrefix, uuids.mdQualityConsistencyQUuid]|reply_path]|reply_str_value == uuids.mdQualityConsistencyYesAUuid %}
    {% do qualityMethods.append(pgettext("quality-control", "measurement of samples with known outcomes to monitor consistency")) %}
  {% endif %}
  {% set otherPath = [mdqPrefix, uuids.mdQualityOtherQUuid]|reply_path %}
  {% set otherAnswer = repliesMap[otherPath]|reply_str_value %}
  {% set otherText = repliesMap[[otherPath, uuids.mdQualityOtherYesAUuid, uuids.mdQualityOtherWhatQUuid]|reply_path]|reply_str_value if otherAnswer == uuids.mdQualityOtherYesAUuid else '' %}
{% if output_profile|default('review') == 'submission' and otherAnswer == uuids.mdQualityOtherYesAUuid and not otherText|trim %}<p class="quality-summary" data-fact-id="quality-other" data-status="partial">{% if qualityMethods %}{{ pgettext("quality-control", "Quality control measures planned for <strong>%(qualityName)s</strong>: <span data-fact-id=\"quality-methods\" data-status=\"complete\">%(qualityMethods)s</span> and other quality control methods.", qualityName=qualityName, qualityMethods=qualityMethods|join(pgettext("quality-control", ", "))) }}{% else %}{{ pgettext("quality-control", "Other quality control methods are planned for <strong>%(qualityName)s</strong>.", qualityName=qualityName) }}{% endif %}</p>{% else %}  {% if qualityMethods %}
    <p class="quality-summary" data-fact-id="quality-methods" data-status="complete">{% if compactQualitySummary|default(false) %}{{ pgettext("quality-control", "Quality control measures: %(qualityMethods)s.", qualityMethods=qualityMethods|join(pgettext("quality-control", ", "))) }}{% else %}{{ pgettext("quality-control", "Quality control measures for <strong>%(qualityName)s</strong>: %(qualityMethods)s.", qualityName=qualityName, qualityMethods=qualityMethods|join(pgettext("quality-control", ", "))) }}{% endif %}</p>
  {% elif not otherText|trim %}
    {% if output_profile|default('review') == 'submission' %}
    <p class="quality-summary" data-fact-id="quality-methods" data-status="partial">{{ pgettext("quality-control", "Quality control is planned for <strong>%(qualityName)s</strong>.", qualityName=qualityName) }}</p>
    {% else %}
    {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="quality-methods" data-status="missing">{{ pgettext("quality-control", "Quality control is planned for <strong>%(qualityName)s</strong>, but the methods have not been specified.", qualityName=qualityName) }}</p>{% endif %}
    {% endif %}
  {% endif %}
  {% if otherText|trim %}
    <div class="answer-lead"><p>{{ pgettext("quality-control", "Additional quality control details for <strong>%(qualityName)s</strong>:", qualityName=qualityName) }}</p></div>
    {# Let long authored paragraphs split; do not bind the first two paragraphs. #}
    <div class="answer-detail" data-fact-id="quality-other" data-status="complete"><div{% if qualityReadingDetails|default(false) %} class="reading-detail" data-reading-detail="quality-other"{% endif %}>{{ answerMarkdown.markdown(otherText) }}</div></div>
  {% elif otherAnswer == uuids.mdQualityOtherYesAUuid %}
    {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="quality-other" data-status="missing">{{ pgettext("quality-control", "Other quality control methods were selected for <strong>%(qualityName)s</strong>, but the details have not been provided.", qualityName=qualityName) }}</p>{% else %}<p class="quality-summary" data-fact-id="quality-other" data-status="partial">{{ pgettext("quality-control", "Other quality control methods are planned for <strong>%(qualityName)s</strong>.", qualityName=qualityName) }}</p>{% endif %}
  {% endif %}{% endif %}
{% else %}
  {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="quality-control" data-status="missing">{{ pgettext("quality-control", "It has not been specified whether quality control processes will be used for <strong>%(qualityName)s</strong>.", qualityName=qualityName) }}</p>{% elif not qualityNameAlreadyRendered|default(false) %}<p class="quality-context"><strong>{{ qualityName }}</strong></p>{% endif %}
{% endif %}
