{% import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
{% import 'src/active-answer.j2' as activeAnswer with context -%}
{# These status/follow-up paths also validate typed reply envelopes. The shared
   resolver checks the real KM graph; flat no-KM fixtures remain supported. #}
{%- macro ethicsPath(parts, questionType, replyType) -%}
  {%- set resolved = activeAnswer.path(parts, questionType) if km is defined else parts|reply_path -%}
  {%- set state = namespace(valid=resolved|length > 0) -%}
  {%- for part in parts[1:] -%}
    {%- if state.valid and loop.index % 2 == 1 -%}
      {%- set currentPath = parts[:loop.index + 1]|reply_path -%}
      {%- set expectedReply = replyType if loop.last else ('ItemListReply' if part == uuids.cpersGdprDpiaListQUuid else 'AnswerReply') -%}
      {%- if currentPath in repliesMap and repliesMap[currentPath].value is defined and repliesMap[currentPath].value.type is defined and repliesMap[currentPath].value.type != expectedReply -%}
        {%- set state.valid = false -%}
      {%- elif expectedReply == 'StringReply' and currentPath in repliesMap and repliesMap[currentPath].value is defined and repliesMap[currentPath].value.type is defined and repliesMap[currentPath].value.value is not string -%}
        {%- set state.valid = false -%}
      {%- elif not loop.last and km is not defined -%}
        {%- if expectedReply == 'ItemListReply' and parts[loop.index + 1] not in repliesMap[currentPath]|reply_items -%}{%- set state.valid = false -%}
        {%- elif expectedReply == 'AnswerReply' and repliesMap[currentPath]|reply_str_value != parts[loop.index + 1] -%}{%- set state.valid = false -%}{%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if state.valid and km is defined -%}
    {%- set leaf = km.entities.questions[parts[-1]] -%}
    {%- if questionType == 'OptionsQuestion' -%}
      {%- set selected = repliesMap[resolved]|reply_str_value -%}
      {%- if selected not in leaf.answerUuids or selected not in km.entities.answers -%}{%- set state.valid = false -%}{%- endif -%}
    {%- elif questionType == 'ValueQuestion' and leaf.valueType not in ['TextQuestionValueType', 'StringQuestionValueType'] -%}
      {%- set state.valid = false -%}
    {%- endif -%}
  {%- endif -%}
  {%- if state.valid -%}{{- resolved -}}{%- endif -%}
{%- endmacro -%}
{%- set dpiaDatasetLabel %}{{ pgettext("questions/09-ethical-issues", "Dataset") }}{% endset -%}
{%- set dpiaDatasetKind = 'dpia' -%}
<div id="q-ethical-issues" class="question">
  <h3>{{ pgettext("questions/09-ethical-issues", "9. What ethical issues and codes of conduct are there, and how will they be taken into account?") }}</h3>

  <div class="answer">
  {% set answerContent %}

    {# Research Projects - ethical approval #}
    {%- set projectsPath = [uuids.adminDetailsCUuid, uuids.projectsQUuid]|reply_path -%}
    {%- set projectsItems = repliesMap[projectsPath]|reply_items -%}
    {%- set projects = [] -%}
    {%- for projectItem in projectsItems -%}
      {%- set projectPrefix = [projectsPath, projectItem]|reply_path -%}
      {%- set projectName = repliesMap[[projectPrefix, uuids.projectNameQUuid]|reply_path]|reply_str_value -%}
      {%- set projEthicalApprovalPath = [projectPrefix, uuids.projEthicalApprovalQUuid]|reply_path -%}
      {%- set projEthicalApprovalAUuid = repliesMap[projEthicalApprovalPath]|reply_str_value -%}
      {%- if projEthicalApprovalAUuid in [uuids.projEthicalApprovalYesAUuid, uuids.projEthicalApprovalNoAUuid] -%}
        {%- set projEthicalApprovalAuthPath = [projEthicalApprovalPath, projEthicalApprovalAUuid, uuids.projEthicalApprovalAuthQUuid]|reply_path -%}
        {%- set projEthicalApprovalAuthItems = repliesMap[projEthicalApprovalAuthPath]|reply_items -%}
        {%- set projAuth = [] -%}
        {%- for projAuthItem in projEthicalApprovalAuthItems -%}
          {%- set projAuthStatusPath = [projEthicalApprovalAuthPath, projAuthItem, uuids.projEthicalApprovalAuthStatusQUuid]|reply_path -%}
          {%- set projAuthStatusAUuid = repliesMap[projAuthStatusPath]|reply_str_value -%}
          {%- set projAuthCasePath = [projEthicalApprovalAuthPath, projAuthItem, uuids.projEthicalApprovalAuthCaseQUuid]|reply_path -%}
          {%- set projAuthCase = repliesMap[projAuthCasePath]|reply_str_value -%}

          {%- do projAuth.append({'status': projAuthStatusAUuid, 'case': projAuthCase, 'item_id': projAuthItem}) -%}
        {%- endfor -%}
        {%- do projects.append({'name': projectName, 'approval': projEthicalApprovalAUuid, 'authorities': projAuth, 'index': projectsItems.index(projectItem) + 1, 'item_id': projectItem}) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if projects|length > 0 -%}
      <h4>{{ pgettext("questions/09-ethical-issues", "Ethical approvals") }}</h4>
      <ul>
      {%- for project in projects -%}
        <li class="ethical-project" data-item-id="{{ project.item_id|e }}">
          <p class="ethical-project-summary"><strong>{% if output_profile|default('review') == 'submission' and not project.name|trim %}{{ macros.projectLabel(project.index) }}{% else %}{{ project.name|e if project.name|trim else pgettext("questions/09-ethical-issues", "(no name given)") }}{% endif %}</strong> — {% if project.approval == uuids.projEthicalApprovalNoAUuid %}{{ pgettext("questions/09-ethical-issues", "According to the questionnaire, this project does not require ethical approval.") }}{% else %}{{ pgettext("questions/09-ethical-issues", "This project requires ethical approval.") }}{% endif %}</p>
          {% if project.approval == uuids.projEthicalApprovalYesAUuid %}
          {% if project.authorities|length > 0 %}
          {% set approvalRecords %}
            {% for authority in project.authorities %}
                {% set approvalStatus %}
                {% if authority.status == uuids.projEthicalApprovalAuthStatusPlannedAUuid %}
                  {{ pgettext("questions/09-ethical-issues", "Approval is planned.") }}
                {% elif authority.status == uuids.projEthicalApprovalAuthStatusAppliedAUuid %}
                  {{ pgettext("questions/09-ethical-issues", "An application for approval has been submitted.") }}
                {% elif authority.status == uuids.projEthicalApprovalAuthStatusGrantedAUuid %}
                  {{ pgettext("questions/09-ethical-issues", "Approval has been granted.") }}
                {% elif authority.status == uuids.projEthicalApprovalAuthStatusRejectAUuid %}
                  {{ pgettext("questions/09-ethical-issues", "Approval has been rejected.") }}
                {% endif %}
                {% endset %}
              {% if approvalStatus|trim or authority.case|trim or output_profile|default('review') != 'submission' %}
              <li class="ethical-approval-record" data-item-id="{{ authority.item_id|e }}">
                {% if approvalStatus|trim or authority.case|trim %}<p class="ethical-approval-summary">{% if approvalStatus|trim %}<span class="ethical-approval-status">{{ approvalStatus|trim }}</span>{% endif %}{% if approvalStatus|trim and authority.case|trim %} {% endif %}{% if authority.case|trim %}{{ pgettext("questions/09-ethical-issues", "<span class=\"ethical-approval-case\">Case number: %(authority_case)s</span>", authority_case=authority.case|e) }}{% endif %}</p>{% endif %}
                {% if not approvalStatus|trim %}
                  {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/09-ethical-issues", "<p class=\"data-gap\" data-status=\"missing-output\">Approval status has not been provided.</p>") }}{% endif %}
                {% endif %}
                {% if not authority.case|trim %}
                  {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/09-ethical-issues", "<p class=\"data-gap\" data-status=\"missing-output\">A case number has not been provided.</p>") }}{% endif %}
                {% endif %}
              </li>
              {% endif %}
            {% endfor %}
          {% endset %}
          {% if approvalRecords|striptags|trim %}<ul>{{ approvalRecords }}</ul>{% endif %}
          {% else %}
            {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-status="missing-output">{{ pgettext("questions/09-ethical-issues", "Ethical approval records have not been provided.") }}</p>{% endif %}
          {% endif %}
          {% endif %}
        </li>
      {%- endfor -%}
      </ul>
    {%- endif -%}

    {# Produced datasets #}
    {%- set producedDataPath = [uuids.preservingCUuid, uuids.producedDataQUuid]|reply_path -%}
    {%- set producedDataItems = repliesMap[producedDataPath]|reply_items -%}
    {%- set ethicalDataItems = [] -%}
    {%- for i in producedDataItems -%}
      {%- set pathPrefix = [producedDataPath, i]|reply_path -%}
      {%- set containPersonal = repliesMap[[pathPrefix, uuids.containPersonalQUuid]|reply_path]|reply_str_value -%}
      {%- set containSensitive = repliesMap[[pathPrefix, uuids.containSensitiveQUuid]|reply_path]|reply_str_value -%}
      {%- if output_profile|default('review') != 'submission' or containPersonal in [uuids.containPersonalYesAUuid, uuids.containPersonalNoAUuid] or containSensitive in [uuids.containSensitiveYesAUuid, uuids.containSensitiveNoAUuid] -%}
        {%- do ethicalDataItems.append(i) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if ethicalDataItems|length > 0 -%}
      <h4>{{ pgettext("questions/09-ethical-issues", "Data we produce") }}</h4>
      <ul class="ethical-datasets">
      {%- for i in ethicalDataItems -%}
        {%- set pathPrefix = [producedDataPath, i]|reply_path -%}
        {%- set producedDataName = repliesMap[[pathPrefix, uuids.producedDataNameQUuid]|reply_path]|reply_str_value -%}
        {%- set containPersonal = repliesMap[[pathPrefix, uuids.containPersonalQUuid]|reply_path]|reply_str_value -%}
        {%- set containSensitive = repliesMap[[pathPrefix, uuids.containSensitiveQUuid]|reply_path]|reply_str_value -%}
        <li class="ethical-dataset" data-item-id="{{ i|e }}">
          {# A submission label with no facts is not a Word heading that must
             keep the following dataset/section with it. Mark its inline role. #}
          <p class="ethical-data-summary">{% if output_profile|default('review') == 'submission' %}<span class="ethical-dataset-name">{% endif %}<strong>{% if output_profile|default('review') == 'submission' and not producedDataName|trim %}{{ macros.datasetLabel(macros.DATASET_PRODUCED, producedDataItems.index(i) + 1) }}{% else %}{{ producedDataName|e if producedDataName|trim else pgettext("questions/09-ethical-issues", "(no name given)") }}{% endif %}</strong>{% if output_profile|default('review') == 'submission' %}</span>{% endif %}{% if containPersonal in [uuids.containPersonalYesAUuid, uuids.containPersonalNoAUuid] or containSensitive in [uuids.containSensitiveYesAUuid, uuids.containSensitiveNoAUuid] %} — {% endif %}{% include 'src/ethics-data-summary.html.j2' %}</p>
          {% if not containPersonal and not containSensitive and output_profile|default('review') != 'submission' %}<p class="data-gap" data-status="missing">{{ pgettext("questions/09-ethical-issues", "Whether this dataset contains personal or sensitive data has not been specified.") }}</p>{% endif %}
        </li>
      {%- endfor -%}
      </ul>
    {%- endif -%}

    {# Collected data - personal/GDPR and ethical legislation #}
    {%- set collectPersonalPath = [uuids.creatingCUuid, uuids.collectPersonalQUuid]|reply_path -%}
    {%- set collectPersonalAUuid = repliesMap[collectPersonalPath]|reply_str_value -%}
    {%- set ethLegPath = [uuids.creatingCUuid, uuids.ethLegQUuid]|reply_path -%}
    {%- set ethLegAUuid = repliesMap[ethLegPath]|reply_str_value -%}
    {%- if collectPersonalAUuid or ethLegAUuid -%}
      <h4>{{ pgettext("questions/09-ethical-issues", "Data we collect") }}</h4>

      {%- if collectPersonalAUuid == uuids.collectPersonalNoAUuid %}
        <p>{{ pgettext("questions/09-ethical-issues", "We will not collect any data related to individuals, i.e. \"personal data\".") }}</p>
      {%- elif collectPersonalAUuid == uuids.collectPersonalYesAUuid %}
        {%- set collectPersonalSentence %}{{ pgettext("questions/09-ethical-issues", "We will collect data related to individuals, i.e. \"personal data\".") }}{% endset -%}
        {%- set sentences = [collectPersonalSentence] -%}{%- set ethicsLead = namespace(indices=[]) -%}
        {%- set cpersGdprPath = [collectPersonalPath, collectPersonalAUuid, uuids.cpersGdprQUuid]|reply_path -%}
        {%- set cpersGdprAUuid = repliesMap[cpersGdprPath]|reply_str_value -%}
        {%- if cpersGdprAUuid == uuids.cpersGdprExploreAUuid -%}
          {# Explore opens a questionnaire branch; it is not evidence of an assessment. #}

          {# Legal Base #}
          {%- set legalBasePath = [cpersGdprPath, cpersGdprAUuid, uuids.cpersGdprLegalBasisQUuid]|reply_path -%}
          {%- set legalBaseAUuid = repliesMap[legalBasePath]|reply_str_value -%}
          {%- if legalBaseAUuid == uuids.cpersGdprLegalBasisPublicAUuid -%}
            {%- do sentences.append(pgettext("questions/09-ethical-issues", "The stated legal basis for collecting and processing personal data is a task carried out in the public interest.")) -%}
          {%- elif legalBaseAUuid == uuids.cpersGdprLegalBasisAskAUuid -%}
            {# A valid scope already states consent; retain the parent claim otherwise. #}
            {%- set cpersConsentParts = [uuids.creatingCUuid, uuids.collectPersonalQUuid, uuids.collectPersonalYesAUuid, uuids.cpersGdprQUuid, uuids.cpersGdprExploreAUuid, uuids.cpersGdprLegalBasisQUuid, uuids.cpersGdprLegalBasisAskAUuid, uuids.cpersConsentQUuid] -%}
            {%- set cpersConsentPath = ethicsPath(cpersConsentParts, 'OptionsQuestion', 'AnswerReply') -%}
            {%- set cpersConsentAUuid = repliesMap[cpersConsentPath]|reply_str_value if cpersConsentPath else '' -%}
            {%- if cpersConsentAUuid == uuids.cpersConsentUseAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "We will obtain consent for this project's specific use of the data.")) -%}
            {%- elif cpersConsentAUuid == uuids.cpersConsentReuseAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "We will obtain consent for this project's use and for subsequent reuse of the data.")) -%}
            {%- elif cpersConsentAUuid == uuids.cpersConsentUseAnonAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "We will obtain consent for this project's use of the data and for anonymization. We will then anonymize the data for subsequent reuse.")) -%}
            {%- elif cpersConsentAUuid == uuids.cpersConsentAnonAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "We will obtain consent to anonymize the data. We will anonymize the data before any further processing.")) -%}
            {%- else -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "We ask the data subjects for their consent.")) -%}
            {%- endif -%}

            {%- set cpersExplainInformedPath = [legalBasePath, legalBaseAUuid, uuids.cpersExplainInformedQUuid]|reply_path -%}
            {%- set cpersExplainInformed = repliesMap[cpersExplainInformedPath]|reply_str_value -%}
            {%- if cpersExplainInformed|trim -%}
              {%- do ethicsLead.indices.append(sentences|length) -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "The data subjects will be informed as follows:")) -%}
              {%- do sentences.append(answerMarkdown.markdown(cpersExplainInformed)) -%}
            {%- endif -%}

            {%- set cpersReusersPath = [legalBasePath, legalBaseAUuid, uuids.cpersReusersQUuid]|reply_path -%}
            {%- set cpersReusersAUuid = repliesMap[cpersReusersPath]|reply_str_value -%}
            {%- if cpersReusersAUuid == uuids.cpersReusersNoAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "The consent form will not be available to people who reuse the data.")) -%}
            {%- elif cpersReusersAUuid == uuids.cpersReusersYesAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "The consent form will be available to people who reuse the data.")) -%}
            {%- endif -%}

            {%- set cpersDescribeProcedurePath = [legalBasePath, legalBaseAUuid, uuids.cpersDescribeProcedureQUuid]|reply_path -%}
            {%- set cpersDescribeProcedure = repliesMap[cpersDescribeProcedurePath]|reply_str_value -%}
            {%- if cpersDescribeProcedure|trim -%}
              {%- do ethicsLead.indices.append(sentences|length) -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "The procedure for obtaining consent from data subjects is as follows:")) -%}
              {%- do sentences.append(answerMarkdown.markdown(cpersDescribeProcedure)) -%}
            {%- endif -%}

          {%- elif legalBaseAUuid == uuids.cpersGdprLegalBasisOtherAUuid -%}
            {%- set cpersGdprLegalBasisOtherWhichPath = [legalBasePath, legalBaseAUuid, uuids.cpersGdprLegalBasisOtherWhichQUuid]|reply_path -%}
            {%- set cpersGdprLegalBasisOtherWhichAUuid = repliesMap[cpersGdprLegalBasisOtherWhichPath]|reply_str_value -%}
            {%- if cpersGdprLegalBasisOtherWhichAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "Alternative legal basis for collecting personal data:") ~ ' ') -%}
            {%- else -%}
              {%- if output_profile|default('review') == 'submission' -%}{%- do sentences.append(pgettext("questions/09-ethical-issues", "An alternative legal basis was selected.")) -%}{%- else -%}{%- do sentences.append(pgettext("questions/09-ethical-issues", "An alternative legal basis was selected, but it has not been specified; see Question 7.")) -%}{%- endif -%}
            {%- endif -%}
            {%- if cpersGdprLegalBasisOtherWhichAUuid == uuids.cpersGdprLegalBasisOtherWhichContractAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "performance of a contract.")) -%}
            {%- elif cpersGdprLegalBasisOtherWhichAUuid == uuids.cpersGdprLegalBasisOtherWhichLegitAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "legitimate interests.")) -%}
            {%- elif cpersGdprLegalBasisOtherWhichAUuid == uuids.cpersGdprLegalBasisOtherWhichVitalAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "protection of vital interests.")) -%}
            {%- elif cpersGdprLegalBasisOtherWhichAUuid == uuids.cpersGdprLegalBasisOtherWhichLegalAUuid -%}
              {%- do sentences.append(pgettext("questions/09-ethical-issues", "compliance with a legal obligation.")) -%}
            {%- endif -%}

          {%- endif -%}

          {# purpose  #}
          {%- set cpersGdprPurposePath = [cpersGdprPath, cpersGdprAUuid, uuids.cpersGdprPurposeQUuid]|reply_path -%}
          {%- set cpersGdprPurpose = repliesMap[cpersGdprPurposePath]|reply_str_value -%}
          {%- if cpersGdprPurpose|trim -%}
            {%- do ethicsLead.indices.append(sentences|length) -%}
            {%- do sentences.append(pgettext("questions/09-ethical-issues", "The purpose of processing the personal data can be described as follows:")) -%}
            {%- do sentences.append(answerMarkdown.markdown(cpersGdprPurpose)) -%}
          {%- endif -%}

          {# DPIA #}
          {%- set needDpiaParts = [uuids.creatingCUuid, uuids.collectPersonalQUuid, uuids.collectPersonalYesAUuid, uuids.cpersGdprQUuid, uuids.cpersGdprExploreAUuid, uuids.cpersGdprNeedDpiaQUuid] -%}
          {%- set needDpiaPath = ethicsPath(needDpiaParts, 'OptionsQuestion', 'AnswerReply') -%}
          {%- set needDpiaAUuid = repliesMap[needDpiaPath]|reply_str_value if needDpiaPath else '' -%}
          {%- set dpiaDetails = '' -%}
          {%- if needDpiaAUuid == uuids.cpersGdprNeedDpiaYesAUuid %}
            {%- do sentences.append(pgettext("questions/09-ethical-issues", "According to the questionnaire, a data protection impact assessment (DPIA) is required.")) -%}
            {%- set performedDpiaParts = needDpiaParts + [uuids.cpersGdprNeedDpiaYesAUuid, uuids.cpersGdprPerformedDpiaQUuid] -%}
            {%- set performedDpiaPath = ethicsPath(performedDpiaParts, 'OptionsQuestion', 'AnswerReply') -%}
            {%- set performedDpiaAUuid = repliesMap[performedDpiaPath]|reply_str_value if performedDpiaPath else '' -%}
            {%- if performedDpiaAUuid == uuids.cpersGdprPerformedDpiaYesAUuid -%}
              {%- set performedDpiaSentence %}<span data-fact-id="dpia-performed" data-status="complete">{{ pgettext("questions/09-ethical-issues", "Data protection impact assessments (DPIAs) have been performed for the personal data.") }}</span>{% endset -%}
              {%- do sentences.append(performedDpiaSentence) -%}
              {%- set dpiaPrefix = performedDpiaParts + [uuids.cpersGdprPerformedDpiaYesAUuid] -%}
              {%- set dpiaListParts = dpiaPrefix + [uuids.cpersGdprDpiaListQUuid] -%}
              {%- set dpiaListPath = ethicsPath(dpiaListParts, 'ListQuestion', 'ItemListReply') -%}
              {%- set dpiaItems = repliesMap[dpiaListPath]|reply_items if dpiaListPath else [] -%}
              {%- set dpiaRecords = [] -%}
              {%- for item in dpiaItems -%}
                {%- set datasetPath = ethicsPath(dpiaListParts + [item, uuids.cpersGdprDpiaDatasetQUuid], 'ValueQuestion', 'StringReply') -%}
                {%- set assessmentPath = ethicsPath(dpiaListParts + [item, uuids.cpersGdprDpiaDescriptionQUuid], 'ValueQuestion', 'StringReply') -%}
                {%- set dataset = repliesMap[datasetPath]|reply_str_value if datasetPath else '' -%}
                {%- set assessment = repliesMap[assessmentPath]|reply_str_value if assessmentPath else '' -%}
                {%- if dataset|trim or assessment|trim -%}
                  {%- do dpiaRecords.append({'item': item, 'index': loop.index, 'dataset': dataset, 'assessment': assessment}) -%}
                {%- endif -%}
              {%- endfor -%}
              {%- set reasonsPath = ethicsPath(dpiaPrefix + [uuids.cpersGdprDpiaReasonsQUuid], 'MultiChoiceQuestion', 'MultiChoiceReply') -%}
              {%- set selectedReasons = repliesMap[reasonsPath]|reply_items if reasonsPath else [] -%}
              {# Template-owned labels remain translatable; never emit English KM labels. #}
              {%- set dpiaVulnerableLabel %}{{ pgettext("questions/09-ethical-issues", "Data concerning vulnerable data subjects, including minors, employees, elderly people, mentally incapacitated people, and patients receiving care.") }}{% endset -%}
              {%- set dpiaSensitiveLabel %}{{ pgettext("questions/09-ethical-issues", "Sensitive data or data of a highly personal nature, including racial or ethnic origin, political opinions, religious or philosophical beliefs, trade union membership, genetic data, health data, biometric data, or sexual orientation.") }}{% endset -%}
              {%- set dpiaLargeScaleLabel %}{{ pgettext("questions/09-ethical-issues", "Data processed on a large scale, considering the proportion of the relevant population, duration of processing, geographical scale, and volume or range of data.") }}{% endset -%}
              {%- set dpiaAutomatedLabel %}{{ pgettext("questions/09-ethical-issues", "Automated decision-making with legal or similarly significant effects on data subjects.") }}{% endset -%}
              {%- set dpiaEvaluationLabel %}{{ pgettext("questions/09-ethical-issues", "Evaluation or scoring concerning work performance, economic situation, health, personal preferences or interests, reliability or behaviour, location, or movements.") }}{% endset -%}
              {%- set dpiaMonitoringLabel %}{{ pgettext("questions/09-ethical-issues", "Systematic monitoring used to observe, monitor, or control data subjects, including data collected through networks.") }}{% endset -%}
              {%- set dpiaMatchingLabel %}{{ pgettext("questions/09-ethical-issues", "Matching or combining datasets, for example from processing operations performed for different purposes.") }}{% endset -%}
              {%- set dpiaInnovativeLabel %}{{ pgettext("questions/09-ethical-issues", "Innovative use or application of new technological or organizational solutions, such as combining fingerprint and face recognition for physical access control.") }}{% endset -%}
              {%- set dpiaRightsLabel %}{{ pgettext("questions/09-ethical-issues", "Processing that prevents data subjects from exercising a right or using a service or a contract.") }}{% endset -%}
              {%- set reasonLabels = [
                (uuids.cpersGdprDpiaVulnerableChoiceUuid, dpiaVulnerableLabel),
                (uuids.cpersGdprDpiaSensitiveChoiceUuid, dpiaSensitiveLabel),
                (uuids.cpersGdprDpiaLargeScaleChoiceUuid, dpiaLargeScaleLabel),
                (uuids.cpersGdprDpiaAutomatedChoiceUuid, dpiaAutomatedLabel),
                (uuids.cpersGdprDpiaEvaluationChoiceUuid, dpiaEvaluationLabel),
                (uuids.cpersGdprDpiaMonitoringChoiceUuid, dpiaMonitoringLabel),
                (uuids.cpersGdprDpiaMatchingChoiceUuid, dpiaMatchingLabel),
                (uuids.cpersGdprDpiaInnovativeChoiceUuid, dpiaInnovativeLabel),
                (uuids.cpersGdprDpiaRightsChoiceUuid, dpiaRightsLabel)
              ] -%}
              {%- set reasons = [] -%}
              {%- for choice, label in reasonLabels -%}
                {%- if choice in selectedReasons and (km is not defined or (choice in km.entities.questions[uuids.cpersGdprDpiaReasonsQUuid].choiceUuids and choice in km.entities.choices)) -%}
                  {%- do reasons.append({'choice': choice, 'label': label}) -%}
                {%- endif -%}
              {%- endfor -%}
              {%- set dpiaDetails %}
                {% if dpiaRecords %}
                <div class="dpia-assessments" data-fact-id="dpia-assessments" data-status="complete">
                  <div class="answer-lead"><p>{{ pgettext("questions/09-ethical-issues", "Data protection impact assessments and the data they cover:") }}</p></div>
                  <ul>{% for record in dpiaRecords %}
                    <li class="dpia-record" data-item-id="{{ record.item|e }}">
                      <div class="answer-lead"><p><strong>{{ dpiaDatasetLabel }} {{ macros.datasetLabel(dpiaDatasetKind, record.index) }}</strong></p></div>
                      {% if record.dataset|trim %}<div class="answer-detail" data-fact-id="dpia-dataset">{{ answerMarkdown.markdown(record.dataset) }}</div>{% endif %}
                      {% if record.assessment|trim %}<div class="answer-detail" data-fact-id="dpia-description"><div class="answer-lead">{{ pgettext("questions/09-ethical-issues", "<p>DPIA:</p>") }}</div>{{ answerMarkdown.markdown(record.assessment) }}</div>{% endif %}
                    </li>
                  {% endfor %}</ul>
                </div>
                {% endif %}
                {% if reasons %}
                <div class="dpia-reasons" data-fact-id="dpia-reasons" data-status="complete">
                  <div class="answer-lead"><p>{{ pgettext("questions/09-ethical-issues", "The following indicators were selected as reasons why a DPIA is deemed necessary:") }}</p></div>
                  <ul>{% for reason in reasons %}<li data-choice-id="{{ reason.choice }}">{{ reason.label }}</li>{% endfor %}</ul>
                </div>
                {% endif %}
              {% endset -%}
            {%- elif performedDpiaAUuid == uuids.cpersGdprPerformedDpiaNoAUuid -%}
              {%- set performedDpiaSentence %}<span data-fact-id="dpia-performed" data-status="explicit-no">{{ pgettext("questions/09-ethical-issues", "Data protection impact assessments (DPIAs) have not been performed for the personal data.") }}</span>{% endset -%}
              {%- do sentences.append(performedDpiaSentence) -%}
            {%- endif -%}
          {%- elif needDpiaAUuid == uuids.cpersGdprNeedDpiaNoAUuid %}
            {%- do sentences.append(pgettext("questions/09-ethical-issues", "According to the questionnaire, a data protection impact assessment (DPIA) is not required.")) -%}
          {%- endif -%}
        {%- endif -%}

        <div class="answer-detail">
          {%- set prose = namespace(parts=[]) -%}
          {%- for sentence in sentences -%}
            {%- if loop.index0 in ethicsLead.indices -%}
              {%- do prose.parts.append(sentence) -%}
              <div class="answer-lead"><p>{{ prose.parts|join(' ') }}</p></div>
              {%- do prose.parts.clear() -%}
            {%- elif loop.index0 - 1 in ethicsLead.indices -%}
              <div class="reading-detail" data-reading-detail="ethics-authored">{{ sentence }}</div>
            {%- else -%}
              {%- do prose.parts.append(sentence) -%}
            {%- endif -%}
          {%- endfor -%}
          {% if prose.parts %}<p>{{ prose.parts|join(' ') }}</p>{% endif %}
        </div>
        {{ dpiaDetails|default('') }}
      {%- endif -%}

      {% if ethLegAUuid == uuids.ethLegNoAUuid %}
      <p>{{ pgettext("questions/09-ethical-issues", "The data collection is not subject to ethical legislation.") }}</p>
      {% elif ethLegAUuid == uuids.ethLegYesAUuid %}
        {%- set ethLegReviewPath = [ethLegPath, ethLegAUuid, uuids.ethLegReviewQUuid]|reply_path -%}
        {%- set ethLegReviewAUuid = repliesMap[ethLegReviewPath]|reply_str_value -%}
        {%- set ethLegHumanPath = [ethLegPath, ethLegAUuid, uuids.ethLegHumanQUuid]|reply_path -%}
        {%- set ethLegHumanAUuid = repliesMap[ethLegHumanPath]|reply_str_value -%}
        <p>
          {{ pgettext("questions/09-ethical-issues", "The data collection is subject to ethical legislation.") }}
          {% if ethLegReviewAUuid == uuids.ethLegReviewNoAUuid %}
          {{ pgettext("questions/09-ethical-issues", "It is not covered by ethical review.") }}
          {% elif ethLegReviewAUuid == uuids.ethLegReviewYesAUuid %}
          {{ pgettext("questions/09-ethical-issues", "It is covered by ethical review.") }}
          {% endif %}
          {% if ethLegHumanAUuid == uuids.ethLegHumanNoAUuid %}
          {{ pgettext("questions/09-ethical-issues", "It does not involve human subjects.") }}
          {% elif ethLegHumanAUuid == uuids.ethLegHumanYesAUuid %}
          {{ pgettext("questions/09-ethical-issues", "It involves human subjects.") }}
            {%- set informedCollectedParts = [uuids.creatingCUuid, uuids.ethLegQUuid, uuids.ethLegYesAUuid, uuids.ethLegHumanQUuid, uuids.ethLegHumanYesAUuid, uuids.ethLegInformedCollectedQUuid] -%}
            {%- set informedCollectedPath = ethicsPath(informedCollectedParts, 'OptionsQuestion', 'AnswerReply') -%}
            {%- set informedCollectedAUuid = repliesMap[informedCollectedPath]|reply_str_value if informedCollectedPath else '' -%}
            {% if informedCollectedAUuid == uuids.ethLegInformedCollectedYesAUuid %}
            {{ pgettext("questions/09-ethical-issues", "<span data-fact-id=\"ethical-informed-consent-collected\" data-status=\"complete\">Informed consent has been collected from the research subjects.</span>") }}
            {% elif informedCollectedAUuid == uuids.ethLegInformedCollectedNoAUuid %}
            {{ pgettext("questions/09-ethical-issues", "<span data-fact-id=\"ethical-informed-consent-collected\" data-status=\"explicit-no\">Informed consent has not been collected from the research subjects.</span>") }}
            {% endif %}
          {% endif %}
        </p>
      {% endif %}
    {%- endif -%}
  {% endset %}
  {% if answerContent|striptags|trim or '<img' in answerContent or '<table' in answerContent %}
    {{ answerContent }}
  {% else %}
    {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-4c" data-status="missing-output">{{ pgettext("questions/09-ethical-issues", "This document does not yet contain an answer about ethical issues and codes of conduct.") }}</p>{% endif %}
  {% endif %}
  </div>
</div>
