{% import "src/answer-markdown.html.j2" as answerMarkdown with context %}
<div id="q-what-data" class="question">
  <h3>{{ pgettext("questions/02-what-data", "2. What data (for example the kinds, formats, and volumes) will be collected or produced?") }}</h3>
  <div class="answer">

  {%- set measuredPath = [uuids.creatingCUuid, uuids.measuredQUuid]|reply_path -%}
  {%- set measuredAUuid = repliesMap[measuredPath]|reply_str_value -%}
  {%- if measuredAUuid == uuids.measuredYesAUuid -%}
    {%- set measuredDataPath = [measuredPath, uuids.measuredYesAUuid, uuids.measuredDataQUuid]|reply_path -%}
    {%- set measuredDataItems = repliesMap[measuredDataPath]|reply_items -%}
    {# Measured datasets #}
    {%- if measuredDataItems|length > 0 -%}
      <div>
      <h4>{{ pgettext("questions/02-what-data", "Instrument datasets") }}</h4>
        {%- for datasetItem in measuredDataItems -%}
          {%- set pathPrefix = [measuredDataPath, datasetItem]|reply_path -%}
          <div class="collection-dataset" data-item-id="{{ datasetItem }}">
            {%- set measuredDataNamePath = [pathPrefix, uuids.measuredDataNameQUuid]|reply_path -%}
            {%- set measuredDataName = repliesMap[measuredDataNamePath]|reply_str_value -%}
            {%- set measuredDataWhoPath = [pathPrefix, uuids.measuredDataWhoQUuid]|reply_path -%}
            {%- set measuredDataWhoAUuid = repliesMap[measuredDataWhoPath]|reply_str_value -%}
            {%- set measuredDataEquipPath = [pathPrefix, uuids.measuredDataEquipQUuid]|reply_path -%}
            {%- set measuredDataEquipAUuid = repliesMap[measuredDataEquipPath]|reply_str_value -%}
            {%- set collectionName -%}{% if measuredDataName|trim %}{{ measuredDataName|e }}{% else %}{% if output_profile|default('review') == 'submission' %}<span>{{ macros.datasetLabel(macros.DATASET_INSTRUMENT, measuredDataItems.index(datasetItem) + 1) }}</span>{% else %}<span>{{ pgettext("questions/02-what-data", "(no name given)") }}</span>{% endif %}{% endif %}{%- endset -%}
            {%- set collectionSentences = [] -%}
            {%- set ownershipOther = "" -%}
            {%- set ownershipMissing = false -%}
            {# Who will collect #}
            {%- if measuredDataWhoAUuid == uuids.measuredDataWhoExpertsOwnAUuid -%}
              {%- do collectionSentences.append(pgettext("questions/02-what-data", "This dataset will be collected by experts in the project, with our own equipment.")) -%}
            {%- elif measuredDataWhoAUuid == uuids.measuredDataWhoExpertsOutAUuid -%}
              {%- do collectionSentences.append(pgettext("questions/02-what-data", "This dataset will be collected by experts in the project, at a specialized infrastructure.")) -%}
            {%- elif measuredDataWhoAUuid == uuids.measuredDataWhoExternalAUuid -%}
              {%- set mdExternalOwnershipPath = [measuredDataWhoPath, uuids.measuredDataWhoExternalAUuid, uuids.mdExternalOwnershipQUuid]|reply_path -%}
              {%- set mdExternalOwnershipAUuid = repliesMap[mdExternalOwnershipPath]|reply_str_value -%}
              {%- do collectionSentences.append(pgettext("questions/02-what-data", "This dataset will be collected by an external party.")) -%}
                {% if mdExternalOwnershipAUuid == uuids.mdExternalOwnershipPartyAUuid -%}
                  {%- do collectionSentences.append(pgettext("questions/02-what-data", "The ownership of the resulting data will remain with the external party.")) -%}
                {%- elif mdExternalOwnershipAUuid == uuids.mdExternalOwnershipPartnersAUuid -%}
                  {%- do collectionSentences.append(pgettext("questions/02-what-data", "The project partners acquire full ownership of the data.")) -%}
                {%- elif mdExternalOwnershipAUuid == uuids.mdExternalOwnershipOtherAUuid -%}
                  {%- set mdExternalOwnershipOtherPath = [mdExternalOwnershipPath, uuids.mdExternalOwnershipOtherAUuid, uuids.mdExternalOwnershipOtherQUuid]|reply_path -%}
                  {%- set mdExternalOwnershipOther = repliesMap[mdExternalOwnershipOtherPath]|reply_str_value -%}
                  {%- set ownershipOther = mdExternalOwnershipOther -%}
                  {%- set ownershipMissing = not mdExternalOwnershipOther|trim -%}
                {%- else -%}
                  {%- set ownershipMissing = true -%}
                {%- endif -%}
            {%- endif -%}
            {# Equipment standard? #}
            {% if measuredDataEquipAUuid == uuids.measuredDataEquipDescribedAUuid -%}
              {%- do collectionSentences.append(pgettext("questions/02-what-data", "The equipment is very well described and known.")) -%}
            {%- elif measuredDataEquipAUuid == uuids.measuredDataEquipCareAUuid -%}
              {%- do collectionSentences.append(pgettext("questions/02-what-data", "The equipment is less well described or not completely standard, so we will need to take extra care documenting the process.")) -%}
            {%- endif -%}
            {% if collectionSentences %}
              <p class="collection-summary">{{ pgettext("questions/02-what-data", "Data collection for <strong>%(collectionName)s</strong>: %(collectionSentences)s", collectionName=collectionName, collectionSentences=collectionSentences|join("" if document_language|default('en') == 'zh-Hant' else " ")) }}</p>
            {% else %}
              {% if output_profile|default('review') != 'submission' %}<p class="collection-summary">{{ pgettext("questions/02-what-data", "Data collection for <strong>%(collectionName)s</strong> has not yet been described.", collectionName=collectionName) }}</p>{% else %}<p class="collection-context"><strong>{{ collectionName }}</strong></p>{% endif %}
            {% endif %}
            {% if measuredDataWhoAUuid not in [uuids.measuredDataWhoExpertsOwnAUuid, uuids.measuredDataWhoExpertsOutAUuid, uuids.measuredDataWhoExternalAUuid] %}
              {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-1b" data-fact-id="data-collector" data-status="missing">{{ pgettext("questions/02-what-data", "Information not provided: who will collect this dataset.") }}</p>{% endif %}
            {% endif %}
            {% if measuredDataEquipAUuid not in [uuids.measuredDataEquipDescribedAUuid, uuids.measuredDataEquipCareAUuid] %}
              {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-1b" data-fact-id="equipment-documentation" data-status="missing">{{ pgettext("questions/02-what-data", "Information not provided: whether the equipment is adequately documented or needs additional process documentation.") }}</p>{% endif %}
            {% endif %}
            {% if ownershipOther|trim %}
              <div class="answer-detail" data-fact-id="external-ownership" data-status="complete">
                <div class="answer-lead"><p>{{ pgettext("questions/02-what-data", "Data ownership arrangements:") }}</p></div>
                {{ answerMarkdown.markdown(ownershipOther) }}
              </div>
            {% elif ownershipMissing %}
              {%- if measuredDataWhoAUuid == uuids.measuredDataWhoExternalAUuid and mdExternalOwnershipAUuid == uuids.mdExternalOwnershipOtherAUuid -%}
                {%- import 'src/active-answer.j2' as activeAnswer with context -%}
                {%- set activeOwnershipPath = activeAnswer.path(mdExternalOwnershipPath.split('.'), 'OptionsQuestion') if km is defined else mdExternalOwnershipPath -%}
                {%- if activeOwnershipPath and (km is not defined or (mdExternalOwnershipAUuid in km.entities.questions[uuids.mdExternalOwnershipQUuid].answerUuids and mdExternalOwnershipAUuid in km.entities.answers)) and (repliesMap[mdExternalOwnershipPath].value is not defined or repliesMap[mdExternalOwnershipPath].value.type is not defined or repliesMap[mdExternalOwnershipPath].value.type == 'AnswerReply') -%}
                  <p data-fact-id="external-ownership" data-status="complete">{{ pgettext("questions/02-what-data", "Other arrangements have been made for ownership of this dataset.") }}</p>
                {%- endif -%}
              {%- endif -%}
              {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-1b" data-fact-id="external-ownership" data-status="missing">{{ pgettext("questions/02-what-data", "Information not provided: ownership arrangements for data collected by the external party.") }}</p>{% endif %}
            {% endif %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  {# Non-equipment datasets #}
  {%- import 'src/active-answer.j2' as activeAnswer with context -%}
  {%- set neqDataParts = [uuids.creatingCUuid, uuids.neqDataQUuid] -%}
  {%- set neqDataPath = activeAnswer.path(neqDataParts, 'OptionsQuestion') if km is defined else neqDataParts|reply_path -%}
  {%- set neqDataAUuid = repliesMap[neqDataPath]|reply_str_value if neqDataPath else '' -%}
  {%- if neqDataPath in repliesMap and repliesMap[neqDataPath].value is defined and repliesMap[neqDataPath].value.type is defined and repliesMap[neqDataPath].value.type != 'AnswerReply' -%}
    {%- set neqDataAUuid = '' -%}
  {%- endif -%}
  {%- if km is defined and neqDataPath and (neqDataAUuid not in km.entities.questions[uuids.neqDataQUuid].answerUuids or neqDataAUuid not in km.entities.answers) -%}
    {%- set neqDataAUuid = '' -%}
  {%- endif -%}
  {%- if neqDataAUuid == uuids.neqDataYesAUuid -%}
    {%- set neqDataPrefix = [neqDataPath, uuids.neqDataYesAUuid]|reply_path -%}
    {%- set neqDataQuestPath = [neqDataPrefix, uuids.neqDataQuestQUuid]|reply_path -%}
    {%- set neqDataQuestAUuid = repliesMap[neqDataQuestPath]|reply_str_value -%}
    {%- set neqDataCaseReportPath = [neqDataPrefix, uuids.neqDataCaseReportQUuid]|reply_path -%}
    {%- set neqDataCaseReportAUuid = repliesMap[neqDataCaseReportPath]|reply_str_value -%}
    {%- set neqDataERecordsPath = [neqDataPrefix, uuids.neqDataERecordsQUuid]|reply_path -%}
    {%- set neqDataERecordsAUuid = repliesMap[neqDataERecordsPath]|reply_str_value -%}
    {%- set neqDataSetsParts = neqDataParts + [uuids.neqDataYesAUuid, uuids.neqDataSetsQUuid] -%}
    {%- set neqDataSetsPath = activeAnswer.path(neqDataSetsParts, 'ListQuestion') if km is defined else neqDataSetsParts|reply_path -%}
    {%- set neqDataSetsItems = repliesMap[neqDataSetsPath]|reply_items if neqDataSetsPath else [] -%}
    {%- if neqDataSetsPath in repliesMap and repliesMap[neqDataSetsPath].value is defined and repliesMap[neqDataSetsPath].value.type is defined and repliesMap[neqDataSetsPath].value.type != 'ItemListReply' -%}
      {%- set neqDataSetsItems = [] -%}
    {%- endif -%}

    {%- set questionnaires = neqDataQuestAUuid == uuids.neqDataQuestYesAUuid -%}
    {%- set caseReport = neqDataCaseReportAUuid == uuids.neqDataCaseReportYesAUuid -%}
    {%- set eRecords = neqDataERecordsAUuid == uuids.neqDataERecordsYesAUuid -%}
    {%- if questionnaires or caseReport or eRecords or neqDataSetsItems|length > 0 -%}
      <div>
      <h4>{{ pgettext("questions/02-what-data", "Non-equipment datasets") }}</h4>
      {# Types #}
      {%- set typesNames = [] -%}
      {%- if questionnaires -%}{%- do typesNames.append(pgettext("questions/02-what-data", "questionnaires")) -%}{%- endif -%}
      {%- if caseReport -%}{%- do typesNames.append(pgettext("questions/02-what-data", "case report forms")) -%}{%- endif -%}
      {%- if eRecords -%}{%- do typesNames.append(pgettext("questions/02-what-data", "electronic patient records")) -%}{%- endif -%}
      {%- set typesCount = typesNames|length -%}
      {%- if typesCount > 0 %}
      <p>
          {% if typesCount == 1 -%}
              {{ pgettext("questions/02-what-data", "We collect data from %(first_type)s.", first_type=typesNames[0]) }}
          {%- elif typesCount == 2 -%}
              {{ pgettext("questions/02-what-data", "We collect data from %(first_type)s and %(second_type)s.", first_type=typesNames[0], second_type=typesNames[1]) }}
          {%- else -%}
              {{ pgettext("questions/02-what-data", "We collect data from %(first_type)s, %(second_type)s, and %(third_type)s.", first_type=typesNames[0], second_type=typesNames[1], third_type=typesNames[2]) }}
          {%- endif -%}
      </p>
      {%- endif %}
        {# Datasets #}
        {%- if neqDataSetsItems|length > 0 -%}
          <div class="answer-lead"><p>{{ pgettext("questions/02-what-data", "The non-equipment datasets are:") }}</p></div>
          <ul>
          {%- for neqDataSetItem in neqDataSetsItems -%}
            {%- set pathPrefix = [neqDataSetsPath, neqDataSetItem]|reply_path -%}
            {%- set itemParts = neqDataSetsParts + [neqDataSetItem] -%}
            {%- set namePath = activeAnswer.path(itemParts + [uuids.neqDataSetsNameQUuid], 'ValueQuestion') if km is defined else [pathPrefix, uuids.neqDataSetsNameQUuid]|reply_path -%}
            {%- set descPath = activeAnswer.path(itemParts + [uuids.neqDataSetsDescQUuid], 'ValueQuestion') if km is defined else [pathPrefix, uuids.neqDataSetsDescQUuid]|reply_path -%}
            {%- set neqDataSetsName = repliesMap[namePath]|reply_str_value if namePath else '' -%}
            {%- set neqDataSetsDesc = repliesMap[descPath]|reply_str_value if descPath else '' -%}
            {%- if namePath in repliesMap and repliesMap[namePath].value is defined and repliesMap[namePath].value.type is defined and repliesMap[namePath].value.type != 'StringReply' -%}
              {%- set neqDataSetsName = '' -%}
            {%- endif -%}
            {%- if descPath in repliesMap and repliesMap[descPath].value is defined and repliesMap[descPath].value.type is defined and repliesMap[descPath].value.type != 'StringReply' -%}
              {%- set neqDataSetsDesc = '' -%}
            {%- endif -%}
            {%- set captureSelections = {} -%}
            {%- set captureParts = itemParts + [uuids.neqDataSetsCaptureQUuid] -%}
            {%- set paperParts = captureParts + [uuids.neqDataSetsCapturePaperAUuid] -%}
            {%- for field, parts in [(uuids.neqDataSetsCaptureQUuid, captureParts),
                (uuids.neqDataSetsEntryQUuid, paperParts + [uuids.neqDataSetsEntryQUuid]),
                (uuids.neqDataSetsAvailableQUuid, paperParts + [uuids.neqDataSetsAvailableQUuid])] -%}
              {%- set fieldPath = activeAnswer.path(parts, 'OptionsQuestion') -%}
              {%- set selected = repliesMap[fieldPath]|reply_str_value if fieldPath else '' -%}
              {%- if fieldPath in repliesMap and repliesMap[fieldPath].value is defined and repliesMap[fieldPath].value.type is defined and repliesMap[fieldPath].value.type != 'AnswerReply' -%}
                {%- set selected = '' -%}
              {%- endif -%}
              {%- if fieldPath and (selected not in km.entities.questions[field].answerUuids or selected not in km.entities.answers) -%}
                {%- set selected = '' -%}
              {%- endif -%}
              {%- do captureSelections.update({field: selected}) -%}
            {%- endfor -%}
            {%- set capture = captureSelections[uuids.neqDataSetsCaptureQUuid] -%}
            {%- set entry = captureSelections[uuids.neqDataSetsEntryQUuid] -%}
            {%- set available = captureSelections[uuids.neqDataSetsAvailableQUuid] -%}
            {%- set captureSentences = [] -%}
            {%- set entryOther = '' -%}
            {%- if capture == uuids.neqDataSetsCaptureDigitalAUuid -%}
              {%- do captureSentences.append(pgettext("questions/02-what-data", "All data in this dataset will be captured immediately in digital form.")) -%}
            {%- elif capture == uuids.neqDataSetsCapturePaperAUuid -%}
              {%- do captureSentences.append(pgettext("questions/02-what-data", "Data in this dataset will first be captured on paper.")) -%}
              {%- if entry == uuids.neqDataSetsEntryTeamAUuid -%}
                {%- do captureSentences.append(pgettext("questions/02-what-data", "A specialized team will perform the data entry.")) -%}
              {%- elif entry == uuids.neqDataSetsEntryMemberAUuid -%}
                {%- do captureSentences.append(pgettext("questions/02-what-data", "A member of the project team will perform the data entry.")) -%}
              {%- elif entry == uuids.neqDataSetsEntryOtherAUuid -%}
                {%- set entryOtherPath = activeAnswer.path(paperParts + [uuids.neqDataSetsEntryQUuid, uuids.neqDataSetsEntryOtherAUuid, uuids.neqDataSetsEntryOtherQUuid], 'ValueQuestion') -%}
                {%- if entryOtherPath and km.entities.questions[uuids.neqDataSetsEntryOtherQUuid].valueType in ['TextQuestionValueType', 'StringQuestionValueType'] -%}
                  {%- set entryOther = repliesMap[entryOtherPath]|reply_str_value -%}
                  {%- if entryOtherPath in repliesMap and repliesMap[entryOtherPath].value is defined and repliesMap[entryOtherPath].value.type is defined and repliesMap[entryOtherPath].value.type != 'StringReply' -%}
                    {%- set entryOther = '' -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if not entryOther|trim -%}
                  {%- do captureSentences.append(pgettext("questions/02-what-data", "Other arrangements have been made for data entry.")) -%}
                {%- endif -%}
              {%- endif -%}
              {%- if available == uuids.neqDataSetsAvailableYesAUuid -%}
                {%- do captureSentences.append(pgettext("questions/02-what-data", "We have arranged for someone to make this dataset available in digital form.")) -%}
              {%- elif available == uuids.neqDataSetsAvailableNotYetAUuid -%}
                {%- do captureSentences.append(pgettext("questions/02-what-data", "We have not yet arranged for someone to make this dataset available in digital form.")) -%}
              {%- endif -%}
            {%- endif -%}
            <li data-item-id="{{ neqDataSetItem }}">
              {% if neqDataSetsDesc|trim or captureSentences or entryOther|trim %}<div class="answer-lead"><p>{% endif %}
              <strong class="item-label">{% if output_profile|default('review') == 'submission' and not neqDataSetsName|trim %}{{ macros.datasetLabel(macros.DATASET_NON_EQUIPMENT, neqDataSetsItems.index(neqDataSetItem) + 1) }}{% else %}{{ (neqDataSetsName if neqDataSetsName|trim else pgettext("questions/02-what-data", "(no name given)"))|e }}{% endif %}</strong>
              {# Keep the authored body out of automatic first-paragraph lead styling. #}
              {% if neqDataSetsDesc|trim or captureSentences or entryOther|trim %}</p></div>{% endif %}
              {% if neqDataSetsDesc|trim %}<div class="answer-detail"><div>{{ answerMarkdown.markdown(neqDataSetsDesc) }}</div></div>{% endif %}
              {% if captureSentences %}<p class="collection-summary" data-fact-id="non-equipment-capture">{{ captureSentences|join("" if document_language|default('en') == 'zh-Hant' else " ") }}</p>{% endif %}
              {% if entryOther|trim %}<div class="answer-lead"><p>{{ pgettext("questions/02-what-data", "Other data-entry arrangements:") }}</p></div><div class="answer-detail" data-fact-id="non-equipment-data-entry-other"><div>{{ answerMarkdown.markdown(entryOther) }}</div></div>{% endif %}
            </li>
          {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- else -%}
      <p>{{ pgettext("questions/02-what-data", "The project includes data capture that does not use measurement equipment.") }}</p>
    {%- endif -%}
  {%- endif -%}
  {# Existing datasets #}
  {%- set preexistingPath = [uuids.reusingCUuid, uuids.preexistingQUuid]|reply_path -%}
  {%- set preexistingAUuid = repliesMap[preexistingPath]|reply_str_value -%}
  {%- if preexistingAUuid == uuids.preexistingYesAUuid -%}
    {%- set refDataPath = [preexistingPath, uuids.preexistingYesAUuid, uuids.refDataQUuid]|reply_path -%}
    {%- set refDataItems = repliesMap[refDataPath]|reply_items -%}
    {%- set nrefDataPath = [preexistingPath, uuids.preexistingYesAUuid, uuids.nrefDataQUuid]|reply_path -%}
    {%- set nrefDataItems = repliesMap[nrefDataPath]|reply_items -%}
    {%- if (refDataItems|length + nrefDataItems|length) > 0 -%}
      {# Re-use decisions and source links are already in Q1, not an answer about formats/volume. #}
    {%- endif -%}
  {%- endif -%}

  {# Format/Type with volume #}
  {%- set formatsPath = [uuids.creatingCUuid, uuids.formatsQUuid]|reply_path -%}
  {%- set formatsItems = repliesMap[formatsPath]|reply_items -%}
  {% if not formatsItems %}
    {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-1b" data-status="missing-output">{% trans %}This document does not yet list the data types, formats and estimated volumes.{% endtrans %}</p>{% endif %}
  {% endif %}
  {%- if formatsItems|length > 0 -%}
    <h4>{% trans %}Data formats and types{% endtrans %}</h4>
    <div class="data-formats">
      {%- for formatItem in formatsItems -%}
        {%- set formatPrefix = [formatsPath, formatItem]|reply_path -%}
        {%- set formatNameReply = repliesMap[[formatPrefix, uuids.formatsNameQUuid]|reply_path] -%}
        {%- set formatsIsStandardPath = [formatPrefix, uuids.formatsIsStandardQUuid]|reply_path -%}
        {%- set formatsIsStandardAUuid = repliesMap[formatsIsStandardPath]|reply_str_value -%}
        {%- set formatsIsLTSuitablePath = [formatPrefix, uuids.formatsIsLTSuitableQUuid]|reply_path -%}
        {%- set formatsIsLTSuitableAUuid = repliesMap[formatsIsLTSuitablePath]|reply_str_value -%}
        {%- set formatsVolumePath = [formatPrefix, uuids.formatsVolumeQUuid]|reply_path -%}
        {%- set formatsVolumeAUuid = repliesMap[formatsVolumePath]|reply_str_value -%}
        {%- set formatName = macros.integrationFairSharing(formatNameReply)|trim -%}
        {%- set formatsWhyNonStandardPath = [formatsIsStandardPath, uuids.formatsIsStandardNoAUuid, uuids.formatsWhyNonStandardQUuid]|reply_path -%}
        {%- set formatsWhyNonStandardAUuid = repliesMap[formatsWhyNonStandardPath]|reply_str_value -%}
        {%- set formatsWhyNSAnotherReasonPath = [formatsWhyNonStandardPath, uuids.formatsWhyNSAnotherReasonAUuid, uuids.formatsWhyNSAnotherReasonQUuid]|reply_path -%}
        {%- set formatsWhyNSAnotherReason = repliesMap[formatsWhyNSAnotherReasonPath]|reply_str_value -%}
        {%- set formatsConvertLTSuitablePath = [formatsIsLTSuitablePath, uuids.formatsIsLTSuitableNoAUuid, uuids.formatsConvertLTSuitableQUuid]|reply_path -%}
        {%- set formatsConvertLTSuitableAUuid = repliesMap[formatsConvertLTSuitablePath]|reply_str_value -%}
        {%- set formatsVolumeTotalGB = repliesMap[[formatsVolumePath, uuids.formatsVolumeTotalAUuid, uuids.formatsVolumeTotalGBQUuid]|reply_path]|reply_str_value -%}
        {%- set formatsVolumeFiles = repliesMap[[formatsVolumePath, uuids.formatsVolumeFileSizeAUuid, uuids.formatsVolumeFilesQUuid]|reply_path]|reply_str_value -%}
        {%- set formatsVolumeFileGB = repliesMap[[formatsVolumePath, uuids.formatsVolumeFileSizeAUuid, uuids.formatsVolumeFileGBQUuid]|reply_path]|reply_str_value -%}
        {%- set formatTotalQuantity = macros.quantity(formatsVolumeTotalGB, "GB") -%}
        {%- set formatAverageQuantity = macros.quantity(formatsVolumeFileGB, "GB") -%}
        <div class="format-description" data-item-id="{{ formatItem }}">
          <div class="dataset-policy format-summary">
            {% if formatName|striptags|trim %}
              <p>{% trans formatName=formatName %}Data format: <strong>{{ formatName }}</strong>.{% endtrans %}</p>
            {% else %}
              {% if output_profile|default('review') == 'submission' %}<p>{% trans loop_index=loop.index %}Data format {{ loop_index }}.{% endtrans %}</p>{% else %}<p>{% trans loop_index=loop.index %}Unnamed data format {{ loop_index }}.{% endtrans %}</p>{% endif %}
            {% endif %}
            {# standard? #}
            {%- if formatsIsStandardAUuid == uuids.formatsIsStandardYesAUuid and formatsIsLTSuitableAUuid == uuids.formatsIsLTSuitableYesAUuid %}
              <p>{% trans %}It is a standardized format suitable for long-term archiving.{% endtrans %}</p>
            {%- elif formatsIsStandardAUuid == uuids.formatsIsStandardYesAUuid %}
              <p>{% trans %}It is a standardized format.{% endtrans %}</p>
            {%- elif formatsIsStandardAUuid == uuids.formatsIsStandardNoAUuid -%}
              {%- if formatsWhyNonStandardAUuid == uuids.formatsWhyNSThereIsNoStandardAUuid %}
                <p>{% trans %}We are not using a standardized format because there is no standardized format for this data type.{% endtrans %}</p>
              {%- elif formatsWhyNonStandardAUuid == uuids.formatsWhyNSItIsOptimizedAUuid %}
                <p>{% trans %}We are not using a standardized format but it is optimized for processing speed and/or volume.{% endtrans %}</p>
              {%- else -%}
                <p>{% trans %}We are not using a standardized format.{% endtrans %}</p>
              {%- endif -%}
            {%- endif -%}
            {# long-term suitable? #}
            {%- if formatsIsLTSuitableAUuid == uuids.formatsIsLTSuitableYesAUuid and formatsIsStandardAUuid != uuids.formatsIsStandardYesAUuid %}
              <p>{% trans %}This is a suitable format for long-term archiving.{% endtrans %}</p>
            {%- elif formatsIsLTSuitableAUuid == uuids.formatsIsLTSuitableNoAUuid -%}
              {%- if formatsConvertLTSuitableAUuid == uuids.formatsConvertLTSuitableYesAUuid %}
                <p>{% trans %}This is not a suitable format for long-term archiving; however, we plan to convert it to a suitable format before the end of the project.{% endtrans %}</p>
              {%- elif formatsConvertLTSuitableAUuid == uuids.formatsConvertLTSuitableNoAUuid %}
                <p>{% trans %}This format is not suitable for long-term archiving, and we do not plan to convert it to a suitable format.{% endtrans %}</p>
              {%- else -%}
                <p>{% trans %}This format is not suitable for long-term archiving.{% endtrans %}</p>
              {%- endif -%}
            {%- endif -%}
            {# volume #}
            {%- if formatsVolumeAUuid == uuids.formatsVolumeSmallAUuid %}
              <p>{% trans %}Only a small volume of data is expected.{% endtrans %}</p>
            {%- elif formatsVolumeAUuid == uuids.formatsVolumeTotalAUuid -%}
              {%- if formatsVolumeTotalGB|trim %}
                <p>{% trans formatTotalQuantity=formatTotalQuantity %}The estimated data volume is {{ formatTotalQuantity }}.{% endtrans %}</p>
              {%- endif -%}
            {%- elif formatsVolumeAUuid == uuids.formatsVolumeFileSizeAUuid -%}
              {# Keep each entered quantity independently; do not coerce/round it into an invented total. #}
              {%- if formatsVolumeFiles|trim and formatsVolumeFileGB|trim %}
                <p>{% trans formatsVolumeFiles=formatsVolumeFiles|e, formatAverageQuantity=formatAverageQuantity %}We expect {{ formatsVolumeFiles }} files, with an estimated average size of {{ formatAverageQuantity }}.{% endtrans %}</p>
              {%- elif formatsVolumeFiles|trim %}
                <p>{% trans formatsVolumeFiles=formatsVolumeFiles|e %}We expect {{ formatsVolumeFiles }} files.{% endtrans %}</p>
              {%- elif formatsVolumeFileGB|trim %}
                <p>{% trans formatAverageQuantity=formatAverageQuantity %}The estimated average file size is {{ formatAverageQuantity }}.{% endtrans %}</p>
              {%- endif -%}
            {%- endif -%}
          </div>
          {% if formatsIsStandardAUuid == uuids.formatsIsStandardNoAUuid and formatsWhyNonStandardAUuid == uuids.formatsWhyNSAnotherReasonAUuid and formatsWhyNSAnotherReason|trim %}
            <div class="answer-detail" data-fact-id="nonstandard-reason" data-status="complete">
              <p class="answer-lead">{% trans %}Reason for using a non-standard format:{% endtrans %}</p>
              {{ answerMarkdown.markdown(formatsWhyNSAnotherReason) }}
            </div>
          {% endif %}
          {% set formatGaps = [] %}
            {% if not formatName|striptags|trim %}
              {% set fieldGap %}<span data-fact-id="format-name" data-status="missing">{% trans %}data format name{% endtrans %}</span>{% endset %}{% do formatGaps.append(fieldGap) %}
            {% endif %}
            {% if formatsIsStandardAUuid not in [uuids.formatsIsStandardYesAUuid, uuids.formatsIsStandardNoAUuid] %}
              {% set fieldGap %}<span data-fact-id="format-standard" data-status="missing">{% trans %}whether the format is standardized{% endtrans %}</span>{% endset %}{% do formatGaps.append(fieldGap) %}
            {% elif formatsIsStandardAUuid == uuids.formatsIsStandardNoAUuid and (formatsWhyNonStandardAUuid not in [uuids.formatsWhyNSThereIsNoStandardAUuid, uuids.formatsWhyNSItIsOptimizedAUuid, uuids.formatsWhyNSAnotherReasonAUuid] or (formatsWhyNonStandardAUuid == uuids.formatsWhyNSAnotherReasonAUuid and not formatsWhyNSAnotherReason|trim)) %}
              {% set fieldGap %}<span data-fact-id="nonstandard-reason" data-status="missing">{% trans %}reason for using a non-standard format{% endtrans %}</span>{% endset %}{% do formatGaps.append(fieldGap) %}
            {% endif %}
            {% if formatsIsLTSuitableAUuid not in [uuids.formatsIsLTSuitableYesAUuid, uuids.formatsIsLTSuitableNoAUuid] %}
              {% set fieldGap %}<span data-fact-id="format-archiving" data-status="missing">{% trans %}suitability for long-term archiving{% endtrans %}</span>{% endset %}{% do formatGaps.append(fieldGap) %}
            {% elif formatsIsLTSuitableAUuid == uuids.formatsIsLTSuitableNoAUuid and formatsConvertLTSuitableAUuid not in [uuids.formatsConvertLTSuitableYesAUuid, uuids.formatsConvertLTSuitableNoAUuid] %}
              {% set fieldGap %}<span data-fact-id="format-conversion" data-status="missing">{% trans %}whether the data will be converted to a suitable archival format{% endtrans %}</span>{% endset %}{% do formatGaps.append(fieldGap) %}
            {% endif %}
            {% if formatsVolumeAUuid == uuids.formatsVolumeTotalAUuid %}
              {% if not formatsVolumeTotalGB|trim %}{% set fieldGap %}<span data-fact-id="format-total-volume" data-status="missing">{% trans %}estimated total volume (GB){% endtrans %}</span>{% endset %}{% do formatGaps.append(fieldGap) %}{% endif %}
            {% elif formatsVolumeAUuid == uuids.formatsVolumeFileSizeAUuid %}
              {% if not formatsVolumeFiles|trim %}{% set fieldGap %}<span data-fact-id="format-file-count" data-status="missing">{% trans %}estimated number of files{% endtrans %}</span>{% endset %}{% do formatGaps.append(fieldGap) %}{% endif %}
              {% if not formatsVolumeFileGB|trim %}{% set fieldGap %}<span data-fact-id="format-file-size" data-status="missing">{% trans %}estimated average file size (GB){% endtrans %}</span>{% endset %}{% do formatGaps.append(fieldGap) %}{% endif %}
            {% elif formatsVolumeAUuid != uuids.formatsVolumeSmallAUuid %}
              {% set fieldGap %}<span data-fact-id="format-volume" data-status="missing">{% trans %}estimated data volume{% endtrans %}</span>{% endset %}{% do formatGaps.append(fieldGap) %}
            {% endif %}
          {% if formatGaps %}{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-1b">{% trans formatGaps=formatGaps|join(gettext(", ")) %}Information still needed: {{ formatGaps }}.{% endtrans %}</p>{% endif %}{% endif %}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  </div>
</div>
