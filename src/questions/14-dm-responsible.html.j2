<div id="q-dm-responsible" class="question">
  <h3>14. Who (for example role, position, and institution) will be responsible for data management (i.e. the data steward)?</h3>

  <div class="answer">
    {% set responsibilitiesContent %}
    {%- set contributorsPath = [uuids.adminDetailsCUuid, uuids.contributorsQUuid]|reply_path -%}
    {%- set contributorsItems = repliesMap[contributorsPath]|reply_items -%}
    {%- if contributorsItems|length > 0 -%}
      {# Group by the actual list item, never by a possibly shared person name.
         These are the same seven role bindings as before; non-DM roles do not
         imply an assignment. Only template-owned sentences are joined. #}
      {%- for contributorItem in contributorsItems -%}
        {%- set contributorIndex = loop.index -%}
        {%- set personPath = [contributorsPath, contributorItem]|reply_path -%}
        {%- set name = repliesMap[[personPath, uuids.contributorNameQUuid]|reply_path]|reply_str_value -%}
        {%- set roles = repliesMap[[personPath, uuids.contributorRoleQUuid]|reply_path]|reply_items -%}
        {% set responsibilitySentences = [] %}
        {% set mappedRoles = [] %}
        {% include 'src/responsibility-sentences.j2' with context %}
        {%- if responsibilitySentences -%}
          {% set personContent %}
            <div class="answer-lead"><p class="responsible-person"><strong>{% if name|trim %}{{ name|e }}{% else %}{{ macros.contributorLabel(contributorIndex) }}{% endif %}</strong></p></div>
            <p class="responsibility-summary" data-fact-id="data-management-responsibilities" data-role-uuids="{{ mappedRoles|join(' ') }}">{{ responsibilitySentences|join(" ") }}</p>
            {% if not name|trim and output_profile|default('review') != 'submission' %}
              <p class="data-gap" data-fact-id="responsible-person-name" data-status="missing">Please provide the name of the person or team assigned these responsibilities.</p>
            {% endif %}
          {% endset %}
          <div class="person-responsibilities{{ ' short-reading-unit' if personContent|striptags|length <= 500 else '' }}" data-contributor-id="{{ contributorItem|e }}" data-contributor-index="{{ contributorIndex }}">{{ personContent }}</div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {% endset %}
    {% if responsibilitiesContent|striptags|trim %}
      <div class="responsibilities-block">{{ responsibilitiesContent }}</div>
    {% else %}
      {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6a" data-status="missing-output">This document does not yet identify a named person or team with a data management responsibility. Please check the contributor names and roles.</p>{% endif %}
    {% endif %}
  </div>
</div>
