{% import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
<div id="q-personal-data" class="question">
    <h3>{{ pgettext("questions/07-personal-data", "7. If personal data are processed, how will compliance with legislation on personal data and on security be ensured?") }}</h3>

    <div class="answer">
    {% set answerContent %}
        {%- set personalDataQUuid = [uuids.creatingCUuid,uuids.collectPersonalQUuid ]|reply_path -%}
        {%- set personalDataReply = repliesMap[personalDataQUuid]|reply_str_value -%}
        {%- if personalDataReply == uuids.collectPersonalYesAUuid -%}
            {%- set personalDataGDPRPath = [personalDataQUuid, uuids.collectPersonalYesAUuid, uuids.cpersGdprQUuid ]|reply_path -%}
            {%- set personalDataGDPRPathReply = repliesMap[personalDataGDPRPath]|reply_str_value -%}
            
            {%- if personalDataGDPRPathReply == uuids.cpersGdprExploreAUuid -%}
                {# Legal basis be4651c9-9a8c-4e10-a158-61b94ca0e139 #}
                {%- set personalDataLegalBasisQUuid = [personalDataGDPRPath, uuids.cpersGdprExploreAUuid, uuids.cpersGdprLegalBasisQUuid]|reply_path  -%}
                {%- set personalDataLegalBasisReply = repliesMap[personalDataLegalBasisQUuid]|reply_str_value -%}
                {%- set personalDataLegalBasisOtherQUuid = [personalDataLegalBasisQUuid, uuids.cpersGdprLegalBasisOtherAUuid, uuids.cpersGdprLegalBasisOtherWhichQUuid]|reply_path -%}
                {%- set personalDataLegalBasisOtherReply = repliesMap[personalDataLegalBasisOtherQUuid]|reply_str_value -%}
                {%- if personalDataLegalBasisReply == uuids.cpersGdprLegalBasisOtherAUuid and not personalDataLegalBasisOtherReply -%}
                    {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/07-personal-data", "<p class=\"data-gap\" data-requirement-id=\"SE-4a\" data-fact-id=\"personal-data-other-legal-basis\" data-status=\"missing\"><strong>Information not provided:</strong> the alternative legal basis selected for collecting and processing personal data.</p>") }}{% endif %}
                {%- elif not personalDataLegalBasisReply -%}
                    {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/07-personal-data", "<p class=\"data-gap\" data-requirement-id=\"SE-4a\" data-fact-id=\"personal-data-legal-basis\" data-status=\"missing\"><strong>Information not provided:</strong> the legal basis for collecting and processing personal data.</p>") }}{% endif %}
                {%- else -%}
                    <h4>{{ pgettext("questions/07-personal-data", "Legal basis for collecting and processing personal data") }}</h4>
                    <p> {{ pgettext("questions/07-personal-data", "We are collecting and processing personal data ") }}
                    {%- if personalDataLegalBasisReply == uuids.cpersGdprLegalBasisPublicAUuid -%}
                        {{ pgettext("questions/07-personal-data", "because the processing is necessary to perform a task carried out in the public interest.") }}
                    {%- elif personalDataLegalBasisReply == uuids.cpersGdprLegalBasisAskAUuid -%}
                        {{ pgettext("questions/07-personal-data", "with the consent of the data subjects.") }}
                    {%- elif personalDataLegalBasisReply == uuids.cpersGdprLegalBasisOtherAUuid -%}
                        {%- if personalDataLegalBasisOtherReply == uuids.cpersGdprLegalBasisOtherWhichContractAUuid -%}
                            {{ pgettext("questions/07-personal-data", "because the processing is necessary to perform a contract.") }}
                        {%- elif personalDataLegalBasisOtherReply == uuids.cpersGdprLegalBasisOtherWhichLegitAUuid -%}
                            {{ pgettext("questions/07-personal-data", "because the processing is necessary for legitimate interests.") }}
                        {%- elif personalDataLegalBasisOtherReply == uuids.cpersGdprLegalBasisOtherWhichVitalAUuid -%}
                            {{ pgettext("questions/07-personal-data", "because the processing is necessary to protect vital interests.") }}
                        {%- elif personalDataLegalBasisOtherReply == uuids.cpersGdprLegalBasisOtherWhichLegalAUuid -%}
                            {{ pgettext("questions/07-personal-data", "because the processing is necessary to comply with a legal obligation.") }}
                        {%- endif -%}
                    {%- endif -%}
                    </p>
                {%- endif -%}

                {# Technical and procedural safeguards #}
                {%- set personalDataSafeguardsQUuid = [personalDataGDPRPath, uuids.cpersGdprExploreAUuid, uuids.cpersGdprSafeguardsQUuid]|reply_path -%}
                {%- set personalDataSafeguardReply = repliesMap[personalDataSafeguardsQUuid]|reply_str_value -%}

                {%- if personalDataSafeguardReply == uuids.cpersGdprSafeguardsAUuid -%}

                    {% set personalDataSafeguardsHeading %}<h4>{{ pgettext("questions/07-personal-data", "Technical and procedural measures") }}</h4>{% endset %}
                    {% set personalDataSafeguardsContent %}

                    {%- set personalDataSafeguardLvlIdentifQUuid = [personalDataSafeguardsQUuid, uuids.cpersGdprSafeguardsAUuid, uuids.cpersGdprSafeguardsIdentifQUuid]|reply_path -%}
                    {%- set personalDataSafeguardLvlIdentifReply = repliesMap[personalDataSafeguardLvlIdentifQUuid]|reply_str_value -%}

                    {%- if personalDataSafeguardLvlIdentifReply == uuids.cpersGdprSafeguardsIdentifAnonymAUuid -%}
                        <p>{{ pgettext("questions/07-personal-data", "The stored data are irrevocably anonymized.") }}</p>
                    {%- elif personalDataSafeguardLvlIdentifReply == uuids.cpersGdprSafeguardsIdentifPseudoAUuid -%}
                        <p>{{ pgettext("questions/07-personal-data", "The stored data are pseudonymized.") }}</p>
                    {%- elif personalDataSafeguardLvlIdentifReply == uuids.cpersGdprSafeguardsIdentifIdentifiableAUuid -%}
                        <p>{{ pgettext("questions/07-personal-data", "The stored data are identifiable.") }}</p>
                    {%- elif not personalDataSafeguardLvlIdentifReply -%}
                        {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/07-personal-data", "<p class=\"data-gap\" data-requirement-id=\"SE-4a\" data-fact-id=\"personal-data-identifiability\" data-status=\"missing\"><strong>Information not provided:</strong> whether the stored data are anonymized, pseudonymized, or identifiable.</p>") }}{% endif %}
                    {%- endif -%}

                    {%- set personalDataSafeguardElaborateQUuid = [personalDataSafeguardsQUuid, uuids.cpersGdprSafeguardsAUuid, uuids.cpersGdprSafeguardElaborateQUuid ]|reply_path  -%}
                    {%- set personalDataSafeguardElaborateReply = repliesMap[personalDataSafeguardElaborateQUuid]|reply_str_value -%}
                    {%- if personalDataSafeguardElaborateReply|trim -%}
                        <div class="answer-lead"><p>{{ pgettext("questions/07-personal-data", "Other technical and procedural safeguards:") }}</p></div>
                        <div class="answer-detail" data-fact-id="personal-data-additional-safeguards" data-status="complete">{{ answerMarkdown.markdown(personalDataSafeguardElaborateReply) }}</div>
                    {%- else -%}
                        {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/07-personal-data", "<p class=\"data-gap\" data-requirement-id=\"SE-4a\" data-fact-id=\"personal-data-additional-safeguards\" data-status=\"missing\"><strong>Information not provided:</strong> details of any other technical and procedural safeguards.</p>") }}{% endif %}
                    {%- endif -%}

                    {%- set personalDataSafeguardTransferQUuid = [personalDataSafeguardsQUuid, uuids.cpersGdprSafeguardsAUuid, uuids.cpersGdprSafeguardsTransferQUuid]|reply_path -%}
                    {%- set personalDataSafeguardTransferReply = repliesMap[personalDataSafeguardTransferQUuid]|reply_str_value -%}
                    {%- set personalDataSafeguardTransferMeasuresQUuid = [personalDataSafeguardTransferQUuid, uuids.cpersGdprSafeguardsTransferYesAUuid, uuids.cpersGdprSafeguardsTransferMeasuresQUuid]|reply_path -%}
                    {%- set personalDataSafeguardTransferMeasuresReply = repliesMap[personalDataSafeguardTransferMeasuresQUuid]|reply_str_value -%}

                    {%- if personalDataSafeguardTransferReply == uuids.cpersGdprSafeguardsTransferYesAUuid -%}
                        {%- if personalDataSafeguardTransferMeasuresReply|trim -%}
                            <div class="answer-lead"><p>{{ pgettext("questions/07-personal-data", "We plan to transfer data outside the EU/EEA with the following protection measures:") }}</p></div>
                            <div class="answer-detail" data-fact-id="personal-data-transfer-measures" data-status="complete">{{ answerMarkdown.markdown(personalDataSafeguardTransferMeasuresReply) }}</div>
                        {%- else -%}
                            <p>{{ pgettext("questions/07-personal-data", "We plan to transfer data outside the EU/EEA.") }}</p>
                            {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/07-personal-data", "<p class=\"data-gap\" data-requirement-id=\"SE-4a\" data-fact-id=\"personal-data-transfer-measures\" data-status=\"missing\"><strong>Information not provided:</strong> the measures for protecting data transferred outside the EU/EEA.</p>") }}{% endif %}
                        {%- endif -%}
                    {%- elif personalDataSafeguardTransferReply == uuids.cpersGdprSafeguardsTransferNoAUuid -%}
                        <p>{{ pgettext("questions/07-personal-data", "We do not plan to transfer data outside the EU/EEA.") }}</p>
                    {%- elif not personalDataSafeguardTransferReply -%}
                        {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/07-personal-data", "<p class=\"data-gap\" data-requirement-id=\"SE-4a\" data-fact-id=\"personal-data-transfer\" data-status=\"missing\"><strong>Information not provided:</strong> whether data will be transferred outside the EU/EEA.</p>") }}{% endif %}
                    {%- endif -%}
                    {% endset %}
                    {% if personalDataSafeguardsContent|striptags|trim or '<img' in personalDataSafeguardsContent|lower or '<table' in personalDataSafeguardsContent|lower %}
                      {{ personalDataSafeguardsHeading }}
                      {{ personalDataSafeguardsContent }}
                    {% endif %}
                {%- elif not personalDataSafeguardReply -%}
                    {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/07-personal-data", "<p class=\"data-gap\" data-requirement-id=\"SE-4a\" data-fact-id=\"personal-data-safeguards\" data-status=\"missing\"><strong>Information not provided:</strong> the technical and procedural measures for protecting personal data.</p>") }}{% endif %}
                {%- endif -%}
            {%- endif -%}
        {%- elif personalDataReply == uuids.collectPersonalNoAUuid -%}
        <p>{{ pgettext("questions/07-personal-data", "We will not collect any data related to individuals.") }}</p>
        {%- endif -%}

        {# Managed access procedure to personal data #}
        {%- import 'src/active-answer.j2' as activeAnswer with context -%}
        {%- set openImmediatelyPath = [uuids.accessCUuid, uuids.openImmediatelyQUuid]|reply_path -%}
        {%- set openImmediatelyReply = repliesMap[openImmediatelyPath]|reply_str_value -%}
        {%- set notOpenLegalReasonsQUuid = [uuids.accessCUuid, uuids.openImmediatelyQUuid, uuids.openImmediatelyNoAUuid, uuids.notOpenLegalReasonsQUuid]|reply_path -%}
        {%- set notOpenLegalReasonsReply = repliesMap[notOpenLegalReasonsQUuid]|reply_str_value -%}
        {%- if openImmediatelyReply == uuids.openImmediatelyNoAUuid and notOpenLegalReasonsReply == uuids.notOpenLegalReasonsYesAUuid -%}
            {%- set privacyParts = [uuids.accessCUuid, uuids.openImmediatelyQUuid, uuids.openImmediatelyNoAUuid, uuids.notOpenLegalReasonsQUuid, uuids.notOpenLegalReasonsYesAUuid, uuids.notOpenLegalReasonsPrivacyQUuid] -%}
            {%- set notOpenLegalReasonsPrivacyQUuid = activeAnswer.path(privacyParts, 'OptionsQuestion') if km is defined else privacyParts|reply_path -%}
            {%- set notOpenLegalReasonsPrivacyReply = repliesMap[notOpenLegalReasonsPrivacyQUuid]|reply_str_value if notOpenLegalReasonsPrivacyQUuid else '' -%}

            {%- if notOpenLegalReasonsPrivacyReply == uuids.notOpenLegalReasonsPrivacyYesAUuid and (km is not defined or (notOpenLegalReasonsPrivacyReply in km.entities.questions[uuids.notOpenLegalReasonsPrivacyQUuid].answerUuids and notOpenLegalReasonsPrivacyReply in km.entities.answers)) -%}
                <p data-fact-id="personal-data-privacy-restriction" data-status="complete">{{ pgettext("questions/07-personal-data", "Privacy restrictions prevent some project data from being made openly available.") }}</p>

                {%- set procedureParts = privacyParts + [uuids.notOpenLegalReasonsPrivacyYesAUuid, uuids.notOpenLegalReasonsPrivacyAccessQUuid] -%}
                {%- set personalDataManagedAccessQUuid = activeAnswer.path(procedureParts, 'ValueQuestion') if km is defined else procedureParts|reply_path -%}
                {%- set personalDataManagedAccessReply = repliesMap[personalDataManagedAccessQUuid]|reply_str_value if personalDataManagedAccessQUuid else '' -%}
                
                {%- if personalDataManagedAccessReply|trim -%}
                    <h4>{{ pgettext("questions/07-personal-data", "Access procedure to personal data") }}</h4>
                    <p>{{ pgettext("questions/07-personal-data", "There is a procedure for users to access private data as follows: %(personalDataManagedAccessReply)s", personalDataManagedAccessReply=personalDataManagedAccessReply) }}</p>
                {%- endif -%}
            {%- endif -%}
        {%- endif -%}

    {% endset %}
    {% if answerContent|striptags|trim or '<img' in answerContent or '<table' in answerContent %}
      {{ answerContent }}
    {% else %}
      {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-4a" data-status="missing-output">{{ pgettext("questions/07-personal-data", "This document does not yet contain an answer about personal-data protection and compliance.") }}</p>{% endif %}
    {% endif %}
    </div>
</div>
