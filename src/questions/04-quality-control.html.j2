<div id="q-quality-control" class="question" data-requirement-id="SE-2b">
  <h3>{{ pgettext("questions/04-quality-control", "4. What data quality control measures will be used?") }}</h3>
  <div class="answer">
    {% set measuredPath = [uuids.creatingCUuid, uuids.measuredQUuid]|reply_path %}
    {% set measuredAnswer = repliesMap[measuredPath]|reply_str_value %}
    {% set measuredDataPath = [measuredPath, uuids.measuredYesAUuid, uuids.measuredDataQUuid]|reply_path %}
    {% set measuredDataItems = repliesMap[measuredDataPath]|reply_items %}
    {% set instrumentQuality %}
    {% if measuredAnswer == uuids.measuredYesAUuid and measuredDataItems %}
      {% for datasetItem in measuredDataItems %}
        {% set pathPrefix = [measuredDataPath, datasetItem]|reply_path %}
        {% set measuredDataName = repliesMap[[pathPrefix, uuids.measuredDataNameQUuid]|reply_path]|reply_str_value %}
        {# Q1 already identifies the dataset. Q4 needs actual quality facts,
           not another name-only block when its quality answer is missing. #}
        {% set datasetQuality %}
          {% with qualityNameAlreadyRendered = true %}
          {% include "src/quality-control.html.j2" with context %}
          {% endwith %}
        {% endset %}
        {% if datasetQuality|striptags|trim %}
          <div class="quality-dataset" data-item-id="{{ pathPrefix }}">{{ datasetQuality }}</div>
        {% endif %}
      {% endfor %}
    {% endif %}
    {% endset %}
    {% set researchQuality %}{% include 'src/research-quality.html.j2' %}{% endset %}
    {{ instrumentQuality }}{{ researchQuality }}
    {% if not instrumentQuality|striptags|trim and not researchQuality|striptags|trim %}
      {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-2b" data-status="missing-output">{{ pgettext("questions/04-quality-control", "This document does not yet describe data quality checks. Re-used data also need appropriate quality control.") }}</p>{% endif %}
    {% endif %}
  </div>
</div>
