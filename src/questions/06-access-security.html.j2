{% import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
<div id="q-access-security" class="question">
  <h3>{{ pgettext("questions/06-access-security", "6. How will data security and protection of sensitive data be taken care of during the research?") }}</h3>

  {% set answerContent %}
    {%- import 'src/active-answer.j2' as activeAnswer with context -%}
    {%- set risksParts = [uuids.processingCUuid, uuids.risksQUuid] -%}
    {%- set risksPath = activeAnswer.path(risksParts, 'OptionsQuestion') if km is defined else risksParts|reply_path -%}
    {%- set risksAUuid = repliesMap[risksPath]|reply_str_value if risksPath else '' -%}
    {# All risk follow-ups belong to the explicit Explore decision; workspace
       access and policies below are independent and must remain visible. #}
    {%- if risksAUuid == uuids.risksExploreAUuid and (km is not defined or (risksAUuid in km.entities.questions[uuids.risksQUuid].answerUuids and risksAUuid in km.entities.answers)) -%}
    {%- set risksPathPrefix = [uuids.processingCUuid, uuids.risksQUuid, uuids.risksExploreAUuid]|reply_path -%}
    {# Basic risks #}
    {%- set risksStoreLabParts = [uuids.processingCUuid, uuids.risksQUuid, uuids.risksExploreAUuid, uuids.risksStoreLabQUuid] -%}
    {%- set risksStoreLabPath = activeAnswer.path(risksStoreLabParts, 'OptionsQuestion') if km is defined else risksStoreLabParts|reply_path -%}
    {%- set risksStoreLabAUuid = repliesMap[risksStoreLabPath]|reply_str_value if risksStoreLabPath else '' -%}
    {%- if km is defined and risksStoreLabPath and (risksStoreLabAUuid not in km.entities.questions[uuids.risksStoreLabQUuid].answerUuids or risksStoreLabAUuid not in km.entities.answers) -%}
      {%- set risksStoreLabAUuid = '' -%}
    {%- endif -%}
    {%- set risksCarryHomeParts = [uuids.processingCUuid, uuids.risksQUuid, uuids.risksExploreAUuid, uuids.risksCarryHomeQUuid] -%}
    {%- set risksCarryHomePath = activeAnswer.path(risksCarryHomeParts, 'OptionsQuestion') if km is defined else risksCarryHomeParts|reply_path -%}
    {%- set risksCarryHomeAUuid = repliesMap[risksCarryHomePath]|reply_str_value if risksCarryHomePath else '' -%}
    {%- if km is defined and risksCarryHomePath and (risksCarryHomeAUuid not in km.entities.questions[uuids.risksCarryHomeQUuid].answerUuids or risksCarryHomeAUuid not in km.entities.answers) -%}
      {%- set risksCarryHomeAUuid = '' -%}
    {%- endif -%}
    {%- set risksCarryHomeEncParts = [uuids.processingCUuid, uuids.risksQUuid, uuids.risksExploreAUuid, uuids.risksCarryHomeQUuid, uuids.risksCarryHomeYesAUuid, uuids.risksCarryHomeEncQUuid] -%}
    {%- set risksCarryHomeEncPath = activeAnswer.path(risksCarryHomeEncParts, 'OptionsQuestion') if km is defined else risksCarryHomeEncParts|reply_path -%}
    {%- set risksCarryHomeEncAUuid = repliesMap[risksCarryHomeEncPath]|reply_str_value if risksCarryHomeEncPath and risksAUuid == uuids.risksExploreAUuid and risksCarryHomeAUuid == uuids.risksCarryHomeYesAUuid else '' -%}
    {%- if km is defined and risksCarryHomeEncPath and (risksCarryHomeEncAUuid not in km.entities.questions[uuids.risksCarryHomeEncQUuid].answerUuids or risksCarryHomeEncAUuid not in km.entities.answers) -%}
      {%- set risksCarryHomeEncAUuid = '' -%}
    {%- endif -%}
    {%- set risksCarryHomePassParts = [uuids.processingCUuid, uuids.risksQUuid, uuids.risksExploreAUuid, uuids.risksCarryHomeQUuid, uuids.risksCarryHomeYesAUuid, uuids.risksCarryHomePassQUuid] -%}
    {%- set risksCarryHomePassPath = activeAnswer.path(risksCarryHomePassParts, 'OptionsQuestion') if km is defined else risksCarryHomePassParts|reply_path -%}
    {%- set risksCarryHomePassAUuid = repliesMap[risksCarryHomePassPath]|reply_str_value if risksCarryHomePassPath and risksCarryHomeAUuid == uuids.risksCarryHomeYesAUuid else '' -%}
    {%- if km is defined and risksCarryHomePassPath and (risksCarryHomePassAUuid not in km.entities.questions[uuids.risksCarryHomePassQUuid].answerUuids or risksCarryHomePassAUuid not in km.entities.answers) -%}
      {%- set risksCarryHomePassAUuid = '' -%}
    {%- endif -%}
    {%- set risksCertificationsParts = [uuids.processingCUuid, uuids.risksQUuid, uuids.risksExploreAUuid, uuids.risksCertificationsQUuid] -%}
    {%- set risksCertificationsPath = activeAnswer.path(risksCertificationsParts, 'OptionsQuestion') if km is defined else risksCertificationsParts|reply_path -%}
    {%- set risksCertificationsAUuid = repliesMap[risksCertificationsPath]|reply_str_value if risksCertificationsPath and risksAUuid == uuids.risksExploreAUuid else '' -%}
    {%- if km is defined and risksCertificationsPath and (risksCertificationsAUuid not in km.entities.questions[uuids.risksCertificationsQUuid].answerUuids or risksCertificationsAUuid not in km.entities.answers) -%}
      {%- set risksCertificationsAUuid = '' -%}
    {%- endif -%}
    {%- set risksHttpsParts = [uuids.processingCUuid, uuids.risksQUuid, uuids.risksExploreAUuid, uuids.risksHttpsQUuid] -%}
    {%- set risksHttpsPath = activeAnswer.path(risksHttpsParts, 'OptionsQuestion') if km is defined else risksHttpsParts|reply_path -%}
    {%- set risksHttpsAUuid = repliesMap[risksHttpsPath]|reply_str_value if risksHttpsPath else '' -%}
    {%- if km is defined and risksHttpsPath and (risksHttpsAUuid not in km.entities.questions[uuids.risksHttpsQUuid].answerUuids or risksHttpsAUuid not in km.entities.answers) -%}
      {%- set risksHttpsAUuid = '' -%}
    {%- endif -%}
    {%- set risksInstructedParts = [uuids.processingCUuid, uuids.risksQUuid, uuids.risksExploreAUuid, uuids.risksInstructedQUuid] -%}
    {%- set risksInstructedPath = activeAnswer.path(risksInstructedParts, 'OptionsQuestion') if km is defined else risksInstructedParts|reply_path -%}
    {%- set risksInstructedAUuid = repliesMap[risksInstructedPath]|reply_str_value if risksInstructedPath else '' -%}
    {%- if km is defined and risksInstructedPath and (risksInstructedAUuid not in km.entities.questions[uuids.risksInstructedQUuid].answerUuids or risksInstructedAUuid not in km.entities.answers) -%}
      {%- set risksInstructedAUuid = '' -%}
    {%- endif -%}

    {%- set homeEncrypted = risksCarryHomeEncAUuid == uuids.risksCarryHomeEncYesAUuid -%}
    {%- set homeNotEncrypted = risksCarryHomeEncAUuid == uuids.risksCarryHomeEncNoAUuid -%}
    {%- set homePassword = risksAUuid == uuids.risksExploreAUuid and risksCarryHomeAUuid == uuids.risksCarryHomeYesAUuid and risksCarryHomePassAUuid == uuids.risksCarryHomePassYesAUuid -%}
    {%- set homeNotPassword = risksCarryHomeAUuid == uuids.risksCarryHomeYesAUuid and risksCarryHomePassAUuid == uuids.risksCarryHomePassNoAUuid -%}
    {%- set storeLab = risksStoreLabAUuid == uuids.risksStoreLabNoAUuid -%}

    {%- if risksStoreLabAUuid in [uuids.risksStoreLabNoAUuid, uuids.risksStoreLabYesAUuid] or (risksCarryHomeAUuid in [uuids.risksCarryHomeNoAUuid, uuids.risksCarryHomeYesAUuid]) or (risksCertificationsAUuid in [uuids.risksCertificationsYesAUuid, uuids.risksCertificationsNoAUuid]) or (risksHttpsAUuid in [uuids.risksHttpsYesAUuid, uuids.risksHttpsNoAUuid]) or (risksInstructedAUuid in [uuids.risksInstructedYesAUuid, uuids.risksInstructedNoAUuid]) %}
      {# Only template-owned fixed statements are captured; no authored answer enters this block.
         Chinese joins complete clauses without source indentation; English keeps it unchanged. #}{% set basicRiskParagraph %}<p>
        {%- if storeLab %}
          {{ pgettext("questions/06-access-security", "Project members do not store data or software on computers in the lab or external hard drives connected to those computers.") }}{{ "" if document_language|default('en') == 'zh-Hant' else " " }}
        {%- elif risksStoreLabAUuid == uuids.risksStoreLabYesAUuid %}
          {{ pgettext("questions/06-access-security", "Project members store data or software on computers in the lab or external hard drives connected to those computers.") }}{{ "" if document_language|default('en') == 'zh-Hant' else " " }}
        {%- endif -%}
        {%- if risksCarryHomeAUuid == uuids.risksCarryHomeNoAUuid %}
          {{ pgettext("questions/06-access-security", "Project members do not carry data with them (e.g. on laptops, USB sticks, or other external media).") }}
        {%- elif risksCarryHomeAUuid == uuids.risksCarryHomeYesAUuid %}
          {{ pgettext("questions/06-access-security", "Project members carry data with them (e.g. on laptops, USB sticks, or other external media).") }}
        {%- endif -%}
        {%- if homeEncrypted %}
          {{ pgettext("questions/06-access-security", "All data carriers are encrypted.") }}
        {%- elif homeNotEncrypted %}
          {{ pgettext("questions/06-access-security", "Not all data carriers are encrypted.") }}
        {%- endif -%}
        {%- if homePassword %}
          {{ pgettext("questions/06-access-security", "Accounts on laptops are password-protected.") }}
        {%- elif homeNotPassword %}
          {{ pgettext("questions/06-access-security", "Not all laptop accounts are password-protected.") }}
        {%- endif -%}
        {%- if risksCertificationsAUuid == uuids.risksCertificationsYesAUuid %}
          {{ pgettext("questions/06-access-security", "All data centres that store project data hold appropriate certifications.") }}
        {%- elif risksCertificationsAUuid == uuids.risksCertificationsNoAUuid %}
          {{ pgettext("questions/06-access-security", "Not all data centres that store project data hold appropriate certifications.") }}
        {%- endif -%}
        {%- if risksHttpsAUuid == uuids.risksHttpsYesAUuid %}
          {{ pgettext("questions/06-access-security", "All project web services are accessible through HTTPS.") }}
        {%- elif risksHttpsAUuid == uuids.risksHttpsNoAUuid %}
          {{ pgettext("questions/06-access-security", "Not all project web services are accessible through HTTPS.") }}
        {%- endif -%}
        {%- if risksInstructedAUuid == uuids.risksInstructedYesAUuid %}
          {{ pgettext("questions/06-access-security", "Project members have been instructed about both generic and specific risks to the project.") }}
        {%- elif risksInstructedAUuid == uuids.risksInstructedNoAUuid %}
          {{ pgettext("questions/06-access-security", "Project members have not received instruction covering both generic and project-specific risks.") }}
        {%- endif -%}
      </p>{% endset %}{{ basicRiskParagraph.splitlines()|map('trim')|join('') if document_language|default('en') == 'zh-Hant' else basicRiskParagraph }}
    {%- endif -%}
    {# Information loss, leak, and vandalism #}
    {%- set riskAnswers = {} -%}
    {%- for question in [uuids.risksInfoLossQUuid, uuids.risksInfoLeakQUuid, uuids.risksInfoVandalismQUuid] -%}
      {%- set parts = [uuids.processingCUuid, uuids.risksQUuid, uuids.risksExploreAUuid, question] -%}
      {%- set answerPath = activeAnswer.path(parts, 'OptionsQuestion') if km is defined else parts|reply_path -%}
      {%- set choice = repliesMap[answerPath]|reply_str_value if answerPath else '' -%}
      {%- if km is not defined or (answerPath and choice in km.entities.questions[question].answerUuids and choice in km.entities.answers) -%}
        {%- do riskAnswers.update({question: choice}) -%}
      {%- endif -%}
    {%- endfor -%}

    {# Define mapping of UUIDs to qualitative levels #}
    {%- set risk_levels = {
      uuids.risksInfoLossNoAUuid: 'not-considered',
      uuids.risksInfoLossSmallAUuid: 'small',
      uuids.risksInfoLossLowAUuid: 'low',
      uuids.risksInfoLossWillAUuid: 'will',
      uuids.risksInfoLeakNoAUuid: 'not-considered',
      uuids.risksInfoLeakSmallAUuid: 'small',
      uuids.risksInfoLeakLowAUuid: 'low',
      uuids.risksInfoLeakWillAUuid: 'will',
      uuids.risksInfoVandalismNoAUuid: 'not-considered',
      uuids.risksInfoVandalismSmallAUuid: 'small',
      uuids.risksInfoVandalismLowAUuid: 'low',
      uuids.risksInfoVandalismWillAUuid: 'will'
    } -%}

    {# Captured labels remain translatable before they are joined into prose. #}
    {%- set riskLoss %}{{ pgettext("questions/06-access-security", "data loss") }}{% endset -%}
    {%- set riskDisclosure %}{{ pgettext("questions/06-access-security", "data disclosure") }}{% endset -%}
    {%- set riskTampering %}{{ pgettext("questions/06-access-security", "data tampering") }}{% endset -%}

    {# Use complete translatable combinations so localized output never leaks
       the English conjunction from a dynamically joined list. #}
    {%- macro risk_list(values) -%}
      {%- if values|length == 1 -%}
        {{ values[0] }}
      {%- elif riskLoss in values and riskDisclosure in values and riskTampering in values -%}
        {{ pgettext("questions/06-access-security", "data loss, data disclosure, and data tampering") }}
      {%- elif riskLoss in values and riskDisclosure in values -%}
        {{ pgettext("questions/06-access-security", "data loss and data disclosure") }}
      {%- elif riskLoss in values and riskTampering in values -%}
        {{ pgettext("questions/06-access-security", "data loss and data tampering") }}
      {%- elif riskDisclosure in values and riskTampering in values -%}
        {{ pgettext("questions/06-access-security", "data disclosure and data tampering") }}
      {%- endif -%}
    {%- endmacro -%}

    {# Extract selected levels for each type #}
    {%- set selected = {
      riskLoss: risk_levels.get(riskAnswers.get(uuids.risksInfoLossQUuid, '')),
      riskDisclosure: risk_levels.get(riskAnswers.get(uuids.risksInfoLeakQUuid, '')),
      riskTampering: risk_levels.get(riskAnswers.get(uuids.risksInfoVandalismQUuid, ''))
    } -%}

    {%- set small = [] -%}
    {%- set low = [] -%}
    {%- set will = [] -%}
    {%- set notConsidered = [] -%}

    {# simple grouping in one pass #}
    {%- for key, level in selected.items() -%}
      {%- if level == 'small' -%}
        {%- do small.append(key) -%}
      {%- elif level == 'low' -%}
        {%- do low.append(key) -%}
      {%- elif level == 'will' -%}
        {%- do will.append(key) -%}
      {%- elif level == 'not-considered' -%}
        {%- do notConsidered.append(key) -%}
      {%- endif -%}
    {%- endfor -%}

    {# helper inline join #}
    {%- set fragments = [] -%}
    {%- if small|length > 0 -%}
      {%- set risks = risk_list(small)|trim -%}
      {%- set _ = fragments.append(pgettext("questions/06-access-security", "The potential impact of %(risks)s is small", risks=risks)) -%}
    {%- endif -%}
    {%- if low|length > 0 -%}
      {%- set risks = risk_list(low)|trim -%}
      {%- set _ = fragments.append(pgettext("questions/06-access-security", "The risk of %(risks)s is acceptably low", risks=risks)) -%}
    {%- endif -%}
    {%- if will|length > 0 -%}
      {%- set risks = risk_list(will)|trim -%}
      {%- set _ = fragments.append(pgettext("questions/06-access-security", "We will mitigate the risk of %(risks)s", risks=risks)) -%}
    {%- endif -%}
    {%- if notConsidered|length > 0 -%}
      {%- set risks = risk_list(notConsidered)|trim -%}
      {%- set _ = fragments.append(pgettext("questions/06-access-security", "We have not considered the possible impact on the project or organization of %(risks)s", risks=risks)) -%}
    {%- endif -%}
    {%- if fragments|length > 0 -%}
      <p>{{ fragments | join('。' if document_language|default('en') == 'zh-Hant' else '. ') }}{{ '。' if document_language|default('en') == 'zh-Hant' else '.' }}</p>
    {%- endif -%}
    {# Personal data #}
    {%- set risksPersonalDataPath = [risksPathPrefix, uuids.risksPersonalDataQUuid]|reply_path -%}
    {%- set risksPersonalDataAUuid = repliesMap[risksPersonalDataPath]|reply_str_value -%}
    {%- if risksPersonalDataAUuid == uuids.risksPersonalDataNotUsingAUuid -%}
      <p>{{ pgettext("questions/06-access-security", "We are not using any personal information.") }}</p>
    {%- elif risksPersonalDataAUuid == uuids.risksPersonalDataPseudoAUuid -%}
      {%- set risksPseudonymizationPath = [risksPersonalDataPath, uuids.risksPersonalDataPseudoAUuid, uuids.risksPseudonymizationQUuid]|reply_path -%}
      {%- set risksPseudonymizationAUuid = repliesMap[risksPseudonymizationPath]|reply_str_value -%}
      {%- set risksPseudonymizationAnotherPath = [risksPseudonymizationPath, uuids.risksPseudonymizationAnotherAUuid, uuids.risksPseudonymizationAnotherQUuid]|reply_path -%}
      {%- set risksPseudonymizationAnother = repliesMap[risksPseudonymizationAnotherPath]|reply_str_value -%}
      {%- set hasPseudonymizationDetail = risksPseudonymizationAUuid == uuids.risksPseudonymizationAnotherAUuid and risksPseudonymizationAnother|trim -%}
      {%- set custodianParts = [uuids.processingCUuid, uuids.risksQUuid, uuids.risksExploreAUuid, uuids.risksPersonalDataQUuid, uuids.risksPersonalDataPseudoAUuid, uuids.risksPseudonymizationQUuid, uuids.risksPseudonymizationPartyAUuid, uuids.risksPseudonymizationPartyQUuid] -%}
      {%- set custodianPath = activeAnswer.path(custodianParts, 'ValueQuestion') if km is defined else custodianParts|reply_path -%}
      {%- set custodianValid = namespace(value=risksPseudonymizationAUuid == uuids.risksPseudonymizationPartyAUuid and custodianPath) -%}
      {%- for end in [2, 4, 6, 8] -%}
        {%- set typedPath = custodianParts[:end]|reply_path -%}
        {%- set expectedReply = 'StringReply' if end == 8 else 'AnswerReply' -%}
        {%- if typedPath in repliesMap and repliesMap[typedPath].value is defined and repliesMap[typedPath].value.type is defined and repliesMap[typedPath].value.type != expectedReply -%}
          {%- set custodianValid.value = false -%}
        {%- endif -%}
        {%- if end == 8 and typedPath in repliesMap and repliesMap[typedPath].value is defined and repliesMap[typedPath].value.type is defined and repliesMap[typedPath].value.value is not string -%}
          {%- set custodianValid.value = false -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if km is defined and custodianPath and km.entities.questions[uuids.risksPseudonymizationPartyQUuid].valueType != 'TextQuestionValueType' -%}
        {%- set custodianValid.value = false -%}
      {%- endif -%}
      {%- set custodian = repliesMap[custodianPath]|reply_str_value if custodianValid.value else '' -%}
      <div class="answer-detail">
      <div{% if hasPseudonymizationDetail or custodian|trim %} class="answer-lead"{% endif %}><p>
        {{ pgettext("questions/06-access-security", "All personal data will be processed in pseudonymized form only.") }}
        {%- if risksPseudonymizationAUuid == uuids.risksPseudonymizationInsideAUuid %}
          {{ pgettext("questions/06-access-security", "Pseudonymization is performed within the project, and only a limited number of people can access the re-identification keys.") }}
        {%- elif risksPseudonymizationAUuid == uuids.risksPseudonymizationPartyAUuid %}
          {{ pgettext("questions/06-access-security", "Pseudonymization is performed by an independent party to enable data linkage.") }}
        {%- elif risksPseudonymizationAUuid == uuids.risksPseudonymizationAnotherAUuid %}
          {{ pgettext("questions/06-access-security", "We use a specific pseudonymization method:") if hasPseudonymizationDetail else pgettext("questions/06-access-security", "We use a specific pseudonymization method.") }}
        {%- endif -%}
      </p></div>
      {% if hasPseudonymizationDetail %}{{ answerMarkdown.markdown(risksPseudonymizationAnother) }}{% endif %}
      {% if custodian|trim %}
        <div class="answer-detail" data-fact-id="pseudonymization-key-custodian" data-status="complete">
          <div class="answer-lead"><p>{{ pgettext("questions/06-access-security", "Independent party that keeps the pseudonymization keys:") }}</p></div>
          {{ answerMarkdown.markdown(custodian) }}
        </div>
      {% endif %}
      </div>
    {%- elif risksPersonalDataAUuid == uuids.risksPersonalDataAnonymousAUuid -%}
      <p>{{ pgettext("questions/06-access-security", "All personal data will be collected anonymously.") }}</p>
    {%- elif risksPersonalDataAUuid == uuids.risksPersonalDataAnonymizedAUuid -%}
      <p>{{ pgettext("questions/06-access-security", "All personal data will be anonymized as early as possible.") }}</p>
    {%- endif -%}
    

    {%- endif -%}
    {# Access controls remain here; archival/backup facts are owned by Q5. #}
    {%- set sharedWorkspacePath = [uuids.processingCUuid, uuids.sharedWorkspaceQUuid]|reply_path -%}
    {%- set sharedWorkspaceAUuid = repliesMap[sharedWorkspacePath]|reply_str_value -%}

    {# Access control in shared workspace #}
    {%- set sharedAccessControlParts = [uuids.processingCUuid, uuids.sharedWorkspaceQUuid, uuids.sharedWorkspaceYesAUuid, uuids.sharedAccessControlQUuid] -%}
    {%- set sharedAccessControlPath = activeAnswer.path(sharedAccessControlParts, 'OptionsQuestion') if km is defined else sharedAccessControlParts|reply_path -%}
    {%- set sharedAccessControlAUuid = repliesMap[sharedAccessControlPath]|reply_str_value if sharedAccessControlPath else '' -%}
    {%- if sharedWorkspaceAUuid == uuids.sharedWorkspaceYesAUuid and sharedAccessControlAUuid in [uuids.sharedAccessControlMembersRWAUuid, uuids.sharedAccessControlInstituteRAUuid, uuids.sharedAccessControlMembersRAUuid, uuids.sharedAccessControlMembersRequestAUuid] and (km is not defined or (sharedAccessControlAUuid in km.entities.questions[uuids.sharedAccessControlQUuid].answerUuids and sharedAccessControlAUuid in km.entities.answers)) -%}
      <h4>{{ pgettext("questions/06-access-security", "Access to data during research") }}</h4>
      {%- if sharedAccessControlAUuid == uuids.sharedAccessControlMembersRWAUuid -%}
        <p>{{ pgettext("questions/06-access-security", "All project members, and no one else, have read and write access to the data.") }}</p>
      {%- elif sharedAccessControlAUuid == uuids.sharedAccessControlInstituteRAUuid -%}
        <p>{{ pgettext("questions/06-access-security", "Everyone at the institute has read access to the data; all project members have read and write access.") }}</p>
      {%- elif sharedAccessControlAUuid == uuids.sharedAccessControlMembersRAUuid -%}
        <p>{{ pgettext("questions/06-access-security", "Only project members have read access; only designated project members can modify the data.") }}</p>
      {%- elif sharedAccessControlAUuid == uuids.sharedAccessControlMembersRequestAUuid -%}
        <p>{{ pgettext("questions/06-access-security", "Everyone at the institute can read the data; only project members can request write access.") }}</p>
      {%- endif -%}
    {%- endif -%}

    {# Policies and Procedures for DMP #}
    {%- set policiesProceduresQUuid = [uuids.adminDetailsCUuid, uuids.policiesProceduresQUuid]|reply_path -%}
    {%- set policiesProceduresItems = repliesMap [policiesProceduresQUuid]|reply_items -%}
    {%- if policiesProceduresItems|length > 0 -%}
      {% set policyEntries %}
        {%- for policiesProceduresItem in policiesProceduresItems -%}
          {%- set policiesProceduresPathPrefix =  [policiesProceduresQUuid, policiesProceduresItem ]|reply_path -%}
            {%- set policiesProceduresItemNameQUuid = [policiesProceduresPathPrefix, uuids.policiesProceduresNameQUuid]|reply_path -%}
            {%- set policiesProceduresItemNameReply = repliesMap[policiesProceduresItemNameQUuid]|reply_str_value -%}
            {%- set policiesProceduresItemLinkQUuid = [policiesProceduresPathPrefix, uuids.policiesProceduresLinkQUuid]|reply_path  -%}
            {%- set policiesProceduresItemLinkReply = repliesMap[policiesProceduresItemLinkQUuid]|reply_str_value -%}
            {%- set policiesProceduresItemDescriptionQUuid = [policiesProceduresPathPrefix, uuids.policiesProceduresDescriptionQUuid]|reply_path -%}
            {%- set policiesProceduresItemDescriptionReply = repliesMap[policiesProceduresItemDescriptionQUuid]|reply_str_value  -%}
          {# A missing name must not hide an independent link or description. #}
          {% if policiesProceduresItemNameReply|trim or policiesProceduresItemLinkReply|trim or policiesProceduresItemDescriptionReply|trim %}
          <li>
            {% if policiesProceduresItemNameReply|trim %}<strong>{{ policiesProceduresItemNameReply|e }}</strong>{% endif %}
            {% if policiesProceduresItemNameReply|trim and policiesProceduresItemLinkReply|trim %}<span class="separator">&ndash;</span>{% endif %}
            {% if policiesProceduresItemLinkReply|trim %}{{ policiesProceduresItemLinkReply|e }}{% endif %}
            {% if policiesProceduresItemDescriptionReply|trim %}{{ answerMarkdown.markdown(policiesProceduresItemDescriptionReply) }}{% endif %}
          </li>
          {% endif %}
        {%- endfor -%}
      {% endset %}
      {% if policyEntries|trim %}
      <h4>{{ pgettext("questions/06-access-security", "Policies and Procedures") }}</h4>
      <div class="answer-lead"><p>{{ pgettext("questions/06-access-security", "We will use the following policies and procedures:") }}</p></div>
      <ul>{{ policyEntries }}</ul>
      {% endif %}
    {%- endif -%}
  {% endset %}
  {% set securityAnswer %}
  {% if answerContent|striptags|trim or '<img' in answerContent or '<table' in answerContent %}
    {{ answerContent }}
  {% else %}
