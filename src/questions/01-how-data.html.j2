{% import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
<div id="q-how-data" class="question" data-requirement-id="SE-1a">
  <h3>{{ pgettext("questions/01-how-data", "1. How will new data be collected or produced and/or how will existing data be re-used?") }}</h3>

  <div class="answer">
  {%- import 'src/reuse-rightsholder.html.j2' as reuseRightsholder with context -%}
  {%- import 'src/nonreuse.html.j2' as nonreuse with context -%}
  {%- import 'src/active-answer.j2' as activeAnswer with context -%}
  
  {%- set measuredParts = [uuids.creatingCUuid, uuids.measuredQUuid] -%}
  {%- set measuredPath = activeAnswer.path(measuredParts, 'OptionsQuestion') if km is defined else measuredParts|reply_path -%}
  {%- set measuredAUuid = repliesMap[measuredPath]|reply_str_value if measuredPath else '' -%}
  {%- if km is defined and measuredPath and (measuredAUuid not in km.entities.questions[uuids.measuredQUuid].answerUuids or measuredAUuid not in km.entities.answers) -%}
    {%- set measuredAUuid = '' -%}
  {%- endif -%}
  {%- if measuredAUuid == uuids.measuredYesAUuid -%}
    {# Measured datasets #}
    {%- set measuredDataPath = [measuredPath, uuids.measuredYesAUuid, uuids.measuredDataQUuid]|reply_path -%}
    {%- set measuredDataItems = repliesMap[measuredDataPath]|reply_items -%}
    {%- if measuredDataItems|length > 0 -%}
      <h4>{{ pgettext("questions/01-how-data", "Instrument datasets") }}</h4>
      <ul>
        {%- for datasetItem in measuredDataItems -%}
          {%- set pathPrefix = [measuredDataPath, datasetItem]|reply_path -%}
          <li data-item-id="{{ pathPrefix }}">
            {%- set measuredDataNamePath = [pathPrefix, uuids.measuredDataNameQUuid]|reply_path -%}
            {%- set measuredDataName = repliesMap[measuredDataNamePath]|reply_str_value -%}
            <h5>{% if output_profile|default('review') == 'submission' and not measuredDataName|trim %}{{ macros.datasetLabel(macros.DATASET_INSTRUMENT, measuredDataItems.index(datasetItem) + 1) }}{% else %}{{ measuredDataName if measuredDataName|trim else pgettext("questions/01-how-data", "(no name given)") }}{% endif %}</h5>
            {# Instruments #}
            {%- set measuredDataInstrPath = [pathPrefix, uuids.measuredDataInstrQUuid]|reply_path -%}
            {%- set measuredDataInstrItems = repliesMap[measuredDataInstrPath]|reply_items -%}
            {%- set instrumentRows = [] -%}
            {%- for instrItem in measuredDataInstrItems -%}
              {%- set instrPathPrefix = [measuredDataInstrPath, instrItem]|reply_path -%}
              {%- set name = repliesMap[[instrPathPrefix, uuids.measuredDataInstrNameQUuid]|reply_path]|reply_str_value -%}
              {%- set description = repliesMap[[instrPathPrefix, uuids.measuredDataInstrDescQUuid]|reply_path]|reply_str_value -%}
              {%- if name|trim or description|trim or output_profile|default('review') != 'submission' -%}
                {%- do instrumentRows.append([loop.index, name, description]) -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if instrumentRows -%}
              <p>{{ pgettext("questions/01-how-data", "For this dataset, we are using the following instruments:") }}</p>
              <ul>
                {%- for index, measuredDataInstrName, measuredDataInstrDesc in instrumentRows -%}
                  <li>
                    {{ macros.instrumentEntry(index, measuredDataInstrName, measuredDataInstrDesc) }}
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              {% if output_profile|default('review') != 'submission' %}<p>{{ pgettext("questions/01-how-data", "No instruments for this dataset have been specified.") }}</p>{% endif %}
            {%- endif -%}
            {% with qualityNameAlreadyRendered = true %}
              {% include "src/quality-control.html.j2" with context %}
            {% endwith %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p>{{ pgettext("questions/01-how-data", "We will acquire data using measurement equipment.") }}</p>
      {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-requirement-id=\"SE-1a\" data-fact-id=\"collection-methods\" data-status=\"missing\"><strong>Information not provided:</strong> the datasets to be collected or produced and the methods, instruments, or software that will be used.</p>") }}{% endif %}
    {%- endif -%}
  {%- elif measuredAUuid == uuids.measuredNoAUuid -%}
    <p data-requirement-id="SE-1a" data-fact-id="new-data" data-status="explicit-no">{{ pgettext("questions/01-how-data", "No new instrument datasets will be produced in this project.") }}</p>
  {%- else -%}
    {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-requirement-id=\"SE-1a\" data-fact-id=\"new-data\" data-status=\"missing\"><strong>Information not provided:</strong> whether the project will collect or produce new instrument data.</p>") }}{% endif %}
  {%- endif -%}

 {# Existing datasets #}
  {%- set preexistingPath = [uuids.reusingCUuid, uuids.preexistingQUuid]|reply_path -%}
  {%- set preexistingAUuid = repliesMap[preexistingPath]|reply_str_value -%}
  {%- if preexistingAUuid == uuids.preexistingYesAUuid -%}
    {%- set refDataPath = [preexistingPath, uuids.preexistingYesAUuid, uuids.refDataQUuid]|reply_path -%}
    {%- set refDataItems = repliesMap[refDataPath]|reply_items -%}
    {%- set nrefDataPath = [preexistingPath, uuids.preexistingYesAUuid, uuids.nrefDataQUuid]|reply_path -%}
    {%- set nrefDataItems = repliesMap[nrefDataPath]|reply_items -%}

    {# Share only identical, fully specified rules for selected reference data.
       Free answers, unknown conditions and non-reference scopes stay separate. #}
    {% set referencePolicies = namespace(signatures=[], names=[], content='') %}
    {% for item in refDataItems %}
      {% set itemPath = [refDataPath, item]|reply_path %}
      {% set usePath = [itemPath, uuids.refDataUseQUuid]|reply_path %}
      {% if repliesMap[usePath]|reply_str_value == uuids.refDataUseYesAUuid %}
        {% set usedPath = [usePath, uuids.refDataUseYesAUuid]|reply_path %}
        {% set reproduction = repliesMap[[usedPath, uuids.refDataReproduceQUuid]|reply_path]|reply_str_value %}
        {% set conditions = repliesMap[[usedPath, uuids.refDataConditionsQUuid]|reply_path]|reply_str_value %}
        {% set format = repliesMap[[usedPath, uuids.refDataFormatQUuid]|reply_path]|reply_str_value %}
        {% set name = repliesMap[[itemPath, uuids.refDataNameQUuid]|reply_path]|reply_str_value %}
        {% set known = name|trim and reproduction in [uuids.refDataReproduceProviderAUuid, uuids.refDataReproduceCopyAUuid, uuids.refDataReproduceBothAUuid] and conditions in [uuids.refDataConditionsCC0AUuid, uuids.refDataConditionsCCBYAUuid] and format in [uuids.refDataFormatConvertAUuid, uuids.refDataFormatUseAUuid] %}
        {% do referencePolicies.signatures.append([reproduction, conditions, format] if known else [item]) %}
        {% do referencePolicies.names.append(name) %}
      {% endif %}
    {% endfor %}
    {% set sharedReferencePolicy = referencePolicies.signatures|length > 1 and referencePolicies.signatures|select('equalto', referencePolicies.signatures[0])|list|length == referencePolicies.signatures|length %}

    {%- if (refDataItems|length > 0) or (nrefDataItems|length > 0) -%}
      <div>
      <h4>{{ pgettext("questions/01-how-data", "Re-used datasets") }}</h4>
      <ul class="dataset-list">
      {# Reference Data #}
        {%- for refDataItem in refDataItems -%}
          <li data-item-id="{{ refDataItem }}">
          {%- set refDataPrefix = [refDataPath, refDataItem]|reply_path -%}
          {%- set refDataUse = [refDataPrefix, uuids.refDataUseQUuid]|reply_path -%}
          {%- set refDataUseReply = repliesMap[refDataUse]|reply_str_value -%}
          {%- set refDataUsedPrefix = [refDataUse, uuids.refDataUseYesAUuid]|reply_path -%}
          {%- set refDataNameReply = repliesMap[[refDataPrefix, uuids.refDataNameQUuid]|reply_path]|reply_str_value -%}

          {%- set refDataWhere = repliesMap[[refDataPrefix, uuids.refDataWhereQUuid]|reply_path]|reply_str_value -%}

          {%- if refDataNameReply|trim -%}
            <h5>{{ refDataNameReply }}</h5>
          {%- else -%}
            {% if output_profile|default('review') == 'submission' %}<strong class="item-label">{{ macros.datasetLabel(macros.DATASET_REFERENCE, refDataItems.index(refDataItem) + 1) }}</strong>{% else %}{{ pgettext("questions/01-how-data", "<strong class=\"item-label\">(no name given)</strong>") }}{% endif %}
          {%- endif -%}
          
          {# Reference data set will be used #}
          {%- if refDataUseReply == uuids.refDataUseYesAUuid  %}
            {{ reuseRightsholder.render(refDataUsedPrefix.split('.') + [uuids.refDataOwnerQUuid]) }}
            {# identification #}
            <div data-fact-id="reuse-decision" data-status="complete">
            {% if refDataWhere|trim %}
              {% if refDataWhere.startswith("https://") or refDataWhere.startswith("http://") or refDataWhere.startswith("ftp://") %}
              {{ pgettext("questions/01-how-data", "<p class=\"dataset-source\" data-fact-id=\"dataset-source\" data-status=\"complete\">Source: <a href=\"%(refDataWhere)s\">%(refDataWhere)s</a></p>", refDataWhere=refDataWhere) }}
            {% else %}
              {{ pgettext("questions/01-how-data", "<p data-fact-id=\"dataset-source\" data-status=\"complete\">Source: %(refDataWhere)s</p>", refDataWhere=refDataWhere) }}
            {% endif %}
            {% else %}
              {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-fact-id=\"dataset-source\" data-status=\"missing\"><strong>Information not provided:</strong> where this dataset can be obtained.</p>") }}{% endif %}
            {% endif %}
            {%- set refDataUsageQ = [refDataUsedPrefix, uuids.refDataUsageQUuid]|reply_path -%}
            {%- set refDataUsageReply = repliesMap[refDataUsageQ]|reply_str_value -%}
            {% if refDataUsageReply|trim %}
              <div class="answer-detail" data-fact-id="reuse-purpose" data-status="complete">
                {{ answerMarkdown.markdown(refDataUsageReply) }}
              </div>
            {% else %}
              {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-fact-id=\"reuse-purpose\" data-status=\"missing\"><strong>Information not provided:</strong> the purpose for which this dataset will be re-used.</p>") }}{% endif %}
            {% endif %}

            {# version #}
            {%- set refDataVersionedParts = refDataUsedPrefix.split('.') + [uuids.refDataVersionedQUuid] -%}
            {%- set refDataVersionedPath = activeAnswer.path(refDataVersionedParts, 'OptionsQuestion') if km is defined else refDataVersionedParts|reply_path -%}
            {%- set refDataVersionedAUuid = repliesMap[refDataVersionedPath]|reply_str_value if refDataVersionedPath else '' -%}
            {%- if refDataVersionedPath in repliesMap and repliesMap[refDataVersionedPath].value is defined and repliesMap[refDataVersionedPath].value.type is defined and repliesMap[refDataVersionedPath].value.type != 'AnswerReply' -%}
              {%- set refDataVersionedAUuid = '' -%}
            {%- endif -%}
            {%- if km is defined and refDataVersionedPath and (refDataVersionedAUuid not in km.entities.questions[uuids.refDataVersionedQUuid].answerUuids or refDataVersionedAUuid not in km.entities.answers) -%}
              {%- set refDataVersionedAUuid = '' -%}
            {%- endif -%}
            {%- if refDataVersionedAUuid == uuids.refDataVersionedYesAUuid -%}
              {%- set refDataVersionedWhichPath = [refDataVersionedPath, uuids.refDataVersionedYesAUuid, uuids.refDataVersionedWhichQUuid]|reply_path -%}
              {%- set refDataVersionedWhich = repliesMap[refDataVersionedWhichPath]|reply_str_value -%}
              {%- set refDataVersionedChangePath = [refDataVersionedPath, uuids.refDataVersionedYesAUuid, uuids.refDataVersionedChangeQUuid]|reply_path -%}
              {%- set refDataVersionedChangeAUuid = repliesMap[refDataVersionedChangePath]|reply_str_value -%}
              {% if not refDataVersionedWhich|trim and refDataVersionedChangeAUuid not in [uuids.refDataVersionedChangeStayAUuid, uuids.refDataVersionedChangeNewAUuid, uuids.refDataVersionedChangeAllAUuid] %}
                {{ pgettext("questions/01-how-data", "<p data-fact-id=\"dataset-versioning\" data-status=\"complete\">This reference dataset is versioned.</p>") }}
              {% endif %}
              {% if refDataVersionedWhich|trim %}
                <div class="dataset-version answer-detail" data-fact-id="dataset-version" data-status="complete">
                  <div class="answer-lead">{{ pgettext("questions/01-how-data", "<p><strong>Version</strong></p>") }}</div>
                  {{ answerMarkdown.markdown(refDataVersionedWhich) }}
                </div>
              {% else %}
                {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-fact-id=\"dataset-version\" data-status=\"missing\"><strong>Information not provided:</strong> which version of this dataset will be used.</p>") }}{% endif %}
              {% endif %}
              {% if refDataVersionedChangeAUuid == uuids.refDataVersionedChangeStayAUuid %}
                {{ pgettext("questions/01-how-data", "<p>If a new version becomes available during the project, the current version will continue to be used.</p>") }}
              {% elif refDataVersionedChangeAUuid == uuids.refDataVersionedChangeNewAUuid %}
                {{ pgettext("questions/01-how-data", "<p>If a new version becomes available during the project, it will be used for new analyses.</p>") }}
              {% elif refDataVersionedChangeAUuid == uuids.refDataVersionedChangeAllAUuid %}
                {{ pgettext("questions/01-how-data", "<p>If a new version becomes available during the project, all analyses will be repeated using it.</p>") }}
              {% else %}
                {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-fact-id=\"dataset-version-policy\" data-status=\"missing\"><strong>Information not provided:</strong> how new dataset versions will be handled.</p>") }}{% endif %}
              {% endif %}
            {%- elif refDataVersionedAUuid == uuids.refDataVersionedNoAUuid -%}
              {{ pgettext("questions/01-how-data", "<p data-fact-id=\"dataset-versioning\" data-status=\"explicit-no\">This reference dataset is not versioned.</p>") }}
            {%- endif -%}

            {% set referencePolicy %}
            {# availability of the standard reference data for future results reproduction #}
            {%- set refDataReproduce = [refDataUsedPrefix, uuids.refDataReproduceQUuid]|reply_path -%}
            {%- set refDataReproduceReply = repliesMap[refDataReproduce]|reply_str_value -%}
            <div class="dataset-policy">
            <p>
            {%- if refDataReproduceReply == uuids.refDataReproduceProviderAUuid -%}
              {% if sharedReferencePolicy %}{{ pgettext("questions/01-how-data", "Each dataset will remain available from its provider in the long term.") }}{% else %}{{ pgettext("questions/01-how-data", "The provider will keep this dataset available in the long term.") }}{% endif %}
            {%- elif refDataReproduceReply == uuids.refDataReproduceCopyAUuid  -%}
              {% if sharedReferencePolicy %}{{ pgettext("questions/01-how-data", "We will retain a copy of each dataset and provide these copies alongside the research results.") }}{% else %}{{ pgettext("questions/01-how-data", "We will retain a copy of this dataset and provide it alongside the research results.") }}{% endif %}
            {%- elif refDataReproduceReply == uuids.refDataReproduceBothAUuid -%}
              {% if sharedReferencePolicy %}{{ pgettext("questions/01-how-data", "Each dataset will remain available from its provider in the long term. We will also retain a copy of each dataset and provide these copies alongside the research results.") }}{% else %}{{ pgettext("questions/01-how-data", "The provider will keep this dataset available in the long term. We will also retain a copy and provide it alongside the research results.") }}{% endif %}
            {%- endif -%}
            </p>

            {# licence #}
            {%- set refDataConditions = [refDataUsedPrefix, uuids.refDataConditionsQUuid]|reply_path -%}
            {%- set refDataConditionsReply = repliesMap[refDataConditions]|reply_str_value -%}
            {%- set refDataConditionsOther = [refDataConditions, uuids.refDataConditionsOtherAUuid, uuids.refDataConditionsOtherQUuid]|reply_path -%}
            {%- set refDataConditionsOtherReply = repliesMap[refDataConditionsOther]|reply_str_value -%}
            {%- if refDataConditionsReply %}
              {%- if refDataConditionsReply == uuids.refDataConditionsCC0AUuid -%}
                <p>{% if sharedReferencePolicy %}{{ pgettext("questions/01-how-data", "These datasets are freely available for any use.") }}{% else %}{{ pgettext("questions/01-how-data", "This dataset is freely available for any use.") }}{% endif %}</p>
              {%- elif refDataConditionsReply == uuids.refDataConditionsCCBYAUuid -%}
                <p>{% if sharedReferencePolicy %}{{ pgettext("questions/01-how-data", "These datasets are freely available with an obligation to cite their sources.") }}{% else %}{{ pgettext("questions/01-how-data", "This dataset is freely available with an obligation to cite the source.") }}{% endif %}</p>
              {%- elif refDataConditionsReply == uuids.refDataConditionsOtherAUuid -%}
                  {%- if refDataConditionsOtherReply|trim -%}
                    <div class="answer-detail">{{ pgettext("questions/01-how-data", "<p><strong>Conditions of use</strong></p>") }}{{ answerMarkdown.markdown(refDataConditionsOtherReply) }}</div>
                  {%- else -%}
                    {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-status=\"missing-output\">Restrictions apply, but the conditions of use are not yet described.</p>") }}{% else %}{{ pgettext("questions/01-how-data", "<p data-fact-id=\"reuse-restrictions\" data-status=\"partial\">Restrictions apply to this dataset.</p>") }}{% endif %}
                  {%- endif -%}
              {%- endif -%}
            {%- endif -%}

            {# format #}
            {%- set refDataFormat = [refDataUsedPrefix, uuids.refDataFormatQUuid]|reply_path -%}
            {%- set refDataFormatReply = repliesMap[refDataFormat]|reply_str_value -%}
            <p>
            {%- if refDataFormatReply == uuids.refDataFormatConvertAUuid -%}
              {{ pgettext("questions/01-how-data", "The data format must be converted before use.") }}
            {%- elif refDataFormatReply == uuids.refDataFormatUseAUuid -%}
              {{ pgettext("questions/01-how-data", "The data can be used directly without format conversion.") }}
            {% endif %}
            </p>
            </div>

          {# Reference data set that will NOT be used #}
            {% endset %}
            {% if sharedReferencePolicy %}
              {% set referencePolicies.content = referencePolicy %}
            {% else %}
              {{ referencePolicy }}
            {% endif %}
            </div>
          {%- elif refDataUseReply == uuids.refDataUseNoAUuid -%}
            {%- set refDataUsedNoPrefix = [refDataUse, uuids.refDataUseNoAUuid, uuids.refDataUseNoWhyQUuid]|reply_path -%}
            {%- set refDataUseNoReply = repliesMap[refDataUsedNoPrefix]|reply_str_value -%}
            {%- set refDataUseNoOtherReason = [refDataUsedNoPrefix, uuids.refDataUseNoReasonAUuid ,uuids.refDataUseNoReasonQUuid]|reply_path -%}
            {%- set refDataUseNoOtherReasonReply = repliesMap[refDataUseNoOtherReason]|reply_str_value %}
          
            {{ nonreuse.render(refDataWhere, refDataUseNoReply, refDataUseNoOtherReasonReply,
                uuids.refDataUseNoDataAUuid, uuids.refDataUseNoAspectAUuid, uuids.refDataUseNoQualityAUuid,
                uuids.refDataUseNoCondAUuid, uuids.refDataUseNoReasonAUuid) }}
          {% else %}
            {{ nonreuse.undecided(refDataWhere) }}
          {%- endif -%}
        </li>
      {%- endfor -%}
      </ul>

      {# Non-reference Data #}
      {% if sharedReferencePolicy %}
        <div class="shared-reference-policy">
          {{ pgettext("questions/01-how-data", "<p class=\"answer-lead\"><strong>Shared arrangements</strong></p>") }}
          <div class="answer-lead"><p>{{ pgettext("questions/01-how-data", "The following arrangements apply to all reference datasets selected for re-use above.") }}</p></div>
          {{ referencePolicies.content }}
        </div>
      {% endif %}
      <ul>
      {%- for nrefDataItem in nrefDataItems -%}
      <li data-item-id="{{ nrefDataItem }}">
        {%- set nrefDataPrefix = [nrefDataPath, nrefDataItem]|reply_path  -%}
        {%- set nrefDataUse = [nrefDataPrefix, uuids.nrefDataUseQUuid]|reply_path -%}
        {%- set nrefDataUseReply = repliesMap[nrefDataUse]|reply_str_value -%}
        {%- set nrefDataUsedPrefix = [nrefDataUse, uuids.nrefDataUseYesAUuid]|reply_path -%}
        {%- set nrefDataNameReply = repliesMap[[nrefDataPrefix, uuids.nrefDataNameQUuid]|reply_path]|reply_str_value-%}
        {%- set nrefDataWhere = repliesMap[[nrefDataPrefix, uuids.nrefDataWhereQUuid]|reply_path]|reply_str_value -%}

        {%- if nrefDataNameReply|trim -%}
          <h5>{{ nrefDataNameReply }}</h5>
        {%- else -%}
          {% if output_profile|default('review') == 'submission' %}<strong class="item-label">{{ macros.datasetLabel(macros.DATASET_NON_REFERENCE, nrefDataItems.index(nrefDataItem) + 1) }}</strong>{% else %}{{ pgettext("questions/01-how-data", "<strong class=\"item-label\">(no name given)</strong>") }}{% endif %}
        {%- endif -%}
        
        {# Non-reference data set will be used #}
        {%- if nrefDataUseReply == uuids.nrefDataUseYesAUuid %}
          {{ reuseRightsholder.render(nrefDataUsedPrefix.split('.') + [uuids.nrefDataOwnerQUuid]) }}
          {# identification #}
          {{ pgettext("questions/01-how-data", "<p data-fact-id=\"reuse-decision\" data-status=\"complete\">This dataset will be re-used.</p>") }}
          {% if nrefDataWhere|trim %}
            {% if nrefDataWhere.startswith("https://") or nrefDataWhere.startswith("http://") or nrefDataWhere.startswith("ftp://") %}
              {{ pgettext("questions/01-how-data", "<p data-fact-id=\"dataset-source\" data-status=\"complete\">Source: <a href=\"%(nrefDataWhere)s\">%(nrefDataWhere)s</a></p>", nrefDataWhere=nrefDataWhere) }}
            {% else %}
              {{ pgettext("questions/01-how-data", "<p data-fact-id=\"dataset-source\" data-status=\"complete\">Source: %(nrefDataWhere)s</p>", nrefDataWhere=nrefDataWhere) }}
            {% endif %}
          {% else %}
            {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-fact-id=\"dataset-source\" data-status=\"missing\"><strong>Information not provided:</strong> where this dataset can be obtained.</p>") }}{% endif %}
          {% endif %}
          {%- set nrefDataUsageQ = [nrefDataUsedPrefix, uuids.nrefDataUsageQUuid]|reply_path -%}
          {%- set nrefDataUsageReply = repliesMap[nrefDataUsageQ]|reply_str_value -%}
          {% if nrefDataUsageReply|trim %}
            <div class="answer-detail" data-fact-id="reuse-purpose" data-status="complete">
              {{ pgettext("questions/01-how-data", "<p><strong>Purpose of re-use</strong></p>") }}
              {{ answerMarkdown.markdown(nrefDataUsageReply) }}
            </div>
          {% else %}
            {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-fact-id=\"reuse-purpose\" data-status=\"missing\"><strong>Information not provided:</strong> the purpose for which this dataset will be re-used.</p>") }}{% endif %}
          {% endif %}

          {{ reuseRightsholder.nonReferenceArrangements(nrefDataUsedPrefix.split('.')) }}
          {% include 'src/reuse-summary.html.j2' with context %}

          {# Personal Data #}
          {%- set nrefDataPersonalParts = nrefDataUsedPrefix.split('.') + [uuids.nrefDataPersonalQUuid] -%}
          {%- set nrefDataPersonal = activeAnswer.path(nrefDataPersonalParts, 'OptionsQuestion') if km is defined else nrefDataPersonalParts|reply_path -%}
          {%- set nrefDataPersonalReply = repliesMap[nrefDataPersonal]|reply_str_value if nrefDataPersonal else '' -%}
          {%- if nrefDataPersonal in repliesMap and repliesMap[nrefDataPersonal].value is defined and repliesMap[nrefDataPersonal].value.type is defined and repliesMap[nrefDataPersonal].value.type != 'AnswerReply' -%}
            {%- set nrefDataPersonalReply = '' -%}
          {%- endif -%}
          {%- if km is defined and nrefDataPersonal and (nrefDataPersonalReply not in km.entities.questions[uuids.nrefDataPersonalQUuid].answerUuids or nrefDataPersonalReply not in km.entities.answers) -%}
            {%- set nrefDataPersonalReply = '' -%}
          {%- endif -%}
          {%- if nrefDataPersonalReply == uuids.nrefDataPersonalYesAUuid %}
          {%- set nrefDataPersonalLegalBasis = [nrefDataPersonal, uuids.nrefDataPersonalYesAUuid, uuids.nrefDataPersonalLegalBasisQUuid]|reply_path -%}
          {%- set nrefDataPersonalLegalBasisReply = repliesMap[nrefDataPersonalLegalBasis]|reply_str_value -%}
          {# Each selected fact is a complete sentence, including partial replies. #}
          <p>{{ pgettext("questions/01-how-data", "This dataset contains personal data.") }}
            {% if nrefDataPersonalLegalBasisReply == uuids.nrefDataPersonalLegalBasisPubInterestAUuid %}
              {{ pgettext("questions/01-how-data", "The stated legal basis for processing these data under the GDPR is public interest.") }}
            {% elif nrefDataPersonalLegalBasisReply == uuids.nrefDataPersonalLegalBasisConsentAUuid %}
              {{ pgettext("questions/01-how-data", "The stated legal basis for processing these data under the GDPR is consent from the data subjects.") }}
              {% set nrefDataPersonalLegalBasisReuse = [nrefDataPersonalLegalBasis, uuids.nrefDataPersonalLegalBasisConsentAUuid, uuids.nrefDataPersonalLegalBasisConsentReuseQUuid]|reply_path %}
              {% set nrefDataPersonalLegalBasisReuseReply = repliesMap[nrefDataPersonalLegalBasisReuse]|reply_str_value %}
              {% if nrefDataPersonalLegalBasisReuseReply == uuids.nrefDataPersonalLegalBasisConsentReuseYesAUuid %}
                {{ pgettext("questions/01-how-data", "The consent also covers our reuse.") }}
              {% elif nrefDataPersonalLegalBasisReuseReply == uuids.nrefDataPersonalLegalBasisConsentReuseNoAUuid %}
                {{ pgettext("questions/01-how-data", "The consent does not cover our reuse; new consent will be needed.") }}
              {% endif %}
            {% elif nrefDataPersonalLegalBasisReply == uuids.nrefDataPersonalLebalBasisOtherAUuid %}
              {% set nrefDataPersonalLegalBasisOther = [nrefDataPersonalLegalBasis, uuids.nrefDataPersonalLebalBasisOtherAUuid, uuids.nrefDataPersonalLegalBasisOtherQUuid]|reply_path %}
              {% set nrefDataPersonalLegalBasisOtherReply = repliesMap[nrefDataPersonalLegalBasisOther]|reply_str_value %}
              {% if nrefDataPersonalLegalBasisOtherReply == uuids.nrefDataPersonalLegalBasisOtherLegalAUuid %}
                {{ pgettext("questions/01-how-data", "The stated legal basis for processing these data is a legal obligation.") }}
              {% elif nrefDataPersonalLegalBasisOtherReply == uuids.nrefDataPersonalLegalBasisOtherVitalAUuid %}
                {{ pgettext("questions/01-how-data", "The stated legal basis for processing these data is the protection of vital interests of the data subjects.") }}
              {% elif nrefDataPersonalLegalBasisOtherReply == uuids.nrefDataPersonalLegalBasisOtherLegitAUuid %}
                {{ pgettext("questions/01-how-data", "The stated legal basis for processing these data is legitimate interests.") }}
              {% elif nrefDataPersonalLegalBasisOtherReply == uuids.nrefDataPersonalLegalBasisOtherContractAUuid %}
                {{ pgettext("questions/01-how-data", "The stated legal basis for processing these data is performance of a contract with the data subjects.") }}
              {% endif %}
            {% endif %}
          </p>
          {%- elif nrefDataPersonalReply == uuids.nrefDataPersonalNoAUuid -%}
            {{ pgettext("questions/01-how-data", "<p data-fact-id=\"reuse-personal-data\" data-status=\"explicit-no\">This dataset does not contain personal data.</p>") }}
          {%- endif -%}

          {# Ethical Approval for Reuse #}
          {%- set nrefDataEthicalApproval = [nrefDataUsedPrefix, uuids.nrefDataEthicalApprovalQUuid]|reply_path -%}
          {%- set nrefDataEthicalApprovalReply = repliesMap[nrefDataEthicalApproval]|reply_str_value -%}
          {%- if nrefDataEthicalApprovalReply == uuids.nrefDataEthicalApprovalCoversAUuid -%}
            {{ pgettext("questions/01-how-data", "<p>The existing ethical approval under research ethics laws covers our re-use of this dataset.</p>") }}
          {%- elif nrefDataEthicalApprovalReply == uuids.nrefDataEthicalApprovalExtensionAUuid -%}
            {{ pgettext("questions/01-how-data", "<p>The existing ethical approval under research ethics laws will need to be extended to cover our re-use of this dataset.</p>") }}
          {%- elif nrefDataEthicalApprovalReply == uuids.nrefDataEthicalApprovalNewAUuid -%}
            {{ pgettext("questions/01-how-data", "<p>New ethical approval under research ethics laws will be needed for our re-use of this dataset.</p>") }}
          {%- endif -%}

        {# Non-reference data set that will NOT be used #}
        {%- elif nrefDataUseReply == uuids.nrefDataUseNoAUuid -%}
          {%- set nrefDataUsedNoPrefix = [nrefDataUse, uuids.nrefDataUseNoAUuid, uuids.nrefDataUseNoWhyQUuid]|reply_path -%}
          {%- set nrefDataUseNoReply = repliesMap[nrefDataUsedNoPrefix]|reply_str_value -%}
          {%- set nrefDataUseNoOtherReason = [nrefDataUsedNoPrefix, uuids.nrefDataUseNoReasonAUuid ,uuids.nrefDataUseNoReasonQUuid]|reply_path -%}
          {%- set nrefDataUseNoOtherReasonReply = repliesMap[nrefDataUseNoOtherReason]|reply_str_value %}
          
          {{ nonreuse.render(nrefDataWhere, nrefDataUseNoReply, nrefDataUseNoOtherReasonReply,
              uuids.nrefDataUseNoDataAUuid, uuids.nrefDataUseNoAspectAUuid, uuids.nrefDataUseNoQualityAUuid,
              uuids.nrefDataUseNoCondAUuid, uuids.nrefDataUseNoReasonAUuid) }}
        {% else %}
          {{ nonreuse.undecided(nrefDataWhere) }}
        {%- endif -%}
      </li>
      {%- endfor -%}
      </ul>
      </div>
    {%- else -%}
      {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-requirement-id=\"SE-1a\" data-fact-id=\"reuse-sources\" data-status=\"missing\"><strong>Information not provided:</strong> the existing datasets considered for re-use, including any sources that were considered but discarded.</p>") }}{% endif %}
    {%- endif -%}

    {# Constrains - Data Harmonization #}
    {%- set dataHarmoParts = [uuids.reusingCUuid, uuids.preexistingQUuid, uuids.preexistingYesAUuid, uuids.dataHarmoQUuid] -%}
    {%- set dataHarmo = activeAnswer.path(dataHarmoParts, 'OptionsQuestion') if km is defined else dataHarmoParts|reply_path -%}
    {%- set dataHarmoReply = repliesMap[dataHarmo]|reply_str_value if dataHarmo else '' -%}
    {%- if km is defined and dataHarmo and (dataHarmoReply not in km.entities.questions[uuids.dataHarmoQUuid].answerUuids or dataHarmoReply not in km.entities.answers) -%}
      {%- set dataHarmoReply = '' -%}
    {%- endif -%}
    {%- if dataHarmoReply == uuids.dataHarmoYesAUuid -%}
      {%- set dataHarmonAvailable = [dataHarmo, uuids.dataHarmoYesAUuid, uuids.dataHarmoOthersQUuid]|reply_path  -%}
      {%- set dataHarmonAvailableReply = repliesMap[dataHarmonAvailable]|reply_str_value -%}
      <p>
      {%- if dataHarmonAvailableReply == uuids.dataHarmoOthersYesAUuid -%}
        {{ pgettext("questions/01-how-data", "Before reuse, we need to harmonize existing data from different sources and will make the results available to others.") }}
      {%- elif dataHarmonAvailableReply == uuids.dataHarmoOthersNoAUuid -%}
        {{ pgettext("questions/01-how-data", "Before reuse, we need to harmonize existing data from different sources but will not make the results available to others.") }}
      {%- else -%}
        {{ pgettext("questions/01-how-data", "Before reuse, we need to harmonize existing data from different sources.") }}
      {%- endif -%}
      </p>
    {%- elif dataHarmoReply == uuids.dataHarmoNoAUuid -%}
      <p>{{ pgettext("questions/01-how-data", "We do not need to harmonize existing data from different sources before reuse.") }}</p>
    {%- endif -%}

    {# Constrains - (Re)made data computer readable #}
    {%- set dataCompReadParts = [uuids.reusingCUuid, uuids.preexistingQUuid, uuids.preexistingYesAUuid, uuids.dataCompReadQUuid] -%}
    {%- set dataCompRead = activeAnswer.path(dataCompReadParts, 'OptionsQuestion') if km is defined else dataCompReadParts|reply_path -%}
    {%- set dataCompReadReply = repliesMap[dataCompRead]|reply_str_value if dataCompRead else '' -%}
    {%- if km is defined and dataCompRead and (dataCompReadReply not in km.entities.questions[uuids.dataCompReadQUuid].answerUuids or dataCompReadReply not in km.entities.answers) -%}
      {%- set dataCompReadReply = '' -%}
    {%- endif -%}
    {%- if dataCompReadReply == uuids.dataCompReadYesAUuid -%}
      {%- set dataCompReadItself = [dataCompRead, uuids.dataCompReadYesAUuid, uuids.dataCompReadItselfQUuid]|reply_path -%}
      {%- set dataCompReadItselfReply = repliesMap[dataCompReadItself]|reply_str_value -%}
      {%- set dataCompReadOthersParts = [uuids.reusingCUuid, uuids.preexistingQUuid, uuids.preexistingYesAUuid, uuids.dataCompReadQUuid, uuids.dataCompReadYesAUuid, uuids.dataCompReadOthersQUuid] -%}
      {%- set dataCompReadOthers = activeAnswer.path(dataCompReadOthersParts, 'OptionsQuestion') if km is defined else dataCompReadOthersParts|reply_path -%}
      {%- set dataCompReadOthersReply = repliesMap[dataCompReadOthers]|reply_str_value if dataCompReadOthers else '' -%}
      {%- if km is defined and dataCompReadOthers and (dataCompReadOthersReply not in km.entities.questions[uuids.dataCompReadOthersQUuid].answerUuids or dataCompReadOthersReply not in km.entities.answers) -%}
        {%- set dataCompReadOthersReply = '' -%}
      {%- endif -%}
      <p>
      {%- if dataCompReadItselfReply == uuids.dataCompReadItselfYesAUuid -%}
        {{ pgettext("questions/01-how-data", "Before reuse, we will need to convert the data into a machine-readable form and will make this version available to others through a standard repository.") }}
      {%- elif dataCompReadItselfReply == uuids.dataCompReadItselfYesOtherAUuid -%}
        {{ pgettext("questions/01-how-data", "Before reuse, we will need to convert the data into a machine-readable form and will make this version available to others.") }}
      {%- elif dataCompReadItselfReply == uuids.dataCompReadItselfNoAUuid -%}
        {{ pgettext("questions/01-how-data", "Before reuse, we will need to convert the data into a machine-readable form but will not make this version available to others.") }}
      {%- else -%}
        {{ pgettext("questions/01-how-data", "Before reuse, we will need to convert the data into a machine-readable form.") }}
      {%- endif -%}
      {%- if dataCompReadOthersReply == uuids.dataCompReadOthersYesAUuid -%}
        {%- set dataCompReadWhichMetadataStandardPath = [dataCompReadOthers, uuids.dataCompReadOthersYesAUuid, uuids.dataCompReadOthersYesStandardsQUuid]|reply_path -%}
        {%- set dataCompReadMetadataStandardItems = repliesMap[dataCompReadWhichMetadataStandardPath]|reply_items -%}
        {%- set namedMetadataStandards = [] -%}
        {%- for dataCompReadMetadataStandardItem in dataCompReadMetadataStandardItems -%}
            {%- set dataCompReadMetadataStandardPrefix = [dataCompReadWhichMetadataStandardPath, dataCompReadMetadataStandardItem]|reply_path -%}
            {%- set dataCompReadMetadataStandard = [dataCompReadMetadataStandardPrefix, uuids.dataCompReadOthersYesStandardQUuid]|reply_path -%}
            {%- set dataCompReadMetadataStandardReply = repliesMap[dataCompReadMetadataStandard] -%}
            {%- set standardName = macros.integrationFairSharing(dataCompReadMetadataStandardReply) -%}
            {%- if standardName|striptags|trim -%}{%- do namedMetadataStandards.append(standardName) -%}{%- endif -%}
        {%- endfor -%}
        {%- if namedMetadataStandards -%}
          {{ pgettext("questions/01-how-data", " We will provide others with standardized, machine-readable metadata and we will use the following metadata standards: %(standards)s.", standards=namedMetadataStandards|join(pgettext("questions/01-how-data", ", "))) }}
        {%- else -%}
          {{ pgettext("questions/01-how-data", " We will provide others with standardized, machine-readable metadata.") }}
        {%- endif -%}
      {%- elif dataCompReadOthersReply == uuids.dataCompReadOthersNoAUuid -%}
        {{ pgettext("questions/01-how-data", " We will not provide others with standardized, machine-readable metadata.") }}
      {%- endif -%}
      </p>
    {%- elif dataCompReadReply == uuids.dataCompReadNoAUuid -%}
      <p>{{ pgettext("questions/01-how-data", "We will not use existing data that needs to be converted into a machine-readable form before reuse.") }}</p>
    {%- endif -%}
  {%- elif preexistingAUuid == uuids.preexistingNoAUuid -%}
    <p data-requirement-id="SE-1a" data-fact-id="reuse-sources" data-status="explicit-no">{{ pgettext("questions/01-how-data", "No existing datasets will be re-used.") }}</p>
  {%- else -%}
    {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-requirement-id=\"SE-1a\" data-fact-id=\"reuse-sources\" data-status=\"missing\"><strong>Information not provided:</strong> whether existing data will be re-used, including constraints or reasons for discarding candidate sources.</p>") }}{% endif %}
  {%- endif -%}

  {# Provenance (lab notebooks)#}
  {%- set metadataPath = [uuids.creatingCUuid, uuids.metadataQUuid]|reply_path -%}
    {%- set metadataAUuid = repliesMap[metadataPath]|reply_str_value -%}
    {%- if metadataAUuid == uuids.metadataExploreAUuid -%}
      {%- set provenancePath = [metadataPath, uuids.metadataExploreAUuid, uuids.provenanceQUuid]|reply_path -%}
      {%- set provenanceAUuid = repliesMap[provenancePath]|reply_str_value -%}
      {%- if provenanceAUuid %}
        {% set provenanceContent %}
        {%- if provenanceAUuid == uuids.provenanceLabNotebooksAUuid -%}
          <p data-requirement-id="SE-1a" data-fact-id="provenance" data-status="complete">{{ pgettext("questions/01-how-data", "We will use lab notebooks to document the provenance of the data analysis.") }}</p>
        {%- elif provenanceAUuid == uuids.provenanceELabNotebookAUuid -%}
          <p data-requirement-id="SE-1a" data-fact-id="provenance" data-status="complete">{{ pgettext("questions/01-how-data", "We will use an electronic lab notebook to document the provenance of the data analysis.") }}</p>
        {%- elif provenanceAUuid == uuids.provenanceSystemAUuid -%}
          <p data-requirement-id="SE-1a" data-fact-id="provenance" data-status="complete">{{ pgettext("questions/01-how-data", "Our computing workflow system records provenance information about the data analysis.") }}</p>
        {%- elif provenanceAUuid == uuids.provenanceOtherAUuid -%}
          {%- set provenanceOtherPath = [provenancePath, uuids.provenanceOtherAUuid, uuids.provenanceOtherQUuid]|reply_path -%}
          {%- set provenanceOther = repliesMap[provenanceOtherPath]|reply_str_value -%}
          {%- if provenanceOther|trim -%}
            <div class="answer-detail" data-requirement-id="SE-1a" data-fact-id="provenance" data-status="complete">
              {{ macros.provenanceReading(provenanceOther) }}
            </div>
          {%- else -%}
            {%- set activeProvenancePath = activeAnswer.path([uuids.creatingCUuid, uuids.metadataQUuid, uuids.metadataExploreAUuid, uuids.provenanceQUuid], 'OptionsQuestion') if km is defined else provenancePath -%}
            {%- if activeProvenancePath and (km is not defined or (provenanceAUuid in km.entities.questions[uuids.provenanceQUuid].answerUuids and provenanceAUuid in km.entities.answers)) and (repliesMap[provenancePath].value is not defined or repliesMap[provenancePath].value.type is not defined or repliesMap[provenancePath].value.type == 'AnswerReply') -%}
              <p data-requirement-id="SE-1a" data-fact-id="provenance" data-status="complete">{{ pgettext("questions/01-how-data", "We use other arrangements to document data provenance.") }}</p>
            {%- endif -%}
            {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-requirement-id=\"SE-1a\" data-fact-id=\"provenance-detail\" data-status=\"missing\"><strong>Information not provided:</strong> the other arrangement that will document data provenance.</p>") }}{% endif %}
          {%- endif -%}
        {%- endif -%}
        {% endset %}
        {% if output_profile|default('review') != 'submission' or provenanceContent|striptags|trim or '<img' in provenanceContent|lower or '<table' in provenanceContent|lower %}
          <h4>{{ pgettext("questions/01-how-data", "Provenance") }}</h4>
          {{ provenanceContent }}
        {% endif %}
      {%- else -%}
        {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-requirement-id=\"SE-1a\" data-fact-id=\"provenance\" data-status=\"missing\"><strong>Information not provided:</strong> how data provenance will be documented.</p>") }}{% endif %}
      {%- endif -%}
    {%- else -%}
      {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/01-how-data", "<p class=\"data-gap\" data-requirement-id=\"SE-1a\" data-fact-id=\"provenance\" data-status=\"missing\"><strong>Information not provided:</strong> how data provenance will be documented.</p>") }}{% endif %}
    {%- endif -%}
  </div>
</div>
