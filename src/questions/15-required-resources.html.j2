{% import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
<div id="q-required-resources" class="question" data-requirement-id="SE-6b">
  <h3>{{ pgettext("questions/15-required-resources", "15. What resources (for example financial and time) will be dedicated to data management and ensuring that data will be FAIR (Findable, Accessible, Interoperable, Re-usable)?") }}</h3>

  <div class="answer">
    {# additional expertise #}
    {%- set expertisePath = [uuids.adminDetailsCUuid, uuids.additionalExpertiseQUuid]|reply_path -%}
    {%- set expertiseAUuid = repliesMap[expertisePath]|reply_str_value -%}
    {%- if expertiseAUuid == uuids.additionalExpertiseNoAUuid -%}
      <p data-requirement-id="SE-6b" data-fact-id="specialist-expertise" data-status="explicit-no">{{ pgettext("questions/15-required-resources", "To execute the DMP, no additional specialist expertise is required.") }}</p>
    {%- elif expertiseAUuid == uuids.additionalExpertiseYesAvailableAUuid -%}
      <p data-requirement-id="SE-6b" data-fact-id="specialist-expertise" data-status="complete">{{ pgettext("questions/15-required-resources", "To execute the DMP, additional specialist expertise is required and we have such trained support staff available.") }}</p>
    {%- elif expertiseAUuid == uuids.additionalExpertiseYesTrainAUuid -%}
      {%- set expertiseTrainPath = [expertisePath, uuids.additionalExpertiseYesTrainAUuid, uuids.additionalExpertiseYesTrainTrainingQUuid]|reply_path -%}
      {%- set expertiseTrainText = repliesMap[expertiseTrainPath]|reply_str_value -%}
      <div class="answer-lead"><p data-requirement-id="SE-6b" data-fact-id="specialist-expertise" data-status="{{ 'complete' if expertiseTrainText|trim else 'partial' }}">{{ pgettext("questions/15-required-resources", "Additional specialist expertise is required. Existing staff will receive training.") }}</p></div>
      {% if expertiseTrainText|trim %}
        <div class="answer-detail" data-fact-id="specialist-expertise-detail" data-status="complete">
          {{ answerMarkdown.markdown(expertiseTrainText) }}
        </div>
      {% endif %}
      {%- if not expertiseTrainText|trim -%}
        {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-requirement-id=\"SE-6b\" data-fact-id=\"specialist-expertise-detail\" data-status=\"missing\"><strong>Information not provided:</strong> the training that existing staff will receive.</p>") }}{% endif %}
      {%- endif -%}
    {%- elif expertiseAUuid == uuids.additionalExpertiseYesHireAUuid -%}
      {%- set expertiseHirePath = [expertisePath, uuids.additionalExpertiseYesHireAUuid, uuids.additionalExpertiseYesHireExpertiseQUuid]|reply_path -%}
      {%- set expertiseHireText = repliesMap[expertiseHirePath]|reply_str_value -%}
      <p data-requirement-id="SE-6b" data-fact-id="specialist-expertise" data-status="{{ 'complete' if expertiseHireText|trim else 'partial' }}">{{ pgettext("questions/15-required-resources", "Additional specialist expertise is required. New staff will be recruited.") }}</p>
      {% if expertiseHireText|trim %}
        <div class="answer-detail" data-fact-id="specialist-expertise-detail" data-status="complete">
          {{ pgettext("questions/15-required-resources", "<p><strong>Expertise to recruit</strong></p>") }}
          {{ expertiseHireText|markdown }}
        </div>
      {% endif %}
      {%- if not expertiseHireText|trim -%}
        {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-requirement-id=\"SE-6b\" data-fact-id=\"specialist-expertise-detail\" data-status=\"missing\"><strong>Information not provided:</strong> the expertise for which new staff will be hired.</p>") }}{% endif %}
      {%- endif -%}
    {%- else -%}
      {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-requirement-id=\"SE-6b\" data-fact-id=\"specialist-expertise\" data-status=\"missing\"><strong>Information not provided:</strong> whether additional specialist expertise is required.</p>") }}{% endif %}
    {%- endif -%}
    {%- set resourceOverview = namespace(original='', explicitPair=false, joinGaps=false) -%}
    {%- set resourceOverview.original -%}
    {# additional hw/sw #}
    {%- set additionalHWSWPath = [uuids.adminDetailsCUuid, uuids.additionalHWSWQUuid]|reply_path -%}
    {%- set additionalHWSWAUuid = repliesMap[additionalHWSWPath]|reply_str_value -%}
    {%- if additionalHWSWAUuid == uuids.additionalHWSWNoAUuid -%}
      <p data-requirement-id="SE-6b" data-fact-id="hardware-software" data-status="explicit-no">{{ pgettext("questions/15-required-resources", "We do not require any hardware or software in addition to what is usually available in the institute.") }}</p>
    {%- elif additionalHWSWAUuid == uuids.additionalHWSWYesAUuid -%}
      {%- set additionalHWSWWhatPath = [additionalHWSWPath, uuids.additionalHWSWYesAUuid, uuids.additionalHWSWYesWhatQUuid]|reply_path -%}
      {%- set additionalHWSWWhat = repliesMap[additionalHWSWWhatPath]|reply_str_value -%}
      {%- if additionalHWSWWhat|trim -%}
        <div class="answer-detail" data-requirement-id="SE-6b" data-fact-id="hardware-software" data-status="complete">
          {{ pgettext("questions/15-required-resources", "<p><strong>Additional hardware or software required</strong></p>") }}
          {{ answerMarkdown.markdown(additionalHWSWWhat) }}
        </div>
      {%- else -%}
        <p data-requirement-id="SE-6b" data-fact-id="hardware-software" data-status="partial">{{ pgettext("questions/15-required-resources", "We require hardware or software in addition to what is usually available in the institute.") }}</p>
        {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-requirement-id=\"SE-6b\" data-fact-id=\"hardware-software-detail\" data-status=\"missing\"><strong>Information not provided:</strong> the additional hardware or software required.</p>") }}{% endif %}
      {%- endif -%}
    {%- else -%}
      {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-requirement-id=\"SE-6b\" data-fact-id=\"hardware-software\" data-status=\"missing\"><strong>Information not provided:</strong> whether additional hardware or software is required.</p>") }}{% endif %}
    {%- endif -%}
    {# charges #}
    {# Word may join the two fixed terminal prompts after a real authored answer.
       Keep the original paragraphs and fact markers in HTML; never mark free text. #}
    {%- set resourceOverview.joinGaps = word_budget_reading|default(false) and (expertiseTrainText|default('')|trim or expertiseHireText|default('')|trim or additionalHWSWWhat|default('')|trim) -%}
    {%- set repoChargesPath = [uuids.preservingCUuid, uuids.repoChargesQUuid]|reply_path -%}
    {%- set repoCharges = repliesMap[repoChargesPath]|reply_str_value -%}
    {%- if repoCharges == uuids.repoChargesNoAUuid %}
      <p>{{ pgettext("questions/15-required-resources", "No repository service charges are expected.") }}</p>
    {%- elif repoCharges == uuids.repoChargesYesAUuid %}
      <p>{{ pgettext("questions/15-required-resources", "The selected repositories charge for their services.") }}</p>
    {%- else %}
      {% if output_profile|default('review') != 'submission' %}{% if resourceOverview.joinGaps %}<div class="q15-terminal-gap" data-fact-id="repository-charges" data-status="missing">{% endif %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-fact-id=\"repository-charges\" data-status=\"missing\"><strong>Information not provided:</strong> whether repository service charges will be incurred.</p>") }}{% if resourceOverview.joinGaps %}</div>{% endif %}{% endif %}
    {%- endif %}
    {% set resourceOverview.explicitPair = additionalHWSWAUuid == uuids.additionalHWSWNoAUuid and repoCharges in [uuids.repoChargesNoAUuid, uuids.repoChargesYesAUuid] -%}
    {%- endset -%}
    {%- import 'src/resource-prose.html.j2' as resourceProse -%}
    {{- resourceProse.render(resourceOverview.original, resourceOverview.explicitPair) -}}
    {%- import 'src/active-answer.j2' as active with context -%}
    {# Other recurring fees are independent of repository charges and datasets. #}
    {%- set otherRecurringFeesParts = [uuids.preservingCUuid, uuids.otherRecurringFeesQUuid] -%}
    {%- set otherRecurringFeesPath = active.path(otherRecurringFeesParts, 'OptionsQuestion') if km is defined else otherRecurringFeesParts|reply_path -%}
    {%- set otherRecurringFeesAUuid = repliesMap[otherRecurringFeesPath]|reply_str_value if otherRecurringFeesPath else '' -%}
    {%- if km is defined and otherRecurringFeesPath and (otherRecurringFeesAUuid not in km.entities.questions[uuids.otherRecurringFeesQUuid].answerUuids or otherRecurringFeesAUuid not in km.entities.answers) -%}
      {%- set otherRecurringFeesAUuid = '' -%}
    {%- endif -%}
    {%- if otherRecurringFeesAUuid == uuids.otherRecurringFeesYesAUuid -%}
      <p data-requirement-id="SE-6b" data-fact-id="other-recurring-fees" data-status="complete">{{ pgettext("questions/15-required-resources", "There are other recurring fees for keeping data or documents available.") }}</p>
    {%- elif otherRecurringFeesAUuid == uuids.otherRecurringFeesNoAUuid -%}
      <p data-requirement-id="SE-6b" data-fact-id="other-recurring-fees" data-status="explicit-no">{{ pgettext("questions/15-required-resources", "There are no other recurring fees for keeping data or documents available.") }}</p>
    {%- endif -%}
    {# costs #}
    {%- set budgetProjectParts = [uuids.adminDetailsCUuid, uuids.projectsQUuid] -%}
    {%- set projectPath = active.path(budgetProjectParts, 'ListQuestion') -%}
    {%- set projectItems = repliesMap[projectPath]|reply_items if projectPath else [] -%}
    {%- if projectItems|length > 0 -%}
    {%- set visibleBudget = namespace(any=false) -%}{%- for budgetProject in projectItems -%}{%- if repliesMap[[projectPath, budgetProject, uuids.costQUuid]|reply_path]|reply_items -%}{%- set visibleBudget.any = true -%}{%- endif -%}{%- endfor -%}{% if output_profile|default('review') != 'submission' or visibleBudget.any %}<h4{% if word_budget_reading|default(false) %} class="word-budget-heading"{% endif %}>{{ pgettext("questions/15-required-resources", "Data-management budget") }}</h4>{% endif %}
        {%- for i in projectItems -%}
            {%- set projectItem = [projectPath, i]|reply_path -%}
            {%- set projectItemNameQUuid = active.path(budgetProjectParts + [i, uuids.projectNameQUuid], 'ValueQuestion') -%}
            {%- set projectItemNameReply = repliesMap[projectItemNameQUuid]|reply_str_value if projectItemNameQUuid else '' -%}

            {%- set projectItemNumberQUuid = active.path(budgetProjectParts + [i, uuids.projectNumberQUuid], 'ValueQuestion') -%}
            {%- set projectItemNumberReply = repliesMap[projectItemNumberQUuid]|reply_str_value if projectItemNumberQUuid else '' -%}
            {% if output_profile|default('review') != 'submission' or repliesMap[[projectItem, uuids.costQUuid]|reply_path]|reply_items %}<div class="project-resources" data-item-id="{{ projectItem }}">
                {% if projectItems|length > 1 %}{% if output_profile|default('review') == 'submission' and not projectItemNameReply|trim %}<p>{{ pgettext("questions/15-required-resources", "<strong>Project %(i)s%(projectItemNumberReply)s </strong>", i=projectItems.index(i) + 1, projectItemNumberReply=(" - " + projectItemNumberReply)|e if projectItemNumberReply|trim) }}</p>{% else %}<p><strong>{{ projectItemNameReply|e if projectItemNameReply|trim else "(no name given)" }}{{ (" - " + projectItemNumberReply)|e if projectItemNumberReply|trim}} </strong></p>{% endif %}{% endif %}

                {%- set projectCostPath = [projectItem, uuids.costQUuid]|reply_path -%}
                {%- set projectCostItems = repliesMap[projectCostPath]|reply_items -%}

                {%- if projectCostItems|length > 0  -%}
                    {%- set budgetLayout = namespace(header='', rows=[], metadataHeader='', fundingLabel='') -%}
                    {%- set originalBudgetTable -%}
                    <table class="resource-table">
                      <colgroup><col class="resource-purpose"><col class="resource-budget"><col class="resource-funding"></colgroup>
                      <thead>{% set budgetLayout.header %}<tr>{% set budgetLayout.metadataHeader %}<th scope="col">{{ pgettext("questions/15-required-resources", "Resource and purpose") }}</th><th scope="col">{{ pgettext("questions/15-required-resources", "Budget") }}</th>{% endset %}{{ budgetLayout.metadataHeader }}<th scope="col">{% set budgetLayout.fundingLabel %}{{ pgettext("questions/15-required-resources", "Funding source") }}{% endset %}{{ budgetLayout.fundingLabel }}</th></tr>{% endset %}{{ budgetLayout.header }}</thead>
                      <tbody>
                    {%- for j in projectCostItems -%}
                        {%- set projectCostItem = [projectCostPath, j]|reply_path -%}
                        {%- set projectCostItemTitleQUuid = [projectCostItem, uuids.costTitleQUuid]|reply_path -%}
                        {%- set projectCostItemTitleReply = repliesMap[projectCostItemTitleQUuid]|reply_str_value -%}
                        {%- set budgetRow = namespace(id=projectCostItem, title='', purpose='', budget='', funding='', original='') -%}
                        {%- set budgetRow.original -%}
                        <tr data-item-id="{{ projectCostItem }}"><td>
                        {% set budgetRow.title %}<p><strong>{% if output_profile|default('review') == 'submission' and not projectCostItemTitleReply|trim %}{{ macros.resourceLabel(projectCostItems.index(j) + 1) }}{% else %}{{ projectCostItemTitleReply if projectCostItemTitleReply|trim else "(no resource name given)" }}{% endif %}</strong></p>{% endset %}{{ budgetRow.title }}
                        {%- set budgetRow.purpose -%}
                        
                        {%- set projectCostItemDescriptionQUuid = [projectCostItem, uuids.costDescriptionQUuid]|reply_path -%}
                        {%- set projectCostItemDescriptionReply = repliesMap[projectCostItemDescriptionQUuid]|reply_str_value  -%}
                        
                        {%- if projectCostItemDescriptionReply|trim -%}
                          <div class="answer-detail" data-fact-id="resource-justification" data-status="complete">{{ answerMarkdown.markdown(projectCostItemDescriptionReply) }}</div>
                        {%- else -%}
                          {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-requirement-id=\"SE-6b\" data-fact-id=\"resource-justification\" data-status=\"missing\"><strong>Information not provided:</strong> why this resource is needed to deliver FAIR data.</p>") }}{% endif %}
                        {%- endif -%}

                        {%- set projectCostItemCurrencyQUuid = [projectCostItem, uuids.costCurrencyQUuid]|reply_path  -%}
                        {%- set projectCostItemCurrencyReply = repliesMap[projectCostItemCurrencyQUuid] -%}
                        {%- set hasCurrency = macros.integrationCurrency(projectCostItemCurrencyReply)|striptags|trim != '' -%}


                        {%- set projectCostItemAmountQUuid = [projectCostItem, uuids.costAmountQUuid]|reply_path   -%}
                        {%- set projectCostItemAmountReply = repliesMap[projectCostItemAmountQUuid]|reply_str_value -%}

                        {%- set budgetRow.budget -%}
                        {%- if projectCostItemAmountReply|trim and hasCurrency -%}
                            <p>{{projectCostItemAmountReply}} {{macros.integrationCurrency(projectCostItemCurrencyReply) }}</p>
                        {%- else -%}
                            {% if projectCostItemAmountReply|trim %}
                              <p data-fact-id="resource-amount-value" data-status="complete">{{ projectCostItemAmountReply }}</p>
                            {% endif %}
                            {% if hasCurrency %}
                              <p data-fact-id="resource-currency" data-status="complete">Currency: {{ macros.integrationCurrency(projectCostItemCurrencyReply) }}.</p>
                            {% endif %}
                            {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-amount" data-status="missing"><strong>Information not provided:</strong> {% if projectCostItemAmountReply|trim %}currency.{% elif hasCurrency %}budgeted amount.{% else %}budgeted amount and currency.{% endif %}</p>{% endif %}
                        {%- endif -%}
                        {%- endset -%}

                        {%- set projectCostItemAllocationQUuid = [projectCostItem, uuids.costAllocationQUuid]|reply_path  -%}
                        {%- set projectCostItemAllocationItems = repliesMap[projectCostItemAllocationQUuid]|reply_items -%}

                        
                          {%- set projectCostItemAllocations = [] -%}
                          {%- if uuids.costAllocationFindabilityAUuid in projectCostItemAllocationItems -%}
                          {%- do projectCostItemAllocations.append(gettext("findability")) -%}
                          {%- endif -%}
                          {%- if uuids.costAllocationAccessibilityAUuid in projectCostItemAllocationItems -%}
                          {%- do projectCostItemAllocations.append(gettext("accessibility")) -%}
                          {%- endif -%}
                          {%- if uuids.costAllocationInteroperabilityAUuid in projectCostItemAllocationItems -%}
                          {%- do projectCostItemAllocations.append(gettext("interoperability")) -%}
                          {%- endif -%}
                          {%- if uuids.costAllocationReusabilityAUuid in projectCostItemAllocationItems -%}
                          {%- do projectCostItemAllocations.append(gettext("reusability")) -%}
                          {%- endif -%}
                          {%- if uuids.costManagementAUuid in projectCostItemAllocationItems -%}
                          {%- do projectCostItemAllocations.append(gettext("management")) -%}
                          {%- endif -%}
                        
                        {%- if projectCostItemAllocations|length > 0 -%}
                          <p>
                            {%- if projectCostItemAllocations|length > 2 -%}
                              {{ gettext("This resource supports %(activities)s, and %(last_activity)s of data.", activities=projectCostItemAllocations[0:-1]|join(gettext(", ")), last_activity=projectCostItemAllocations[-1]) }}
                            {%- elif projectCostItemAllocations|length == 2 -%}
                              {{ gettext("This resource supports %(first_activity)s and %(second_activity)s of data.", first_activity=projectCostItemAllocations[0], second_activity=projectCostItemAllocations[1]) }}
                            {%- else -%}
                              {{ gettext("This resource supports %(activity)s of data.", activity=projectCostItemAllocations[0]) }}
                            {%- endif %}
                          </p>
                        {%- else -%}
                          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-allocation" data-status="missing">{{ gettext("<strong>Information not provided:</strong> which FAIR or data-management activities this resource supports.") }}</p>{% endif %}
                        {%- endif -%}
                       
 
                        {% endset %}{{ budgetRow.purpose }}</td><td>{{ budgetRow.budget }}</td><td>
                        {%- set budgetRow.funding -%}
                        {%- set projectCostItemCoverParts = budgetProjectParts + [i, uuids.costQUuid, j, uuids.costCoverQUuid] -%}
                        {%- set projectCostItemCoverQUuid = active.path(projectCostItemCoverParts, 'OptionsQuestion') -%}
                        {%- set projectCostItemCoverReply = repliesMap[projectCostItemCoverQUuid]|reply_str_value if projectCostItemCoverQUuid else '' -%}
                        {%- if projectCostItemCoverQUuid and (projectCostItemCoverReply not in km.entities.questions[uuids.costCoverQUuid].answerUuids or projectCostItemCoverReply not in km.entities.answers) -%}
                          {%- set projectCostItemCoverReply = '' -%}
                        {%- endif -%}

                        {%- if projectCostItemCoverReply == uuids.costCoverGrantAUuid -%}
                          {%- set costCoverGrantIdQUuid = [projectCostItemCoverQUuid, uuids.costCoverGrantAUuid, uuids.costCoverGrantIdQUuid]|reply_path -%}
                          {%- set costCoverGrantIdReply = repliesMap[costCoverGrantIdQUuid]|reply_str_value -%}
                          {{ pgettext("questions/15-required-resources", "<p data-fact-id=\"cost-coverage\" data-status=\"complete\">This cost will be covered by a funding grant.</p>") }}
                          {% if costCoverGrantIdReply|trim %}
                            {{ pgettext("questions/15-required-resources", "<p>Grant number: %(costCoverGrantIdReply)s.</p>", costCoverGrantIdReply=costCoverGrantIdReply) }}
                          {% else %}
                            {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-fact-id=\"grant-number\" data-status=\"missing\"><strong>Information not provided:</strong> the grant number.</p>") }}{% endif %}
                          {% endif %}
                        {%- elif projectCostItemCoverReply == uuids.costCoverOtherAUuid -%}
                          {%- set costCoverOtherHowQUuid = active.path(projectCostItemCoverParts + [uuids.costCoverOtherAUuid, uuids.costCoverOtherHowQUuid], 'ValueQuestion') -%}
                          {%- set costCoverOtherHowReply = repliesMap[costCoverOtherHowQUuid]|reply_str_value if costCoverOtherHowQUuid else '' -%}
                          {%- if costCoverOtherHowReply|trim -%}
                            <div class="answer-detail">{{ answerMarkdown.markdown(costCoverOtherHowReply) }}</div>
                          {%- else -%}
                            {{ pgettext("questions/15-required-resources", "<p>Other funding arrangements are planned.</p>") }}
                            {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-requirement-id=\"SE-6b\" data-fact-id=\"cost-coverage\" data-status=\"missing\"><strong>Information not provided:</strong> how this cost will be covered.</p>") }}{% endif %}
                          {%- endif -%}
                        {%- else -%}
                          {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-requirement-id=\"SE-6b\" data-fact-id=\"cost-coverage\" data-status=\"missing\"><strong>Information not provided:</strong> how this cost will be covered.</p>") }}{% endif %}
                        {%- endif -%}


                        {% endset %}{{ budgetRow.funding }}</td></tr>
                        {%- endset -%}{{ budgetRow.original }}
                        {%- do budgetLayout.rows.append(budgetRow) -%}
                    {%- endfor -%}
                      </tbody>
                    </table>
                    {%- endset -%}
                    {%- if pdf_budget_reading|default(false) -%}
                      {%- import 'src/budget-reading.html.j2' as budgetReading -%}
                      {{ budgetReading.render(originalBudgetTable, budgetLayout.header, budgetLayout.rows, budgetLayout.metadataHeader, budgetLayout.fundingLabel) }}
                    {%- elif word_budget_reading|default(false) -%}
                      {%- import 'src/budget-reading.html.j2' as budgetReading -%}
                      {{ budgetReading.word_table(originalBudgetTable, budgetLayout.header, budgetLayout.rows, budgetLayout.metadataHeader, budgetLayout.fundingLabel) }}
                    {%- else -%}{{ originalBudgetTable }}{%- endif -%}
                {%- else -%}
                    {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-requirement-id=\"SE-6b\" data-fact-id=\"resources-costing\" data-status=\"missing\"><strong>Information not provided:</strong> resources such as staff time, storage, deposit preparation, and repository charges budgeted for this project.</p>") }}{% endif %}
                {%- endif -%}

            </div>{% endif %}

        {%- endfor -%}
    {%- else -%}
      {% if output_profile|default('review') != 'submission' %}{% if resourceOverview.joinGaps %}<div class="q15-terminal-gap" data-fact-id="resources-costing" data-status="missing">{% endif %}{{ pgettext("questions/15-required-resources", "<p class=\"data-gap\" data-requirement-id=\"SE-6b\" data-fact-id=\"resources-costing\" data-status=\"missing\"><strong>Information not provided:</strong> the financial and time resources budgeted for data management and FAIR data.</p>") }}{% if resourceOverview.joinGaps %}</div>{% endif %}{% endif %}
    {%- endif -%}
  </div>
</div>
