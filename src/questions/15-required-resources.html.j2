<div id="q-required-resources" class="question" data-requirement-id="SE-6b">
  <h3>15. What resources (for example financial and time) will be dedicated to data management and ensuring that data will be FAIR (Findable, Accessible, Interoperable, Re-usable)?</h3>

  <div class="answer">
    {# additional expertise #}
    {%- set expertisePath = [uuids.adminDetailsCUuid, uuids.additionalExpertiseQUuid]|reply_path -%}
    {%- set expertiseAUuid = repliesMap[expertisePath]|reply_str_value -%}
    {%- if expertiseAUuid == uuids.additionalExpertiseNoAUuid -%}
      <p data-requirement-id="SE-6b" data-fact-id="specialist-expertise" data-status="explicit-no">To execute the DMP, no additional specialist expertise is required.</p>
    {%- elif expertiseAUuid == uuids.additionalExpertiseYesAvailableAUuid -%}
      <p data-requirement-id="SE-6b" data-fact-id="specialist-expertise" data-status="complete">To execute the DMP, additional specialist expertise is required and we have such trained support staff available.</p>
    {%- elif expertiseAUuid == uuids.additionalExpertiseYesTrainAUuid -%}
      {%- set expertiseTrainPath = [expertisePath, uuids.additionalExpertiseYesTrainAUuid, uuids.additionalExpertiseYesTrainTrainingQUuid]|reply_path -%}
      {%- set expertiseTrainText = repliesMap[expertiseTrainPath]|reply_str_value -%}
      <div class="answer-lead"><p data-requirement-id="SE-6b" data-fact-id="specialist-expertise" data-status="{{ 'complete' if expertiseTrainText else 'partial' }}">Additional specialist expertise is required. Existing staff will receive training.</p></div>
      {% if expertiseTrainText %}
        <div class="answer-detail" data-fact-id="specialist-expertise-detail" data-status="complete">
          {{ expertiseTrainText|markdown }}
        </div>
      {% endif %}
      {%- if not expertiseTrainText -%}
        {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="specialist-expertise-detail" data-status="missing"><strong>Information not provided:</strong> the training that existing staff will receive.</p>{% endif %}
      {%- endif -%}
    {%- elif expertiseAUuid == uuids.additionalExpertiseYesHireAUuid -%}
      {%- set expertiseHirePath = [expertisePath, uuids.additionalExpertiseYesHireAUuid, uuids.additionalExpertiseYesHireExpertiseQUuid]|reply_path -%}
      {%- set expertiseHireText = repliesMap[expertiseHirePath]|reply_str_value -%}
      <p data-requirement-id="SE-6b" data-fact-id="specialist-expertise" data-status="{{ 'complete' if expertiseHireText else 'partial' }}">Additional specialist expertise is required. New staff will be recruited.</p>
      {% if expertiseHireText %}
        <div class="answer-detail" data-fact-id="specialist-expertise-detail" data-status="complete">
          <p><strong>Expertise to recruit</strong></p>
          {{ expertiseHireText|markdown }}
        </div>
      {% endif %}
      {%- if not expertiseHireText -%}
        {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="specialist-expertise-detail" data-status="missing"><strong>Information not provided:</strong> the expertise for which new staff will be hired.</p>{% endif %}
      {%- endif -%}
    {%- else -%}
      {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="specialist-expertise" data-status="missing"><strong>Information not provided:</strong> whether additional specialist expertise is required.</p>{% endif %}
    {%- endif -%}
    {%- set resourceOverview = namespace(original='', explicitPair=false) -%}
    {%- set resourceOverview.original -%}
    {# additional hw/sw #}
    {%- set additionalHWSWPath = [uuids.adminDetailsCUuid, uuids.additionalHWSWQUuid]|reply_path -%}
    {%- set additionalHWSWAUuid = repliesMap[additionalHWSWPath]|reply_str_value -%}
    {%- if additionalHWSWAUuid == uuids.additionalHWSWNoAUuid -%}
      <p data-requirement-id="SE-6b" data-fact-id="hardware-software" data-status="explicit-no">We do not require any hardware or software in addition to what is usually available in the institute.</p>
    {%- elif additionalHWSWAUuid == uuids.additionalHWSWYesAUuid -%}
      {%- set additionalHWSWWhatPath = [additionalHWSWPath, uuids.additionalHWSWYesAUuid, uuids.additionalHWSWYesWhatQUuid]|reply_path -%}
      {%- set additionalHWSWWhat = repliesMap[additionalHWSWWhatPath]|reply_str_value -%}
      {%- if additionalHWSWWhat -%}
        <div class="answer-detail" data-requirement-id="SE-6b" data-fact-id="hardware-software" data-status="complete">
          <p><strong>Additional hardware or software required</strong></p>
          {{ additionalHWSWWhat|markdown }}
        </div>
      {%- else -%}
        <p data-requirement-id="SE-6b" data-fact-id="hardware-software" data-status="partial">We require hardware or software in addition to what is usually available in the institute.</p>
        {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="hardware-software-detail" data-status="missing"><strong>Information not provided:</strong> the additional hardware or software required.</p>{% endif %}
      {%- endif -%}
    {%- else -%}
      {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="hardware-software" data-status="missing"><strong>Information not provided:</strong> whether additional hardware or software is required.</p>{% endif %}
    {%- endif -%}
    {# charges #}
    {%- set repoChargesPath = [uuids.preservingCUuid, uuids.repoChargesQUuid]|reply_path -%}
    {%- set repoCharges = repliesMap[repoChargesPath]|reply_str_value -%}
    {%- if repoCharges == uuids.repoChargesNoAUuid %}
      <p>No repository service charges are expected.</p>
    {%- elif repoCharges == uuids.repoChargesYesAUuid %}
      <p>The selected repositories charge for their services.</p>
    {%- else %}
      {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="repository-charges" data-status="missing"><strong>Information not provided:</strong> whether repository service charges will be incurred.</p>{% endif %}
    {%- endif %}
    {% set resourceOverview.explicitPair = additionalHWSWAUuid == uuids.additionalHWSWNoAUuid and repoCharges in [uuids.repoChargesNoAUuid, uuids.repoChargesYesAUuid] -%}
    {%- endset -%}
    {%- import 'src/resource-prose.html.j2' as resourceProse -%}
    {{- resourceProse.render(resourceOverview.original, resourceOverview.explicitPair) -}}
    {# costs #}
    {%- set projectPath = [uuids.adminDetailsCUuid, uuids.projectsQUuid]|reply_path -%}
    {%- set projectItems = repliesMap[projectPath]|reply_items -%}
    {%- if projectItems|length > 0 -%}
    {%- set visibleBudget = namespace(any=false) -%}{%- for budgetProject in projectItems -%}{%- if repliesMap[[projectPath, budgetProject, uuids.costQUuid]|reply_path]|reply_items -%}{%- set visibleBudget.any = true -%}{%- endif -%}{%- endfor -%}{% if output_profile|default('review') != 'submission' or visibleBudget.any %}<h4>Data-management budget</h4>{% endif %}
        {%- for i in projectItems -%}
            {%- set projectItem = [projectPath, i]|reply_path -%}
            {%- set projectItemNameQUuid = [projectItem, uuids.projectNameQUuid]|reply_path -%}
            {%- set projectItemNameReply = repliesMap[projectItemNameQUuid]|reply_str_value -%}

            {%- set projectItemNumberQUuid = [projectItem, uuids.projectNumberQUuid]|reply_path -%}
            {%- set projectItemNumberReply = repliesMap[projectItemNumberQUuid]|reply_str_value -%}
            {% if output_profile|default('review') != 'submission' or repliesMap[[projectItem, uuids.costQUuid]|reply_path]|reply_items %}<div class="project-resources" data-item-id="{{ projectItem }}">
                {% if projectItems|length > 1 %}{% if output_profile|default('review') == 'submission' and not projectItemNameReply %}<p><strong>Project {{ projectItems.index(i) + 1 }}{{ " - " + projectItemNumberReply if projectItemNumberReply}} </strong></p>{% else %}<p><strong>{{ projectItemNameReply if projectItemNameReply else "(no name given)" }}{{ " - " + projectItemNumberReply if projectItemNumberReply}} </strong></p>{% endif %}{% endif %}

                {%- set projectCostPath = [projectItem, uuids.costQUuid]|reply_path -%}
                {%- set projectCostItems = repliesMap[projectCostPath]|reply_items -%}

                {%- if projectCostItems|length > 0  -%}
                    {%- set budgetLayout = namespace(header='', rows=[]) -%}
                    {%- set originalBudgetTable -%}
                    <table class="resource-table">
                      <colgroup><col class="resource-purpose"><col class="resource-budget"><col class="resource-funding"></colgroup>
                      <thead>{% set budgetLayout.header %}<tr><th scope="col">Resource and purpose</th><th scope="col">Budget</th><th scope="col">Funding source</th></tr>{% endset %}{{ budgetLayout.header }}</thead>
                      <tbody>
                    {%- for j in projectCostItems -%}
                        {%- set projectCostItem = [projectCostPath, j]|reply_path -%}
                        {%- set projectCostItemTitleQUuid = [projectCostItem, uuids.costTitleQUuid]|reply_path -%}
                        {%- set projectCostItemTitleReply = repliesMap[projectCostItemTitleQUuid]|reply_str_value -%}
                        {%- set budgetRow = namespace(id=projectCostItem, title='', purpose='', budget='', funding='', original='') -%}
                        {%- set budgetRow.original -%}
                        <tr data-item-id="{{ projectCostItem }}"><td>
                        {% set budgetRow.title %}<p><strong>{% if output_profile|default('review') == 'submission' and not projectCostItemTitleReply %}{{ macros.resourceLabel(projectCostItems.index(j) + 1) }}{% else %}{{ projectCostItemTitleReply if projectCostItemTitleReply else "(no resource name given)" }}{% endif %}</strong></p>{% endset %}{{ budgetRow.title }}
                        {%- set budgetRow.purpose -%}
                        
                        {%- set projectCostItemDescriptionQUuid = [projectCostItem, uuids.costDescriptionQUuid]|reply_path -%}
                        {%- set projectCostItemDescriptionReply = repliesMap[projectCostItemDescriptionQUuid]|reply_str_value  -%}
                        
                        {%- if projectCostItemDescriptionReply -%}
                          <div class="answer-detail" data-fact-id="resource-justification" data-status="complete">{{ projectCostItemDescriptionReply|markdown }}</div>
                        {%- else -%}
                          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-justification" data-status="missing"><strong>Information not provided:</strong> why this resource is needed to deliver FAIR data.</p>{% endif %}
                        {%- endif -%}

                        {%- set projectCostItemCurrencyQUuid = [projectCostItem, uuids.costCurrencyQUuid]|reply_path  -%}
                        {%- set projectCostItemCurrencyReply = repliesMap[projectCostItemCurrencyQUuid] -%}


                        {%- set projectCostItemAmountQUuid = [projectCostItem, uuids.costAmountQUuid]|reply_path   -%}
                        {%- set projectCostItemAmountReply = repliesMap[projectCostItemAmountQUuid]|reply_str_value -%}

                        {%- set budgetRow.budget -%}
                        {%- if  projectCostItemAmountReply and projectCostItemCurrencyReply -%}
                            <p>{{projectCostItemAmountReply}} {{macros.integrationCurrency(projectCostItemCurrencyReply) }}</p>
                        {%- else -%}
                            {% if projectCostItemAmountReply %}
                              <p data-fact-id="resource-amount-value" data-status="complete">{{ projectCostItemAmountReply }}</p>
                            {% endif %}
                            {% if projectCostItemCurrencyReply %}
                              <p data-fact-id="resource-currency" data-status="complete">Currency: {{ macros.integrationCurrency(projectCostItemCurrencyReply) }}.</p>
                            {% endif %}
                            {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-amount" data-status="missing"><strong>Information not provided:</strong> {% if projectCostItemAmountReply %}currency.{% elif projectCostItemCurrencyReply %}budgeted amount.{% else %}budgeted amount and currency.{% endif %}</p>{% endif %}
                        {%- endif -%}
                        {%- endset -%}

                        {%- set projectCostItemAllocationQUuid = [projectCostItem, uuids.costAllocationQUuid]|reply_path  -%}
                        {%- set projectCostItemAllocationItems = repliesMap[projectCostItemAllocationQUuid]|reply_items -%}

                        
                          {%- set projectCostItemAllocations = [] -%}
                          {%- if uuids.costAllocationFindabilityAUuid in projectCostItemAllocationItems -%}
                          {%- do projectCostItemAllocations.append("findability") -%}
                          {%- endif -%}
                          {%- if uuids.costAllocationAccessibilityAUuid in projectCostItemAllocationItems -%}
                          {%- do projectCostItemAllocations.append("accessibility") -%}
                          {%- endif -%}
                          {%- if uuids.costAllocationInteroperabilityAUuid in projectCostItemAllocationItems -%}
                          {%- do projectCostItemAllocations.append("interoperability") -%}
                          {%- endif -%}
                          {%- if uuids.costAllocationReusabilityAUuid in projectCostItemAllocationItems -%}
                          {%- do projectCostItemAllocations.append("reusability") -%}
                          {%- endif -%}
                          {%- if uuids.costManagementAUuid in projectCostItemAllocationItems -%}
                          {%- do projectCostItemAllocations.append("management") -%}
                          {%- endif -%}
                        
                        {%- if projectCostItemAllocations|length > 0 -%}
                          <p>
                            This resource supports{{+" "}}
                            {%- if projectCostItemAllocations|length > 2 -%}
                              {{ projectCostItemAllocations[0:-1]|join(", ") }}, and {{ projectCostItemAllocations[-1] }} of data.
                            {%- elif projectCostItemAllocations|length == 2 -%}
                              {{ projectCostItemAllocations[0] }} and {{ projectCostItemAllocations[1] }} of data.
                            {%- else -%}
                              {{ projectCostItemAllocations[0] }} of data.
                            {%- endif %}
                          </p>
                        {%- else -%}
                          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resource-allocation" data-status="missing"><strong>Information not provided:</strong> which FAIR or data-management activities this resource supports.</p>{% endif %}
                        {%- endif -%}
                       
 
                        {% endset %}{{ budgetRow.purpose }}</td><td>{{ budgetRow.budget }}</td><td>
                        {%- set budgetRow.funding -%}
                        {%- set projectCostItemCoverQUuid = [projectCostItem, uuids.costCoverQUuid]|reply_path  -%}
                        {%- set projectCostItemCoverReply = repliesMap[projectCostItemCoverQUuid]|reply_str_value -%}

                        {%- if projectCostItemCoverReply == uuids.costCoverGrantAUuid -%}
                          {%- set costCoverGrantIdQUuid = [projectCostItemCoverQUuid, uuids.costCoverGrantAUuid, uuids.costCoverGrantIdQUuid]|reply_path -%}
                          {%- set costCoverGrantIdReply = repliesMap[costCoverGrantIdQUuid]|reply_str_value -%}
                          <p data-fact-id="cost-coverage" data-status="complete">This cost will be covered by a funding grant.</p>
                          {% if costCoverGrantIdReply %}
                            <p>Grant number: {{ costCoverGrantIdReply }}.</p>
                          {% else %}
                            {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="grant-number" data-status="missing"><strong>Information not provided:</strong> the grant number.</p>{% endif %}
                          {% endif %}
                        {%- elif projectCostItemCoverReply == uuids.costCoverOtherAUuid -%}
                          {%- set costCoverOtherHowQUuid = [projectCostItemCoverQUuid,uuids.costCoverOtherAUuid, uuids.costCoverOtherHowQUuid]|reply_path  -%}
                          {%- set costCoverOtherHowReply = repliesMap[costCoverOtherHowQUuid]|reply_str_value -%}
                          {%- if costCoverOtherHowReply -%}
                            <div class="answer-detail">{{costCoverOtherHowReply|markdown}}</div>
                          {%- else -%}
                            {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="cost-coverage" data-status="missing"><strong>Information not provided:</strong> how this cost will be covered.</p>{% endif %}
                          {%- endif -%}
                        {%- else -%}
                          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="cost-coverage" data-status="missing"><strong>Information not provided:</strong> how this cost will be covered.</p>{% endif %}
                        {%- endif -%}


                        {% endset %}{{ budgetRow.funding }}</td></tr>
                        {%- endset -%}{{ budgetRow.original }}
                        {%- do budgetLayout.rows.append(budgetRow) -%}
                    {%- endfor -%}
                      </tbody>
                    </table>
                    {%- endset -%}
                    {%- if pdf_budget_reading|default(false) -%}
                      {%- import 'src/budget-reading.html.j2' as budgetReading -%}
                      {{ budgetReading.render(originalBudgetTable, budgetLayout.header, budgetLayout.rows) }}
                    {%- elif word_budget_reading|default(false) -%}
                      {%- import 'src/budget-reading.html.j2' as budgetReading -%}
                      {{ budgetReading.short_table(originalBudgetTable, budgetLayout.rows, true) }}
                    {%- else -%}{{ originalBudgetTable }}{%- endif -%}
                {%- else -%}
                    {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resources-costing" data-status="missing"><strong>Information not provided:</strong> resources such as staff time, storage, deposit preparation, and repository charges budgeted for this project.</p>{% endif %}
                {%- endif -%}

            </div>{% endif %}

        {%- endfor -%}
    {%- else -%}
      {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-6b" data-fact-id="resources-costing" data-status="missing"><strong>Information not provided:</strong> the financial and time resources budgeted for data management and FAIR data.</p>{% endif %}
    {%- endif -%}
  </div>
</div>
