{% import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
<div id="q-persistent-identifier" class="question">
    <h3>{{ pgettext("questions/13-persistent-identifier", "13. How will you ensure that each dataset is assigned a unique and persistent identifier?") }}</h3>
    <div class="question-guidance"><p>{{ pgettext("questions/13-persistent-identifier", "A Digital Object Identifier, or DOI, is one example.") }}</p></div>

    <div class="answer">
    {# identifiers #}
    {%- set producedDataPath = [uuids.preservingCUuid, uuids.producedDataQUuid]|reply_path -%}
    {%- set producedDataItems = repliesMap[producedDataPath]|reply_items -%}
    {%- if producedDataItems|length > 0 -%}
        {%- for i in producedDataItems -%}
            {%- set pathPrefix = [producedDataPath, i]|reply_path -%}
            {%- set producedDataName = repliesMap[[pathPrefix, uuids.producedDataNameQUuid]|reply_path]|reply_str_value -%}
            {# If will be published #}
            {%- set isPublishedDataPath = [pathPrefix, uuids.isPublishedDataQUuid]|reply_path -%}
            {%- set isPublishedDataAUuid = repliesMap[isPublishedDataPath]|reply_str_value -%}
            {%- set publishedDistrosPath = [isPublishedDataPath, uuids.isPublishedDataYesAUuid, uuids.publishedDistrosQUuid]|reply_path -%}
            {%- set publishedDistrosItems = repliesMap[publishedDistrosPath]|reply_items -%}
            {%- set identifierDistroItems = [] -%}
            {%- if isPublishedDataAUuid == uuids.isPublishedDataYesAUuid -%}
                {%- for j in publishedDistrosItems -%}
                    {%- set identifierPath = [publishedDistrosPath, j, uuids.publishedDataIdentifierQUuid]|reply_path -%}
                    {%- set identifierAnswer = repliesMap[identifierPath]|reply_str_value -%}
                    {%- if identifierAnswer in [uuids.publishedDataIdentifierYesAUuid, uuids.publishedDataIdentifierNoAUuid] -%}
                        {%- do identifierDistroItems.append(j) -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
            {%- set showIdentifierDataset = output_profile|default('review') != 'submission' or isPublishedDataAUuid == uuids.isPublishedDataNoAUuid or identifierDistroItems|length > 0 -%}
            {% if showIdentifierDataset %}
            <div class="dataset-section" data-item-id="{{ i }}">
                <h5>{% if output_profile|default('review') == 'submission' and not producedDataName|trim %}{{ macros.datasetLabel(macros.DATASET_PRODUCED, producedDataItems.index(i) + 1) }}{% else %}{{ producedDataName|e if producedDataName|trim else pgettext("questions/13-persistent-identifier", "(no name given)") }}{% endif %}</h5>
            {% if isPublishedDataAUuid == uuids.isPublishedDataYesAUuid %}
                {# Where the data will be distributed #}
                    {%- if publishedDistrosItems|length > 0  -%}
                        {%- for j in publishedDistrosItems -%}
                            {%- set publishedDistrosItem = [publishedDistrosPath, j]|reply_path -%}
                            {%- set publishedDataIdentifierQUuid = [publishedDistrosItem, uuids.publishedDataIdentifierQUuid]|reply_path -%}
                            {%- set publishedDataIdentifierAUuid = repliesMap[publishedDataIdentifierQUuid]|reply_str_value -%}

                            {%- set repositoryKindQUuid = [publishedDistrosItem, uuids.publishedDataRepositoryKindQUuid]|reply_path -%}
                            {%- set repositoryKindAUuid = repliesMap[repositoryKindQUuid]|reply_str_value -%}
                            {%- set repositoryKindKnown = repositoryKindAUuid in [uuids.publishedDataRepositoryDomainSpecificAUuid, uuids.publishedDataRepositoryGeneralPurposeAUuid, uuids.publishedDataRepositoryNationalAUuid, uuids.publishedDataRepositoryInstitutionalAUuid, uuids.publishedDataRepositorySpecialAUuid] -%}
                            {% if output_profile|default('review') != 'submission' or publishedDataIdentifierAUuid in [uuids.publishedDataIdentifierYesAUuid, uuids.publishedDataIdentifierNoAUuid] %}
                            <div class="distribution-section" data-item-id="{{ j }}">
                            {% if publishedDistrosItems|length > 1 or repositoryKindKnown %}
                            <div class="identifier-heading">
                            {% if publishedDistrosItems|length > 1 %}<p class="answer-lead">{{ pgettext("questions/13-persistent-identifier", "<strong>Distribution %(loop_index)s</strong>", loop_index=loop.index) }}</p>{% endif %}
                            {% if repositoryKindKnown %}
                            <p class="answer-lead">
                            {%- if repositoryKindAUuid == uuids.publishedDataRepositoryDomainSpecificAUuid -%}
                                {{ pgettext("questions/13-persistent-identifier", "Domain-specific repository") }}
                            {%- elif repositoryKindAUuid == uuids.publishedDataRepositoryGeneralPurposeAUuid -%}
                                {{ pgettext("questions/13-persistent-identifier", "General-purpose repository") }}
                            {%- elif repositoryKindAUuid == uuids.publishedDataRepositoryNationalAUuid -%}
                               {{ pgettext("questions/13-persistent-identifier", "National repository") }}
                            {%- elif repositoryKindAUuid == uuids.publishedDataRepositoryInstitutionalAUuid -%}
                                {{ pgettext("questions/13-persistent-identifier", "Institutional repository") }}
                            {%- elif repositoryKindAUuid == uuids.publishedDataRepositorySpecialAUuid -%}
                                {{ pgettext("questions/13-persistent-identifier", "Special-purpose repository") }}
                            {%- endif -%}
                            </p>
                            {% endif %}
                            </div>
                            {% endif %}

                            {# Will this data be assigned persistent identifier? #}
                            {%- if publishedDataIdentifierAUuid == uuids.publishedDataIdentifierYesAUuid -%}
                            {# Only bounded, fixed template prose: keep child notices with their policy. #}
                            <div class="identifier-followup-unit short-reading-unit">
                            <div class="identifier-arrangement dataset-policy">
                                {# Who assigns #}
                                {%- set publishedDataIdentifierAssignsQUuid = [publishedDataIdentifierQUuid, uuids.publishedDataIdentifierYesAUuid, uuids.publishedDataIdentifierAssignsQUuid]|reply_path -%}
                                {%- set publishedDataIdentifierAssignsAUuid = repliesMap[publishedDataIdentifierAssignsQUuid]|reply_str_value -%}
                                {%- set publishedDataIdentifierResolvableQUuid = [publishedDataIdentifierQUuid, uuids.publishedDataIdentifierYesAUuid, uuids.publishedDataIdentifierResolvableQUuid]|reply_path -%}
                                {%- set publishedDataIdentifierResolvableAUuid = repliesMap[publishedDataIdentifierResolvableQUuid]|reply_str_value -%}
                                {%- set repositoryHandlesBoth = publishedDataIdentifierAssignsAUuid == uuids.publishedDataIdentifierAssignsRepositoryAUuid and publishedDataIdentifierResolvableAUuid in [uuids.publishedDataIdentifierResolvableYesAUuid, uuids.publishedDataIdentifierResolvableNoAUuid] -%}

                                {# A known assigner sentence already states that identifiers will be
                                   assigned. Keep both facts, without repeating that assertion.
                                   Missing/unsupported assigners must retain the known parent answer. #}
                                {%- if repositoryHandlesBoth -%}
                                    {# One complete, translatable compound sentence carries both
                                       facts. A negative guarantee is NOT a failed resolution. #}
                                    <p data-fact-id="persistent-identifier" data-status="complete"><span data-requirement-id="SE-5d" data-fact-id="identifier-assigner" data-status="complete">{% include 'src/identifier-repository.html.j2' with context %}</span></p>
                                {%- elif publishedDataIdentifierAssignsAUuid == uuids.publishedDataIdentifierAssignsProjectDataStewardAUuid -%}
                                    {{ pgettext("questions/13-persistent-identifier", "<p data-fact-id=\"persistent-identifier\" data-status=\"complete\"><span data-requirement-id=\"SE-5d\" data-fact-id=\"identifier-assigner\" data-status=\"complete\">A project data steward or principal investigator will assign the persistent identifier.</span></p>") }}

                                {%- elif publishedDataIdentifierAssignsAUuid == uuids.publishedDataIdentifierAssignsInstitDataStewardAUuid -%}
                                    {{ pgettext("questions/13-persistent-identifier", "<p data-fact-id=\"persistent-identifier\" data-status=\"complete\"><span data-requirement-id=\"SE-5d\" data-fact-id=\"identifier-assigner\" data-status=\"complete\">An institutional data steward will assign the persistent identifier.</span></p>") }}

                                {%- elif publishedDataIdentifierAssignsAUuid == uuids.publishedDataIdentifierAssignsRepositoryAUuid -%}
                                    {{ pgettext("questions/13-persistent-identifier", "<p data-fact-id=\"persistent-identifier\" data-status=\"complete\"><span data-requirement-id=\"SE-5d\" data-fact-id=\"identifier-assigner\" data-status=\"complete\">The repository will assign the persistent identifier.</span></p>") }}
                                {%- else -%}
                                    <p data-fact-id="persistent-identifier" data-status="complete">{{ pgettext("questions/13-persistent-identifier", "Persistent identifiers will be assigned.") }}</p>
                                {%- endif -%}

                                {# Resolvable #}
                                {%- if not repositoryHandlesBoth and publishedDataIdentifierResolvableAUuid == uuids.publishedDataIdentifierResolvableYesAUuid -%}
                                    <p data-requirement-id="SE-5d" data-fact-id="identifier-resolution" data-status="complete">{{ pgettext("questions/13-persistent-identifier", "The repository will make sure the persistent identifier can be resolved to a digital object.") }}</p>

                                {%- elif not repositoryHandlesBoth and publishedDataIdentifierResolvableAUuid == uuids.publishedDataIdentifierResolvableNoAUuid -%}
                                    <p data-requirement-id="SE-5d" data-fact-id="identifier-resolution" data-status="explicit-no">{{ pgettext("questions/13-persistent-identifier", "The repository will not make sure the persistent identifier can be resolved to a digital object.") }}</p>
                                {%- endif -%}

                                {# The old identifier-specification question is absent from KM 2.7.0. #}
                            </div>
                            {# Missing/unsupported follow-ups are distinct from the supplied policy.
                               Capture each translatable label before joining, as in Q2. #}
                            {% set identifierMissing = [] %}{% set identifierReview = [] %}
                            {% if publishedDataIdentifierAssignsAUuid not in [uuids.publishedDataIdentifierAssignsProjectDataStewardAUuid, uuids.publishedDataIdentifierAssignsInstitDataStewardAUuid, uuids.publishedDataIdentifierAssignsRepositoryAUuid] %}
                              {% set fieldGap %}<span data-requirement-id="SE-5d" data-fact-id="identifier-assigner" data-status="{{ 'needs-review' if publishedDataIdentifierAssignsAUuid|trim else 'missing' }}">{{ pgettext("questions/13-persistent-identifier", "who will assign the persistent identifier") }}</span>{% endset %}
                              {% if publishedDataIdentifierAssignsAUuid|trim %}{% do identifierReview.append(fieldGap) %}{% else %}{% do identifierMissing.append(fieldGap) %}{% endif %}
                            {% endif %}
                            {% if publishedDataIdentifierResolvableAUuid not in [uuids.publishedDataIdentifierResolvableYesAUuid, uuids.publishedDataIdentifierResolvableNoAUuid] %}
                              {% set fieldGap %}<span data-requirement-id="SE-5d" data-fact-id="identifier-resolution" data-status="{{ 'needs-review' if publishedDataIdentifierResolvableAUuid|trim else 'missing' }}">{{ pgettext("questions/13-persistent-identifier", "whether the repository guarantees resolution of the persistent identifier to a digital object") }}</span>{% endset %}
                              {% if publishedDataIdentifierResolvableAUuid|trim %}{% do identifierReview.append(fieldGap) %}{% else %}{% do identifierMissing.append(fieldGap) %}{% endif %}
                            {% endif %}
                            {% if identifierMissing or identifierReview %}
                              <div class="identifier-followups reading-gap">
                                {% if identifierMissing %}{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-5d">{{ pgettext("questions/13-persistent-identifier", "Information still needed: %(fields)s.", fields=identifierMissing|join(gettext(", "))) }}</p>{% endif %}{% endif %}
                                {% if identifierReview %}{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-5d">{{ pgettext("questions/13-persistent-identifier", "This template cannot interpret the selected answers for: %(fields)s.", fields=identifierReview|join(gettext(", "))) }}</p>{% endif %}{% endif %}
                              </div>
                            {% endif %}
                            </div>
                            {%- elif publishedDataIdentifierAUuid == uuids.publishedDataIdentifierNoAUuid -%}
                              <p>{{ pgettext("questions/13-persistent-identifier", "Within this repository, unique and persistent identifiers will not be applied.") }}</p>
                            {%- else -%}
                              {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-status="missing-output">{{ pgettext("questions/13-persistent-identifier", "The persistent identifier arrangement is not yet described.") }}</p>{% endif %}
                            {%- endif -%}
                            </div>
                            {% endif %}
                        {%- endfor -%}
                    {% else %}
                        {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="identifier-distributions" data-status="missing">{{ pgettext("questions/13-persistent-identifier", "The publication locations have not been listed.") }}</p>{% endif %}
                    {%- endif -%}
            {% elif isPublishedDataAUuid == uuids.isPublishedDataNoAUuid %}
                <p>{{ pgettext("questions/13-persistent-identifier", "This dataset will not be published.") }}</p>
            {% else %}
                {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="publication-decision" data-status="missing">{{ pgettext("questions/13-persistent-identifier", "It has not yet been specified whether this dataset will be published.") }}</p>{% endif %}
            {%- endif -%}
            </div>
            {% endif %}
        {%- endfor -%}
    {%- else -%}
      {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-5d" data-status="missing-output">{{ pgettext("questions/13-persistent-identifier", "This document does not yet describe which datasets will receive persistent identifiers or how they will be assigned.") }}</p>{% endif %}
    {%- endif -%}

    {# Keep the optional re-use summary compact, with authored uses in their own
       blocks. The follow-up asks HOW others could use the data, not WHY. #}
    {% import 'src/active-answer.j2' as activeAnswer with context %}
    {%- set reuseParts = [uuids.creatingCUuid, uuids.measuredQUuid, uuids.measuredYesAUuid, uuids.measuredDataQUuid] -%}
    {%- set dataMeasuredPath = activeAnswer.path(reuseParts, 'ListQuestion') -%}
    {%- set dataMeasuredItems = repliesMap[dataMeasuredPath]|reply_items if dataMeasuredPath else [] -%}
    {% set reuseItems %}
        {%- for k in dataMeasuredItems -%}
            {%- set measuredDataNameQUuid = activeAnswer.path(reuseParts + [k, uuids.measuredDataNameQUuid], 'ValueQuestion') -%}
            {%- set measuredDataNameReply = repliesMap[measuredDataNameQUuid]|reply_str_value -%}
            {%- set measuredDataReuseQUuid = activeAnswer.path(reuseParts + [k, uuids.measuredDataReuseQUuid], 'OptionsQuestion') -%}
            {%- set measuredDataReuseAUuid = repliesMap[measuredDataReuseQUuid]|reply_str_value -%}
            {%- set reuseSummary -%}
              {%- if measuredDataReuseQUuid and measuredDataReuseAUuid in km.entities.questions[uuids.measuredDataReuseQUuid].answerUuids and measuredDataReuseAUuid in km.entities.answers -%}
                {%- if measuredDataReuseAUuid == uuids.measuredDataReuseUsAUuid -%}
                  {{ pgettext("questions/13-persistent-identifier", "Only we will be interested in re-using this data.") }}
                {%- elif measuredDataReuseAUuid == uuids.measuredDataReuseSameFieldAUuid -%}
                  {{ pgettext("questions/13-persistent-identifier", "Other researchers in this field will be interested in re-using this data.") }}
                {%- elif measuredDataReuseAUuid == uuids.measuredDataReuseOtherFieldAUuid -%}
                  {{ pgettext("questions/13-persistent-identifier", "Researchers working in other fields will be interested in re-using this data.") }}
                {%- endif -%}
              {%- endif -%}
            {%- endset -%}
            {%- set reuseHowPath = activeAnswer.path(reuseParts + [k, uuids.measuredDataReuseQUuid, uuids.measuredDataReuseOtherFieldAUuid, uuids.measuredDataReuseOtherFieldHowQUuid], 'ValueQuestion') -%}
            {%- set reuseHow = repliesMap[reuseHowPath]|reply_str_value -%}
            {% if output_profile|default('review') != 'submission' or measuredDataNameReply|trim or reuseSummary or reuseHow|trim %}
              <li data-item-id="{{ k }}">
                {# Keep a short summary with its use label, not an entire authored answer. #}
                {% set keepReuseLead = reuseHow|trim and measuredDataNameReply|length <= 80 %}
                {% if keepReuseLead %}<div class="answer-lead">{% endif %}
                <p class="reuse-summary"><strong>{% if output_profile|default('review') == 'submission' and not measuredDataNameReply|trim %}{{ macros.datasetLabel(macros.DATASET_INSTRUMENT, dataMeasuredItems.index(k) + 1) }}{% else %}{{ measuredDataNameReply|e if measuredDataNameReply|trim else pgettext("questions/13-persistent-identifier", "(no name given)") }}{% endif %}</strong>{% if reuseSummary %} — <span data-fact-id="measured-data-reuse" data-status="complete">{{ reuseSummary }}</span>{% endif %}</p>
                {% if keepReuseLead %}</div>{% endif %}
                {% if reuseHow|trim %}
                  <div class="answer-lead"><p>{{ pgettext("questions/13-persistent-identifier", "Potential uses in other fields:") }}</p></div>
                  <div class="answer-detail" data-fact-id="measured-data-reuse-uses" data-status="complete">{{ answerMarkdown.markdown(reuseHow) }}</div>
                {% endif %}
              </li>
            {% endif %}
        {%- endfor -%}
    {% endset %}
    {% if reuseItems|trim %}
      <div class="measured-data-reuse">
        <h4>{{ pgettext("questions/13-persistent-identifier", "Possible re-use of created data in other contexts") }}</h4>
        <ul>{{ reuseItems }}</ul>
      </div>
    {% endif %}
    </div>
</div>
