{% import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
<div id="q-copyright-ipr" class="question">
  <h3>{{ pgettext("questions/08-copyright-ipr", "8. How will other legal issues, such as intellectual property rights and ownership, be managed? What legislation is applicable?") }}
</h3>

  <div class="answer">
    {%- import 'src/active-answer.j2' as activeAnswer with context -%}
    {% set legalContent %}
    {# Open philosophy #}
    {%- set asOpenAsPossibleParts = [uuids.accessCUuid, uuids.asOpenAsPossibleQUuid] -%}
    {%- set asOpenAsPossiblePath = activeAnswer.path(asOpenAsPossibleParts, 'OptionsQuestion') if km is defined else asOpenAsPossibleParts|reply_path -%}
    {%- set asOpenAsPossibleAUuid = repliesMap[asOpenAsPossiblePath]|reply_str_value if asOpenAsPossiblePath else '' -%}
    {%- if asOpenAsPossiblePath in repliesMap and repliesMap[asOpenAsPossiblePath].value is defined and repliesMap[asOpenAsPossiblePath].value.type is defined and repliesMap[asOpenAsPossiblePath].value.type != 'AnswerReply' -%}
      {%- set asOpenAsPossibleAUuid = '' -%}
    {%- endif -%}
    {%- if km is defined and asOpenAsPossiblePath and (asOpenAsPossibleAUuid not in km.entities.questions[uuids.asOpenAsPossibleQUuid].answerUuids or asOpenAsPossibleAUuid not in km.entities.answers) -%}
      {%- set asOpenAsPossibleAUuid = '' -%}
    {%- endif -%}
    {%- set openImmediatelyPath = [uuids.accessCUuid, uuids.openImmediatelyQUuid]|reply_path -%}
    {%- set openImmediatelyAUuid = repliesMap[openImmediatelyPath]|reply_str_value -%}
    {%- set embargoPath = [uuids.accessCUuid, uuids.limitedEmbargoQUuid]|reply_path -%}
    {%- set embargoAUuid = repliesMap[embargoPath]|reply_str_value -%}
    {# Only this fully answered, fixed-prose combination shares a paragraph.
       Keep original sentences and all other branches; ownership stays separate. #}
    {%- set simpleOpenness = asOpenAsPossibleAUuid == uuids.asOpenAsPossibleYesAUuid
        and openImmediatelyAUuid == uuids.openImmediatelyYesAUuid
        and embargoAUuid == uuids.limitedEmbargoOpenAUuid -%}
    {% if simpleOpenness %}<div class="dataset-policy openness-policy">{% endif %}
    {%- if asOpenAsPossibleAUuid == uuids.asOpenAsPossibleYesAUuid -%}
      {{ pgettext("questions/08-copyright-ipr", "<p>We will follow the principle of making our data <em>as open as possible</em>.</p>") }}
    {%- elif asOpenAsPossibleAUuid == uuids.asOpenAsPossibleNoAUuid -%}
      <p data-fact-id="openness-principle" data-status="explicit-no">{{ pgettext("questions/08-copyright-ipr", "We will not manage our data according to the principle of being as open as possible.") }}</p>
    {%- endif -%}

    {# Can open data #}
    {%- if openImmediatelyAUuid == uuids.openImmediatelyYesAUuid -%}
      <p>{{ pgettext("questions/08-copyright-ipr", "All project data can eventually be made openly available.") }}</p>
    {%- elif openImmediatelyAUuid == uuids.openImmediatelyNoAUuid -%}
      {%- set pathPrefix = [openImmediatelyPath, uuids.openImmediatelyNoAUuid]|reply_path -%}
      {%- set notOpenLegalReasonsPath = [pathPrefix, uuids.notOpenLegalReasonsQUuid]|reply_path -%}
      {%- set notOpenLegalReasonsAUuid = repliesMap[notOpenLegalReasonsPath]|reply_str_value -%}
      {%- set notOpenBusinessReasonsPath = [pathPrefix, uuids.notOpenBusinessReasonsQUuid]|reply_path -%}
      {%- set notOpenBusinessReasonsAUuid = repliesMap[notOpenBusinessReasonsPath]|reply_str_value -%}
      {%- set notOpenOtherReasonsPath = [pathPrefix, uuids.notOpenOtherReasonsQUuid]|reply_path -%}
      {%- set notOpenOtherReasonsAUuid = repliesMap[notOpenOtherReasonsPath]|reply_str_value -%}
      {%- set notOpenBusinessReasonsOtherPath = [notOpenBusinessReasonsPath, uuids.notOpenBusinessReasonsOtherAUuid, uuids.notOpenBusinessReasonsOtherQUuid]|reply_path -%}
      {%- set notOpenBusinessReasonsOther = repliesMap[notOpenBusinessReasonsOtherPath]|reply_str_value -%}
      {%- set notOpenBusinessReasonsOther = notOpenBusinessReasonsOther if notOpenBusinessReasonsOther|trim else '' -%}
      {%- set notOpenOtherReasonsOtherPath = [notOpenOtherReasonsPath, uuids.notOpenOtherReasonsOtherAUuid, uuids.notOpenOtherReasonsOtherQUuid]|reply_path -%}
      {%- set notOpenOtherReasonsOther = repliesMap[notOpenOtherReasonsOtherPath]|reply_str_value -%}
      {%- set notOpenOtherReasonsOther = notOpenOtherReasonsOther if notOpenOtherReasonsOther|trim else '' -%}

      {%- set legalReasons = notOpenLegalReasonsAUuid == uuids.notOpenLegalReasonsYesAUuid -%}
      {%- set businessReasonsPatents = notOpenBusinessReasonsAUuid == uuids.notOpenBusinessReasonsPatentsAUuid -%}
      {%- set businessReasonsOther = notOpenBusinessReasonsAUuid == uuids.notOpenBusinessReasonsOtherAUuid -%}
      {%- set otherReasonsPapers = notOpenOtherReasonsAUuid == uuids.notOpenOtherReasonsPapersAUuid -%}
      {%- set otherReasonsOther = notOpenOtherReasonsAUuid == uuids.notOpenOtherReasonsOtherAUuid -%}
      {%- set reasons = [legalReasons, businessReasonsPatents, businessReasonsOther, otherReasonsPapers, otherReasonsOther] -%}
      {%- set nReasons = reasons|select("true")|list|length -%}

      {%- if nReasons > 0 -%}
        <div class="answer-detail">
        {%- if nReasons == 1 -%}
          {%- if legalReasons %}
            {{ pgettext("questions/08-copyright-ipr", "The data cannot be made fully open because of legal restrictions.") }}
          {%- elif businessReasonsPatents %}
            {{ pgettext("questions/08-copyright-ipr", "The data cannot be made fully open because patent applications still need to be filed.") }}
          {%- elif businessReasonsOther %}
            <div{% if notOpenBusinessReasonsOther %} class="answer-lead"{% endif %}><p>{{ pgettext("questions/08-copyright-ipr", "The data cannot be made fully open for other commercial reasons:") if notOpenBusinessReasonsOther else pgettext("questions/08-copyright-ipr", "The data cannot be made fully open for other commercial reasons.") }}</p></div>
            {% if notOpenBusinessReasonsOther %}{{ answerMarkdown.markdown(notOpenBusinessReasonsOther) }}{% endif %}
          {%- elif otherReasonsPapers %}
            {{ pgettext("questions/08-copyright-ipr", "The data cannot be made fully open because papers need to be submitted first.") }}
          {%- elif otherReasonsOther %}
            <div{% if notOpenOtherReasonsOther %} class="answer-lead"{% endif %}><p>{{ pgettext("questions/08-copyright-ipr", "The data cannot be made fully open for other reasons:") if notOpenOtherReasonsOther else pgettext("questions/08-copyright-ipr", "The data cannot be made fully open for other reasons.") }}</p></div>
            {% if notOpenOtherReasonsOther %}{{ answerMarkdown.markdown(notOpenOtherReasonsOther) }}{% endif %}
          {%- endif -%}
        {%- else %}
          <div class="answer-lead"><p>{{ pgettext("questions/08-copyright-ipr", "The data cannot be made fully open for the following reasons:") }}</p></div>
          <ul>
            {%- if legalReasons %}
              <li>{{ pgettext("questions/08-copyright-ipr", "legal restrictions") }}</li>
            {%- endif -%}
            {%- if businessReasonsPatents %}
              <li>{{ pgettext("questions/08-copyright-ipr", "patent applications still need to be filed") }}</li>
            {%- elif businessReasonsOther %}
              <li><div{% if notOpenBusinessReasonsOther %} class="answer-lead"{% endif %}><p>{{ pgettext("questions/08-copyright-ipr", "other commercial reasons:") if notOpenBusinessReasonsOther else pgettext("questions/08-copyright-ipr", "other commercial reasons") }}</p></div>
                {% if notOpenBusinessReasonsOther %}{{ answerMarkdown.markdown(notOpenBusinessReasonsOther) }}{% endif %}</li>
            {%- endif -%}
            {%- if otherReasonsPapers %}
              <li>{{ pgettext("questions/08-copyright-ipr", "papers need to be submitted first") }}</li>
            {%- elif otherReasonsOther -%}
              <li><div{% if notOpenOtherReasonsOther %} class="answer-lead"{% endif %}><p>{{ pgettext("questions/08-copyright-ipr", "other reasons:") if notOpenOtherReasonsOther else pgettext("questions/08-copyright-ipr", "other reasons") }}</p></div>
                {% if notOpenOtherReasonsOther %}{{ answerMarkdown.markdown(notOpenOtherReasonsOther) }}{% endif %}</li>
            {%- endif -%}
          </ul>
        {%- endif -%}
        </div>
      {%- else -%}
        <p>{{ pgettext("questions/08-copyright-ipr", "The data cannot be made fully open.") }}</p>
      {%- endif -%}

      {# Authentication and authorization of users #}

      {%- if notOpenLegalReasonsAUuid  == uuids.notOpenLegalReasonsYesAUuid -%}
        {%- set authenticationPath = [notOpenLegalReasonsPath, uuids.notOpenLegalReasonsYesAUuid, uuids.legalReasonsAuthenticatedQUuid]|reply_path -%}
        {%- set authenticationReply = repliesMap[authenticationPath]|reply_str_value -%}
        {%- set legalReasonsAuthenticatedQUuid = [notOpenLegalReasonsPath, uuids.notOpenLegalReasonsYesAUuid, uuids.legalReasonsAuthenticatedQUuid, uuids.legalReasonsAuthenticatedYesAUuid, uuids.legalReasonsAuthorizeQUuid ]|reply_path -%}
        {%- set legalReasonsAuthenticatedAUuid = repliesMap[legalReasonsAuthenticatedQUuid]|reply_str_value -%}
        
        {%- if authenticationReply == uuids.legalReasonsAuthenticatedYesAUuid and legalReasonsAuthenticatedAUuid in [uuids.legalReasonsAuthorizeMemberAUuid, uuids.legalReasonsAuthorizeNewCommitteeAUuid, uuids.legalReasonsAuthorizeOldCommitteeAUuid, uuids.legalReasonsAuthorizeOtherAUuid] -%}
          <h4 data-fact-id="authorization-arrangements">{{ pgettext("questions/08-copyright-ipr", "Authentication and Authorization of Users") }}</h4>
          {%- if legalReasonsAuthenticatedAUuid == uuids.legalReasonsAuthorizeMemberAUuid -%}
            <p>{{ pgettext("questions/08-copyright-ipr", "One of the project members will authorize potential users of the data.") }}</p>
          {%- elif legalReasonsAuthenticatedAUuid == uuids.legalReasonsAuthorizeNewCommitteeAUuid -%}
            <p>{{ pgettext("questions/08-copyright-ipr", "We will set up a data access committee for authorization of potential users of the data.") }}</p>
          {%- elif legalReasonsAuthenticatedAUuid == uuids.legalReasonsAuthorizeOldCommitteeAUuid -%}
            {%- set legalReasonsAuthenticatedCommitteeQUuid = [legalReasonsAuthenticatedQUuid, uuids.legalReasonsAuthorizeOldCommitteeAUuid, uuids.legalReasonsAuthorizeOldCommitteeQUuid]|reply_path -%}
            {%- set legalReasonsAuthenticatedCommitteeReply = repliesMap[legalReasonsAuthenticatedCommitteeQUuid]|reply_str_value -%}
            
            {%- if legalReasonsAuthenticatedCommitteeReply|trim -%}
              <div class="answer-detail"><div class="answer-lead"><p>{{ pgettext("questions/08-copyright-ipr", "We will make use of an existing data committee:") }}</p></div>{{ answerMarkdown.markdown(legalReasonsAuthenticatedCommitteeReply) }}</div>
            {%- else -%}
              <p>{{ pgettext("questions/08-copyright-ipr", "We will make use of an existing data committee.") }}</p>
            {%- endif -%}

          {%- elif legalReasonsAuthenticatedAUuid == uuids.legalReasonsAuthorizeOtherAUuid -%}
            {%- set legalReasonsAuthenticatedOtherQUuid = [legalReasonsAuthenticatedQUuid, uuids.legalReasonsAuthorizeOtherAUuid, uuids.legalReasonsAuthorizeOtherQUuid]|reply_path  -%}
            {%- set legalReasonsAuthenticatedOtherReply = repliesMap[legalReasonsAuthenticatedOtherQUuid]|reply_str_value -%}

            {%- if legalReasonsAuthenticatedOtherReply|trim -%}
              <div class="answer-detail"><div class="answer-lead"><p>{{ pgettext("questions/08-copyright-ipr", "We will use the following authorization arrangements:") }}</p></div>{{ answerMarkdown.markdown(legalReasonsAuthenticatedOtherReply) }}</div>
            {%- else -%}
              <p>{{ pgettext("questions/08-copyright-ipr", "We will make other arrangements for authorizing potential users.") }}</p>
              {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/08-copyright-ipr", "<p class=\"data-gap\" data-fact-id=\"authorization-details\" data-status=\"missing\"><strong>Information not provided:</strong> details of the authorization arrangements.</p>") }}{% endif %}
            {%- endif -%}
          {%- endif -%}
 
        {%- endif -%}

      {%- endif -%}

      {# KM 2.7.0 stores embargo at the access chapter root, handled below. #}
    {%- endif -%}

    {# Embargo #}
    {%- if embargoAUuid == uuids.limitedEmbargoOpenAUuid -%}
      <p>{{ pgettext("questions/08-copyright-ipr", "All data will be made openly available immediately, without an embargo period.") }}</p>
    {%- elif embargoAUuid == uuids.limitedEmbargoIndefinitelyAUuid -%}
      <p>{{ pgettext("questions/08-copyright-ipr", "Unrestricted data will be made openly available immediately; restricted data will remain closed indefinitely.") }}</p>
    {%- elif embargoAUuid == uuids.limitedEmbargoReleasedSoonAUuid -%}
      <p>{{ pgettext("questions/08-copyright-ipr", "Data will be released as soon as the restrictions no longer apply.") }}</p>
    {%- elif embargoAUuid == uuids.limitedEmbargoYesAUuid -%}
      {%- set embargoPeriodPath = [embargoPath, embargoAUuid, uuids.limitedEmbargoPeriodQUuid]|reply_path -%}
      {%- set embargoPeriod = repliesMap[embargoPeriodPath]|reply_str_value -%}
      {%- if embargoPeriod|trim -%}
        <p>{{ pgettext("questions/08-copyright-ipr", "Data not subject to legal restrictions will be released unconditionally after a fixed period (%(embargoPeriod)s).", embargoPeriod=embargoPeriod) }}</p>
      {%- else -%}
        <p>{{ pgettext("questions/08-copyright-ipr", "Data not subject to legal restrictions will be released unconditionally after a fixed period.") }}</p>
      {%- endif -%}
    {%- endif -%}
    {% if simpleOpenness %}</div>{% endif %}
    
    {# Ownership #}
    {%- import 'src/active-answer.j2' as activeAnswer with context -%}
    {%- set ownershipParts = [uuids.creatingCUuid, uuids.ownershipQUuid] -%}
    {%- set ownershipPath = activeAnswer.path(ownershipParts, 'OptionsQuestion') if km is defined else ownershipParts|reply_path -%}
    {%- set ownershipAUuid = repliesMap[ownershipPath]|reply_str_value if ownershipPath else '' -%}
    {%- if km is defined and ownershipPath and (ownershipAUuid not in km.entities.questions[uuids.ownershipQUuid].answerUuids or ownershipAUuid not in km.entities.answers) -%}
      {%- set ownershipAUuid = '' -%}
    {%- endif -%}
    {%- if ownershipAUuid == uuids.ownershipNoOwnerAUuid -%}
      <p>{{ pgettext("questions/08-copyright-ipr", "The project data are not protected by copyright and therefore have no copyright owner.") }}</p>
    {%- elif ownershipAUuid == uuids.ownershipPIAUuid -%}
      <p>{{ pgettext("questions/08-copyright-ipr", "All data will be owned by the Principal Investigator.") }}</p>
    {%- elif ownershipAUuid == uuids.ownershipInstituteAUuid -%}
      <p>{{ pgettext("questions/08-copyright-ipr", "All data will be owned by the institute.") }}</p>
    {%- elif ownershipAUuid == uuids.ownershipConsortiumAUuid -%}
      <p>{{ pgettext("questions/08-copyright-ipr", "Our consortium agreement defines ownership of intellectual property rights.") }}</p>
    {%- elif ownershipAUuid == uuids.ownershipOtherAUuid -%}
      {%- set ownershipOtherParts = ownershipParts + [uuids.ownershipOtherAUuid, uuids.ownershipOtherQUuid] -%}
      {%- set ownershipOtherPath = activeAnswer.path(ownershipOtherParts, 'ValueQuestion') if km is defined else ownershipOtherParts|reply_path -%}
      {%- set ownershipOther = repliesMap[ownershipOtherPath]|reply_str_value if ownershipOtherPath else '' -%}
      {%- if ownershipOther|trim -%}
        <div class="answer-detail">
          <div class="answer-lead"><p>{{ pgettext("questions/08-copyright-ipr", "We have made the following arrangements regarding data ownership:") }}</p></div>
          {{ answerMarkdown.markdown(ownershipOther) }}
        </div>
      {%- else -%}
        <p>{{ pgettext("questions/08-copyright-ipr", "Rights to the collected data are arranged in another way.") }}</p>
      {%- endif -%}
    {%- endif -%}

    {# (Non)reference data - license #}
    {%- set preexistingPath = [uuids.reusingCUuid, uuids.preexistingQUuid]|reply_path -%}
    {%- set preexistingAUuid = repliesMap[preexistingPath]|reply_str_value -%}
    {%- if preexistingAUuid == uuids.preexistingYesAUuid -%}
      {%- set refDataPath = [preexistingPath, uuids.preexistingYesAUuid, uuids.refDataQUuid]|reply_path -%}
      {%- set refDataItems = repliesMap[refDataPath]|reply_items -%}
      {%- set nrefDataPath = [preexistingPath, uuids.preexistingYesAUuid, uuids.nrefDataQUuid]|reply_path -%}
      {%- set nrefDataItems = repliesMap[nrefDataPath]|reply_items -%}
      {%- set answeredRefData = [] -%}
      {%- for i in refDataItems -%}
        {%- set isUsed = repliesMap[[refDataPath, i, uuids.refDataUseQUuid]|reply_path]|reply_str_value == uuids.refDataUseYesAUuid -%}
        {%- set isAnswered = repliesMap[[refDataPath, i, uuids.refDataUseQUuid, uuids.refDataUseYesAUuid, uuids.refDataConditionsQUuid]|reply_path] -%}
        {%- if isUsed and isAnswered -%}
          {%- do answeredRefData.append(i) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set answeredNRefData = [] -%}
      {%- for i in nrefDataItems -%}
        {%- set isUsed = repliesMap[[nrefDataPath, i, uuids.nrefDataUseQUuid]|reply_path]|reply_str_value == uuids.nrefDataUseYesAUuid -%}
        {%- set isAnswered = repliesMap[[nrefDataPath, i, uuids.nrefDataUseQUuid, uuids.nrefDataUseYesAUuid, uuids.nrefDataConditionsQUuid]|reply_path] -%}
        {%- if isUsed and isAnswered -%}
          {%- do answeredNRefData.append(i) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if (answeredRefData|length + answeredNRefData|length) > 0 -%}
        <div class="answer-lead"><p>{{ pgettext("questions/08-copyright-ipr", "The following conditions apply to the reference and non-reference datasets that we reuse:") }}</p></div>
        <ul>
          {%- for i in answeredRefData -%}
            {%- set refDataPrefix = [refDataPath, i]|reply_path -%}
            {%- set refDataUsedPrefix = [refDataPrefix, uuids.refDataUseQUuid, uuids.refDataUseYesAUuid]|reply_path -%}
            {%- set refDataNamePath = [refDataPrefix, uuids.refDataNameQUuid]|reply_path -%}
            {%- set refDataNameReply = repliesMap[refDataNamePath]|reply_str_value -%}
            {%- set refDataConditionsPath = [refDataUsedPrefix, uuids.refDataConditionsQUuid]|reply_path -%}
            {%- set refDataConditionsAUuid = repliesMap[refDataConditionsPath]|reply_str_value -%}
            {%- if refDataConditionsAUuid -%}
              <li>
                {%- if refDataNameReply|trim -%}
                  <div>{{ refDataNameReply }}</div>
                {%- else -%}
                  {% if output_profile|default('review') == 'submission' %}<div>{{ macros.datasetLabel(macros.DATASET_REFERENCE, refDataItems.index(i) + 1) }}</div>{% else %}<div>{{ pgettext("questions/08-copyright-ipr", "(no name given)") }}</div>{% endif %}
                {%- endif -%}
                
                {% if refDataConditionsAUuid == uuids.refDataConditionsCC0AUuid -%}
                  {{ pgettext("questions/08-copyright-ipr", "It is freely available for any use (public domain or CC0).") }}
                {%- elif refDataConditionsAUuid == uuids.refDataConditionsCCBYAUuid -%}
                  {{ pgettext("questions/08-copyright-ipr", "It is freely available with an obligation to cite the source (e.g. CC BY).") }}
                {%- elif refDataConditionsAUuid == uuids.refDataConditionsOtherAUuid -%}
                  {%- set refDataConditionsOtherPath = [refDataConditionsPath, uuids.refDataConditionsOtherAUuid, uuids.refDataConditionsOtherQUuid]|reply_path -%}
                  {%- set refDataConditionsOther = repliesMap[refDataConditionsOtherPath]|reply_str_value -%}
                  {%- set refDataConditionsOther = refDataConditionsOther if refDataConditionsOther|trim else '' -%}
                  <p{% if refDataConditionsOther %} class="answer-lead"{% endif %}>{{ pgettext("questions/08-copyright-ipr", "It is available under specific restrictions, which we will follow in our project:") if refDataConditionsOther else pgettext("questions/08-copyright-ipr", "It is available under specific restrictions, which we will follow in our project.") }}</p>
                  {% if refDataConditionsOther %}<div class="answer-detail">{{ answerMarkdown.markdown(refDataConditionsOther) }}</div>{% endif %}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- for i in answeredNRefData -%}
            {%- set nrefDataPrefix = [nrefDataPath, i]|reply_path -%}
            {%- set nrefDataUsedPrefix = [nrefDataPrefix, uuids.nrefDataUseQUuid, uuids.nrefDataUseYesAUuid]|reply_path -%}
            {%- set nrefDataNamePath = [nrefDataPrefix, uuids.nrefDataNameQUuid]|reply_path -%}
            {%- set nrefDataNameReply = repliesMap[nrefDataNamePath]|reply_str_value -%}
            {%- set nrefDataConditionsPath = [nrefDataUsedPrefix, uuids.nrefDataConditionsQUuid]|reply_path -%}
            {%- set nrefDataConditionsAUuid = repliesMap[nrefDataConditionsPath]|reply_str_value -%}
            {%- if nrefDataConditionsAUuid -%}
              <li>
                {%- if nrefDataNameReply|trim -%}
                  <div>{{ nrefDataNameReply }}</div>
                {%- else -%}
                  {% if output_profile|default('review') == 'submission' %}<div>{{ macros.datasetLabel(macros.DATASET_NON_REFERENCE, nrefDataItems.index(i) + 1) }}</div>{% else %}<div>{{ pgettext("questions/08-copyright-ipr", "(no name given)") }}</div>{% endif %}
                {%- endif -%}
                {% if nrefDataConditionsAUuid == uuids.nrefDataConditionsCC0AUuid -%}
                  {{ pgettext("questions/08-copyright-ipr", "It is freely available for any use (public domain or CC0).") }}
                {%- elif nrefDataConditionsAUuid == uuids.nrefDataConditionsCCBYAUuid -%}
                  {{ pgettext("questions/08-copyright-ipr", "It is freely available with an obligation to cite the source (e.g. CC BY).") }}
                {%- elif nrefDataConditionsAUuid == uuids.nrefDataConditionsOtherAUuid -%}
                  {%- set nrefDataConditionsOtherPath = [nrefDataConditionsPath, uuids.nrefDataConditionsOtherAUuid, uuids.nrefDataConditionsOtherQUuid]|reply_path -%}
                  {%- set nrefDataConditionsOther = repliesMap[nrefDataConditionsOtherPath]|reply_str_value -%}
                  {%- set nrefDataConditionsOther = nrefDataConditionsOther if nrefDataConditionsOther|trim else '' -%}
                  <p{% if nrefDataConditionsOther %} class="answer-lead"{% endif %}>{{ pgettext("questions/08-copyright-ipr", "It is available under specific restrictions, which we will follow in our project:") if nrefDataConditionsOther else pgettext("questions/08-copyright-ipr", "It is available under specific restrictions, which we will follow in our project.") }}</p>
                  {% if nrefDataConditionsOther %}<div class="answer-detail">{{ answerMarkdown.markdown(nrefDataConditionsOther) }}</div>{% endif %}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
    {% endset %}
    {% if legalContent|striptags|trim %}
      {{ legalContent }}
    {% else %}
      {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-4b" data-status="missing-output">{{ pgettext("questions/08-copyright-ipr", "This document does not yet describe arrangements for data ownership, intellectual property rights, or applicable legislation. Please review and complete this section.") }}</p>{% endif %}
    {% endif %}
  </div>
</div>
