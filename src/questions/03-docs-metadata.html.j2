      {%- if storageConvRelDbAUuid == uuids.storageConvRelDbNoAUuid -%}
        <p>{{ pgettext("questions/03-docs-metadata", "We will not use a database system to store project data.") }}</p>
      {%- elif storageConvRelDbAUuid == uuids.storageConvRelDbYesAUuid -%}
        <p>
        {{ pgettext("questions/03-docs-metadata", "We will use a database system to store project data.") }}
        {%- set scRelDbHandleChangesPath = [storageConvRelDbPath, uuids.storageConvRelDbYesAUuid, uuids.scRelDbHandleChangesQUuid]|reply_path -%}
        {%- set scRelDbHandleChangesAUuid = repliesMap[scRelDbHandleChangesPath]|reply_str_value -%}
        {%- if scRelDbHandleChangesAUuid == uuids.scRelDbReadOnlyAnswerUuid -%}
          {{ "" if document_language|default('en') == 'zh-Hant' else "\n          " }}{{ pgettext("questions/03-docs-metadata", "Data in the database will be read-only.") }}
        {%- elif scRelDbHandleChangesAUuid == uuids.scRelDbCrudAnswerUuid -%}
          {{ "" if document_language|default('en') == 'zh-Hant' else "\n          " }}{{ pgettext("questions/03-docs-metadata", "We will allow data in the database to be created, updated, and deleted.") }}
        {%- elif scRelDbHandleChangesAUuid == uuids.scRelDbExpireAnswerUuid -%}
          {{ "" if document_language|default('en') == 'zh-Hant' else "\n          " }}{{ pgettext("questions/03-docs-metadata", "To update the data, we will mark the existing data as expired and add the updated data.") }}
        {%- endif -%}
        </p>
      {%- endif -%}
        </div>
      </div>
      {% endif %}
      </div>
