{% import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
{# Only short, plain naming answers may stay together; preserve their HTML. #}
{%- macro shortNamingClass(rendered) -%}
  {%- set parts = (rendered|trim).split('</p>') -%}
  {%- set guard = namespace(ok=parts|length in [2, 3], chunks=[], width=0) -%}
  {%- for part in parts[:-1] -%}
    {%- set paragraph = part|trim -%}
    {%- if not paragraph.startswith('<p>') -%}{%- set guard.ok = false -%}{%- endif -%}
    {%- do guard.chunks.append((paragraph[3:], 160)) -%}
  {%- endfor -%}
  {%- set tail = parts[-1]|trim -%}
  {%- if tail -%}
    {%- set opening = '<ul>' if tail.startswith('<ul>') else '<ol>' if tail.startswith('<ol>') else '' -%}
    {%- set closing = '</ul>' if opening == '<ul>' else '</ol>' -%}
    {%- if not opening or not tail.endswith(closing) -%}{%- set guard.ok = false -%}{%- endif -%}
    {%- set items = tail[opening|length:-(closing|length)].split('</li>') -%}
    {%- if items|length not in [2, 3, 4] or items[-1]|trim -%}{%- set guard.ok = false -%}{%- endif -%}
    {%- for item in items[:-1] -%}
      {%- set item = item|trim -%}
      {%- if not item.startswith('<li>') -%}{%- set guard.ok = false -%}{%- endif -%}
      {%- do guard.chunks.append((item[4:], 100)) -%}
    {%- endfor -%}
  {%- endif -%}
  {%- for text, limit in guard.chunks -%}
    {%- set chunk = namespace(width=0, token=0) -%}
    {%- if not text|trim or '<' in text or '>' in text -%}{%- set guard.ok = false -%}{%- endif -%}
    {%- for char in text -%}
      {%- set chunk.width = chunk.width + (2 if char >= '⺀' else 1) -%}
      {%- set chunk.token = chunk.token + 1 if '!' <= char <= '~' else 0 -%}
      {%- if chunk.token > 64 -%}{%- set guard.ok = false -%}{%- endif -%}
    {%- endfor -%}
    {%- if chunk.width > limit -%}{%- set guard.ok = false -%}{%- endif -%}
    {%- set guard.width = guard.width + chunk.width -%}
  {%- endfor -%}
  {{- ' short-naming-answer' if guard.ok and guard.width <= 320 else '' -}}
{%- endmacro -%}
<div id="q-docs-metadata" class="question">
  <h3>{{ pgettext("questions/03-docs-metadata", "3. What metadata and documentation (for example the methodology of data collection and way of organising data) will accompany the data?") }}</h3>

  <div class="answer">
  {% set answerContent %}
    {%- import 'src/active-answer.j2' as activeAnswer with context -%}
    {% include 'src/project-file-naming.html.j2' %}

    {# Metadata #}
    {% set metadataPolicyOriginal %}
    {%- set metadataPath = [uuids.creatingCUuid, uuids.metadataQUuid]|reply_path -%}
    {%- set metadataAUuid = repliesMap[metadataPath]|reply_str_value -%}
    {%- if metadataAUuid == uuids.metadataExploreAUuid -%}

      {# Metadata standards #}
      {%- set metadataSentences = [] -%}
      {%- set metadataStandardsPath = [metadataPath, uuids.metadataExploreAUuid, uuids.metadataStandardsQUuid]|reply_path -%}
      {%- set metadataStandardsAUuid = repliesMap[metadataStandardsPath]|reply_str_value -%}
      {%- if metadataStandardsAUuid == uuids.metadataStandardsExploreAUuid -%}
        {%- set metadataStandardsDCPath = [metadataStandardsPath, uuids.metadataStandardsExploreAUuid, uuids.metadataStandardsDCQUuid]|reply_path -%}
        {%- set metadataStandardsDCAUuid = repliesMap[metadataStandardsDCPath]|reply_str_value -%}
        {%- set metadataStandardsDataCityPath = [metadataStandardsPath, uuids.metadataStandardsExploreAUuid, uuids.metadataStandardsDataCiteQUuid]|reply_path -%}
        {%- set metadataStandardsDataCityAUuid = repliesMap[metadataStandardsDataCityPath]|reply_str_value -%}
        {%- set metadataStandardsDDIPath = [metadataStandardsPath, uuids.metadataStandardsExploreAUuid, uuids.metadataStandardsDDIQUuid]|reply_path -%}
        {%- set metadataStandardsDDIAUuid = repliesMap[metadataStandardsDDIPath]|reply_str_value -%}
        {%- set metadataStandardsKeywordsParts = [uuids.creatingCUuid, uuids.metadataQUuid, uuids.metadataExploreAUuid, uuids.metadataStandardsQUuid, uuids.metadataStandardsExploreAUuid, uuids.metadataStandardsKeywordsQUuid] -%}
        {%- set metadataStandardsKeywordsPath = activeAnswer.path(metadataStandardsKeywordsParts, 'OptionsQuestion') if km is defined else metadataStandardsKeywordsParts|reply_path -%}
        {%- set metadataStandardsKeywordsAUuid = repliesMap[metadataStandardsKeywordsPath]|reply_str_value if metadataStandardsKeywordsPath else '' -%}
        {%- if km is defined and metadataStandardsKeywordsPath and (metadataStandardsKeywordsAUuid not in km.entities.questions[uuids.metadataStandardsKeywordsQUuid].answerUuids or metadataStandardsKeywordsAUuid not in km.entities.answers) -%}
          {%- set metadataStandardsKeywordsAUuid = '' -%}
        {%- endif -%}


        {%- set metadataStandards = [] -%}
        {%- if metadataStandardsDCAUuid == uuids.metadataStandardsDCYesAUuid -%}
          {%- do metadataStandards.append("Dublin Core") -%}
        {%- endif -%}
        {%- if metadataStandardsDataCityAUuid == uuids.metadataStandardsDataCiteYesAUuid -%}
          {%- do metadataStandards.append("DataCite") -%}
        {%- endif -%}
        {%- if metadataStandardsDDIAUuid == uuids.metadataStandardsDDIYesAUuid -%}
          {%- do metadataStandards.append(pgettext("questions/03-docs-metadata", "DDI (Data Documentation Initiative)")) -%}
        {%- endif -%}
        {%- if metadataStandards|length == 1 -%}
          {%- do metadataSentences.append(pgettext("questions/03-docs-metadata", "We will document the data using the %(first_standard)s metadata standard.", first_standard=metadataStandards[0])) -%}
        {%- elif metadataStandards|length == 2 -%}
          {%- do metadataSentences.append(pgettext("questions/03-docs-metadata", "We will document the data using the %(first_standard)s and %(second_standard)s metadata standards.", first_standard=metadataStandards[0], second_standard=metadataStandards[1])) -%}
        {%- elif metadataStandards|length == 3 -%}
          {%- do metadataSentences.append(pgettext("questions/03-docs-metadata", "We will document the data using the %(first_standard)s, %(second_standard)s, and %(third_standard)s metadata standards.", first_standard=metadataStandards[0], second_standard=metadataStandards[1], third_standard=metadataStandards[2])) -%}
        {%- endif -%}
        {%- if metadataStandardsKeywordsAUuid == uuids.metadataStandardsKeywordsYesAUuid -%}
          {%- do metadataSentences.append(pgettext("questions/03-docs-metadata", "We will include keywords or relevant ontology references to support discovery and potential reuse.")) -%}
        {%- endif -%}
      {%- endif -%}

      {%- set provenanceW3CPath = [metadataPath, uuids.metadataExploreAUuid, uuids.provenanceW3CQUuid]|reply_path -%}
      {%- set provenanceW3CAUuid = repliesMap[provenanceW3CPath]|reply_str_value -%}
      {%- if provenanceW3CAUuid == uuids.provenanceW3CYesAUuid -%}
          {%- do metadataSentences.append(pgettext("questions/03-docs-metadata", "The provenance will be captured using W3C PROV.")) -%}
      {%- endif -%}

      {%- if metadataSentences|length > 0 -%}
        <p>{{ metadataSentences|join("" if document_language|default('en') == 'zh-Hant' else " ") }}</p>
      {%- endif -%}
      {# This answer is independent of standards and metadata publication. #}
      {%- set dictionary = repliesMap[[metadataPath, uuids.metadataExploreAUuid, uuids.metadataDictionaryQUuid]|reply_path]|reply_str_value -%}
      {%- if dictionary == uuids.metadataDictionaryYesAUuid -%}
        <p data-fact-id="metadata-dictionary" data-status="complete">{{ pgettext("questions/03-docs-metadata", "We will create a data/variable dictionary.") }}</p>
      {%- elif dictionary == uuids.metadataDictionaryNoAUuid -%}
        <p data-fact-id="metadata-dictionary" data-status="explicit-no">{{ pgettext("questions/03-docs-metadata", "We will not create a data/variable dictionary.") }}</p>
      {%- elif output_profile|default('review') != 'submission' -%}
        <div class="reading-gap">
          {%- if dictionary|trim -%}
          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="metadata-dictionary" data-status="needs-review">{{ pgettext("questions/03-docs-metadata", "The selected data-dictionary option cannot be represented by this template; please review it.") }}</p>{% endif %}
          {%- else -%}
          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="metadata-dictionary" data-status="missing">{{ pgettext("questions/03-docs-metadata", "Information not provided: whether a data/variable dictionary will be created.") }}</p>{% endif %}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {# Publishing metadata #}
    {%- set metadataOpenPath = [uuids.accessCUuid, uuids.metadataOpenQUuid]|reply_path -%}
    {%- set metadataOpenAUuid = repliesMap[metadataOpenPath]|reply_str_value -%}
    {%- if metadataOpenAUuid == uuids.metadataOpenNoAUuid %}
      {%- set explanation = repliesMap[[metadataOpenPath, metadataOpenAUuid, uuids.metadataOpenNoExplainQUuid]|reply_path]|reply_str_value -%}
      <p>{{ pgettext("questions/03-docs-metadata", "Metadata will not be available openly.") }}</p>
      {%- if explanation|trim -%}
        <div class="answer-detail" data-fact-id="metadata-access-explanation"><div class="answer-lead"><p>{{ pgettext("questions/03-docs-metadata", "Reason for not making the metadata openly available:") }}</p></div>{{ answerMarkdown.markdown(explanation) }}</div>
      {%- elif output_profile|default('review') != 'submission' -%}
        <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="metadata-access-explanation" data-status="missing">{{ pgettext("questions/03-docs-metadata", "Information not provided: why the metadata will not be openly available.") }}</p>{% endif %}</div>
      {%- endif -%}
    {%- elif metadataOpenAUuid == uuids.metadataOpenYesAUuid -%}
      {%- set metadataOpenInstrAUuid = repliesMap[[metadataOpenPath, metadataOpenAUuid, uuids.metadataOpenInstrQUuid]|reply_path]|reply_str_value -%}
      {%- set metadataOpenFormAUuid = repliesMap[[metadataOpenPath, metadataOpenAUuid, uuids.metadataOpenFormQUuid]|reply_path]|reply_str_value -%}
      <p>
      {%- if metadataOpenInstrAUuid == uuids.metadataOpenInstrYesAUuid %}
        {{ pgettext("questions/03-docs-metadata", "Metadata will be openly available, including instructions on how to access the data.") }}
      {%- elif metadataOpenInstrAUuid == uuids.metadataOpenInstrNoAUuid %}
        {{ pgettext("questions/03-docs-metadata", "Metadata will be openly available without instructions on how to access the data.") }}
      {%- else %}
        {{ pgettext("questions/03-docs-metadata", "Metadata will be openly available.") }}
      {%- endif %}
      {%- if metadataOpenFormAUuid == uuids.metadataOpenFormNoAUuid %}
        {{ pgettext("questions/03-docs-metadata", "It will not be provided in a form that can be harvested and indexed.") }}
      {%- elif metadataOpenFormAUuid == uuids.metadataOpenFormYesRepoAUuid %}
        {{ pgettext("questions/03-docs-metadata", "The selected repository or repositories will provide it in a form that can be harvested and indexed.") }}
      {%- elif metadataOpenFormAUuid == uuids.metadataOpenFormYesCareAUuid %}
        {{ pgettext("questions/03-docs-metadata", "It will also be provided in a form that can be harvested and indexed.") }}
      {%- endif %}
      </p>
      {%- set instructionKnown = metadataOpenInstrAUuid in [uuids.metadataOpenInstrYesAUuid, uuids.metadataOpenInstrNoAUuid] -%}
      {%- set formKnown = metadataOpenFormAUuid in [uuids.metadataOpenFormNoAUuid, uuids.metadataOpenFormYesRepoAUuid, uuids.metadataOpenFormYesCareAUuid] -%}
      {%- if (not instructionKnown or not formKnown) and output_profile|default('review') != 'submission' -%}
      <div class="reading-gap">
        {%- if not metadataOpenInstrAUuid|trim and not metadataOpenFormAUuid|trim -%}
          {%- set metadataInstructionsGap -%}<span data-fact-id="metadata-access-instructions" data-status="missing">{{ pgettext("questions/03-docs-metadata", "whether the metadata will include instructions for accessing the data") }}</span>{%- endset -%}
          {%- set metadataHarvestGap -%}<span data-fact-id="metadata-harvestable" data-status="missing">{{ pgettext("questions/03-docs-metadata", "whether the metadata will be available in a form that can be harvested and indexed") }}</span>{%- endset -%}
          {% if output_profile|default('review') != 'submission' %}<p class="data-gap metadata-publication-gap">{{ pgettext("questions/03-docs-metadata", "Information not provided: %(metadataInstructionsGap)s; %(metadataHarvestGap)s.", metadataInstructionsGap=metadataInstructionsGap, metadataHarvestGap=metadataHarvestGap) }}</p>{% endif %}
        {%- else -%}
        {%- if not instructionKnown -%}
          {%- if metadataOpenInstrAUuid|trim -%}
          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="metadata-access-instructions" data-status="needs-review">{{ pgettext("questions/03-docs-metadata", "The selected metadata access-instructions option cannot be represented by this template; please review it.") }}</p>{% endif %}
          {%- else -%}
          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="metadata-access-instructions" data-status="missing">{{ pgettext("questions/03-docs-metadata", "Information not provided: whether the metadata will include instructions for accessing the data.") }}</p>{% endif %}
          {%- endif -%}
        {%- endif -%}
        {%- if not formKnown -%}
          {%- if metadataOpenFormAUuid|trim -%}
          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="metadata-harvestable" data-status="needs-review">{{ pgettext("questions/03-docs-metadata", "The selected metadata harvesting and indexing option cannot be represented by this template; please review it.") }}</p>{% endif %}
          {%- else -%}
          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="metadata-harvestable" data-status="missing">{{ pgettext("questions/03-docs-metadata", "Information not provided: whether the metadata will be available in a form that can be harvested and indexed.") }}</p>{% endif %}
          {%- endif -%}
        {%- endif -%}
        {%- endif -%}
      </div>
      {%- endif -%}
    {%- endif -%}
    {% endset %}{% import 'src/metadata-prose.html.j2' as metadataProse %}
    {# An empty leading block can separate the question from its real answer. #}
    {% if metadataPolicyOriginal|trim %}<div class="dataset-policy metadata-policy">{{ metadataProse.render(metadataPolicyOriginal) }}</div>{% endif %}

  {# Storage and file conventions #}
  {%- set storageConvPath = [uuids.processingCUuid, uuids.storageConvQUuid]|reply_path -%}
  {%- set storageConvAUuid = repliesMap[storageConvPath]|reply_str_value -%}
  {%- if storageConvAUuid == uuids.storageConvExploreAUuid -%}
    {%- set stConvPrefix = [storageConvPath, uuids.storageConvExploreAUuid]|reply_path -%}
    {%- set storageSpacePath = [stConvPrefix, uuids.storageSpaceQUuid]|reply_path -%}
    {%- set storageSpaceAUuid = repliesMap[storageSpacePath]|reply_str_value -%}
    {%- set storageConvFSysPath = [stConvPrefix, uuids.storageConvFSysQUuid]|reply_path -%}
    {%- set storageConvFSysAUuid = repliesMap[storageConvFSysPath]|reply_str_value -%}
    {%- set storageConvObjStorePath = [stConvPrefix, uuids.storageConvObjStoreQUuid]|reply_path -%}
    {%- set storageConvObjStoreAUuid = repliesMap[storageConvObjStorePath]|reply_str_value -%}
    {%- set storageConvRelDbPath = [stConvPrefix, uuids.storageConvRelDbQUuid]|reply_path -%}
    {%- set storageConvRelDbAUuid = repliesMap[storageConvRelDbPath]|reply_str_value -%}
    {# Capacity is an independent answer, not conditional on a storage technology. #}
    {%- if storageSpaceAUuid or storageConvFSysAUuid or storageConvObjStoreAUuid or storageConvRelDbAUuid -%}
      {% set storageContent %}
      <div class="storage-conventions-policy">
      {# Storage space #}
      {% set capacityContent %}
      {%- if storageSpaceAUuid == uuids.storageSpaceLittleAUuid -%}
        <p>{{ pgettext("questions/03-docs-metadata", "The project will require so little storage space for all data and software (including temporary storage) that it is not a problem.") }}</p>
      {%- elif storageSpaceAUuid == uuids.storageSpaceSpecifyAUuid -%}
        {%- set size = repliesMap[[storageSpacePath, storageSpaceAUuid, uuids.storageSpaceSpecifyQUuid]|reply_path]|reply_str_value -%}
        {%- if size|trim -%}
        <p>{{ pgettext("questions/03-docs-metadata", "We estimate the storage space that the project will require for all data and software (including temporary storage) to be %(size)s gigabytes.", size=size|e) }}</p>
        {%- elif output_profile|default('review') != 'submission' -%}
        <div class="reading-gap">
          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="storage-capacity" data-status="missing">{{ pgettext("questions/03-docs-metadata", "Information not provided: the estimated storage space for all project data and software, including temporary storage (GB).") }}</p>{% endif %}
        </div>
        {%- endif -%}
      {%- endif -%}
      {% endset %}
      {% if capacityContent|striptags|trim %}
      <div class="q3-storage-group" data-storage-group="capacity">
        <h5>{{ pgettext("q3-storage-groups", "Storage capacity") }}</h5>
        <div class="dataset-policy">{{ capacityContent }}</div>
      </div>
      {% endif %}
      {# File System #}
      {% if storageConvFSysAUuid in [uuids.storageConvFSysNoAUuid, uuids.storageConvFSysYesAUuid] %}
      <div class="q3-storage-group" data-storage-group="filesystem">
        <h5>{{ pgettext("q3-storage-groups", "File system and version management") }}</h5>
        <div class="dataset-policy">
      {%- if storageConvFSysAUuid == uuids.storageConvFSysNoAUuid -%}
        <p>{{ pgettext("questions/03-docs-metadata", "We will not use a filesystem with files and folders.") }}</p>
      {%- elif storageConvFSysAUuid == uuids.storageConvFSysYesAUuid -%}
        {%- set scFSysPrefix = [storageConvFSysPath, uuids.storageConvFSysYesAUuid]|reply_path -%}
        {# Folder types #}
        {%- set scFSysSubjFoldersPath = [scFSysPrefix, uuids.scFSysSubjFoldersQUuid]|reply_path -%}
        {%- set scFSysSubjFoldersAUuid = repliesMap[scFSysSubjFoldersPath]|reply_str_value -%}
        {%- set scFSysAnalysisFoldersPath = [scFSysPrefix, uuids.scFSysAnalysisFoldersQUuid]|reply_path -%}
        {%- set scFSysAnalysisFoldersAUuid = repliesMap[scFSysAnalysisFoldersPath]|reply_str_value -%}
        {%- set scFSysWorkflowStepFoldersPath = [scFSysPrefix, uuids.scFSysWorkflowStepFoldersQUuid]|reply_path -%}
        {%- set scFSysWorkflowStepFoldersAUuid = repliesMap[scFSysWorkflowStepFoldersPath]|reply_str_value -%}
        {%- set subjectFolders = scFSysSubjFoldersAUuid == uuids.scFSysSubjFoldersYesAUuid -%}
        {%- set analysisFolders = scFSysAnalysisFoldersAUuid == uuids.scFSysAnalysisFoldersYesAUuid -%}
        {%- set workflowStepFolders = scFSysWorkflowStepFoldersAUuid == uuids.scFSysWorkflowStepFoldersYesAUuid -%}
        {%- set folders = [subjectFolders, analysisFolders, workflowStepFolders] -%}
        {%- if folders|any -%}
          <p>{{ pgettext("questions/03-docs-metadata", "We will use a filesystem with files and folders with the following folder conventions:") }}</p>
          <ul>
            {%- if subjectFolders -%}
              {%- set scFSysSubjFoldersConvs = repliesMap[[scFSysSubjFoldersPath, uuids.scFSysSubjFoldersYesAUuid, uuids.scFSysSubjFoldersConvsQUuid]|reply_path]|reply_str_value -%}
              <li>
                <div{% if scFSysSubjFoldersConvs|trim %} class="answer-lead"{% endif %}>{{ pgettext("questions/03-docs-metadata", "<p style=\"margin:0\">There will be a <strong>folder for each sample/subject</strong>.</p>") }}</div>
                {% if scFSysSubjFoldersConvs|trim %}
                  <div class="answer-detail"><div class="answer-lead">{{ pgettext("questions/03-docs-metadata", "<p>Each of those will use the following conventions:</p>") }}</div>{{ answerMarkdown.markdown(scFSysSubjFoldersConvs) }}</div>
                {%- endif -%}
              </li>
            {%- endif -%}
            {%- if analysisFolders -%}
              {%- set scFSysAnalysisFoldersConvs = repliesMap[[scFSysAnalysisFoldersPath, uuids.scFSysAnalysisFoldersYesAUuid, uuids.scFSysAnalysisFoldersConvsQUuid]|reply_path]|reply_str_value -%}
              <li>
                <div{% if scFSysAnalysisFoldersConvs|trim %} class="answer-lead"{% endif %}>{{ pgettext("questions/03-docs-metadata", "<p style=\"margin:0\">There will be  a <strong>(sub)folder for each (repeated) analysis</strong>. </p>") }}</div>
                {% if scFSysAnalysisFoldersConvs|trim %}
                  <div class="answer-detail"><div class="answer-lead">{{ pgettext("questions/03-docs-metadata", "<p>Each of those will use the following conventions:</p>") }}</div>{{ answerMarkdown.markdown(scFSysAnalysisFoldersConvs) }}</div>
                {%- endif -%}
              </li>
            {%- endif -%}
            {%- if workflowStepFolders -%}
              {%- set scFSysWorkflowStepFoldersConvs = repliesMap[[scFSysWorkflowStepFoldersPath, uuids.scFSysWorkflowStepFoldersYesAUuid, uuids.scFSysWorkflowStepFoldersConvsQUuid]|reply_path]|reply_str_value -%}
              <li>
                <div{% if scFSysWorkflowStepFoldersConvs|trim %} class="answer-lead"{% endif %}>{{ pgettext("questions/03-docs-metadata", "<p style=\"margin:0\">There will be a <strong>(sub)folder for each step in the analysis workflow</strong>.</p>") }}</div>
                {% if scFSysWorkflowStepFoldersConvs|trim %}
                  <div class="answer-detail"><div class="answer-lead">{{ pgettext("questions/03-docs-metadata", "<p>Each of those will use the following conventions:</p>") }}</div>{{ answerMarkdown.markdown(scFSysWorkflowStepFoldersConvs) }}</div>
                {%- endif -%}
              </li>
            {%- endif -%}
          </ul>
        {%- else -%}
          <p>{{ pgettext("questions/03-docs-metadata", "We will use a filesystem with files and folders.") }}</p>
        {%- endif -%}
        {# Versioning #}
        {%- set scDocumentVersioningParts = [uuids.processingCUuid, uuids.storageConvQUuid, uuids.storageConvExploreAUuid, uuids.storageConvFSysQUuid, uuids.storageConvFSysYesAUuid, uuids.scDocumentVersioningQUuid] -%}
        {%- set scDocumentVersioningPath = activeAnswer.path(scDocumentVersioningParts, 'OptionsQuestion') if km is defined else scDocumentVersioningParts|reply_path -%}
        {%- set scDocumentVersioningAUuid = repliesMap[scDocumentVersioningPath]|reply_str_value if scDocumentVersioningPath else '' -%}
        {%- if km is defined and scDocumentVersioningPath and (scDocumentVersioningAUuid not in km.entities.questions[uuids.scDocumentVersioningQUuid].answerUuids or scDocumentVersioningAUuid not in km.entities.answers) -%}
          {%- set scDocumentVersioningAUuid = '' -%}
        {%- endif -%}
        {%- if scDocumentVersioningAUuid == uuids.scDocumentVersioningYesAUuid %}
          <p>{{ pgettext("questions/03-docs-metadata", "We document how we manage file versioning for files and folders.") }}</p>
        {%- elif scDocumentVersioningAUuid == uuids.scDocumentVersioningNoAUuid %}
          <p>{{ pgettext("questions/03-docs-metadata", "We have not documented how we manage file versioning for files and folders.") }}</p>
        {%- endif -%}
        {# Other appointments #}
        {%- set scFSysAppointmentsPath = [scFSysPrefix, uuids.scFSysAppointmentsQUuid]|reply_path -%}
        {%- set scFSysAppointments = repliesMap[scFSysAppointmentsPath]|reply_str_value -%}
        {%- if scFSysAppointments|trim %}
          {%- set fileNamingHtml = answerMarkdown.markdown(scFSysAppointments) -%}
          <div class="answer-detail{{ shortNamingClass(fileNamingHtml) }}" data-fact-id="file-naming"><div class="answer-lead"><p>{{ pgettext("questions/03-docs-metadata", "File naming conventions:") }}</p></div><div class="reading-detail" data-reading-detail="file-naming">{{ fileNamingHtml }}</div></div>
        {%- endif -%}
      {%- endif -%}
        </div>
      </div>
      {% endif %}
      {# Object and Document Store #}
      {% if storageConvObjStoreAUuid in [uuids.storageConvObjStoreNoAUuid, uuids.storageConvObjStoreYesAUuid] %}
      <div class="q3-storage-group" data-storage-group="object-store">
        <h5>{{ pgettext("q3-storage-groups", "Object and document storage") }}</h5>
        <div class="dataset-policy">
      {%- if storageConvObjStoreAUuid == uuids.storageConvObjStoreNoAUuid -%}
        <p>{{ pgettext("questions/03-docs-metadata", "We will not be storing data in an \"object/document store\" system.") }}</p>
      {%- elif storageConvObjStoreAUuid == uuids.storageConvObjStoreYesAUuid -%}
        {%- set scObjStoreNamingQUuid = [storageConvObjStorePath, uuids.storageConvObjStoreYesAUuid, uuids.scObjStoreNamingQUuid]|reply_path -%}
