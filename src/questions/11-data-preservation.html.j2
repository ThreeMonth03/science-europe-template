{% import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
<div id="q-data-preservation" class="question">
  <h3>{{ pgettext("questions/11-data-preservation", "11. How will data for preservation be selected, and where will data be preserved long-term (for example a data repository or archive)?") }}</h3>

  <div class="answer">
  {% import 'src/active-answer.j2' as activeAnswer with context %}
  {% set answerContent %}
    {% include 'src/reference-maintenance-plan.html.j2' %}
    {# Produced datasets #}
    {%- set producedDataPath = [uuids.preservingCUuid, uuids.producedDataQUuid]|reply_path -%}
    {%- set producedDataItems = repliesMap[producedDataPath]|reply_items -%}
    {%- set preservationRecords = [] -%}
    {%- set preservationGroups = {} -%}
    {%- if producedDataItems|length > 0 -%}
      {%- for i in producedDataItems -%}
        {%- set repositoryDatasetIndex = loop.index -%}
        {%- set pathPrefix = [producedDataPath, i]|reply_path -%}
        {%- set producedDataName = repliesMap[[pathPrefix, uuids.producedDataNameQUuid]|reply_path]|reply_str_value -%}
        {# These values are shared by the three captures and the identity check;
           assignments inside a captured block do not escape its Jinja scope. #}
        {%- set isPublishedDataPath = [pathPrefix, uuids.isPublishedDataQUuid]|reply_path -%}
        {%- set isPublishedDataAUuid = repliesMap[isPublishedDataPath]|reply_str_value -%}
        {%- set publishedDataHowLongPath = [pathPrefix, uuids.publishedDataHowLongQUuid]|reply_path -%}
        {%- set publishedDataHowLongAUuid = repliesMap[publishedDataHowLongPath]|reply_str_value -%}
        {%- set publishedDataMetadataPersistentPath = activeAnswer.path([uuids.preservingCUuid, uuids.producedDataQUuid, i, uuids.publishedDataMetadataPersistentQUuid], 'OptionsQuestion') -%}
        {%- set publishedDataMetadataPersistentAUuid = repliesMap[publishedDataMetadataPersistentPath]|reply_str_value -%}
        {%- set publishedDataCataloguePath = activeAnswer.path([uuids.preservingCUuid, uuids.producedDataQUuid, i, uuids.isPublishedDataQUuid, uuids.isPublishedDataYesAUuid, uuids.publishedDataCatalogueQUuid], 'OptionsQuestion') -%}
        {%- set publishedDataCatalogueAUuid = repliesMap[publishedDataCataloguePath]|reply_str_value -%}
        {% set preservationContext %}
          {# One owned prose run for dataset context and preservation arrangements.
             Authored answer-detail and reading-gap blocks remain hard boundaries. #}
          {% include "src/preservation-dataset.html.j2" %}
        {% endset %}
        {% set preservationPolicy %}
          {# If will be published #}
          {% if isPublishedDataAUuid == uuids.isPublishedDataNoAUuid %}
            <p>{{ pgettext("questions/11-data-preservation", "This dataset will not be published.") }}</p>
            {% include "src/preservation-publication-reason.html.j2" %}
          {% elif isPublishedDataAUuid == uuids.isPublishedDataYesAUuid %}
            <p>{{ pgettext("questions/11-data-preservation", "This dataset will be published.") }}</p>
          {% else %}
            <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="preservation-publication-decision" data-status="missing">{{ pgettext("questions/11-data-preservation", "It has not yet been specified whether this dataset will be published.") }}</p>{% endif %}</div>
          {% endif -%}
          {# How long will be stored + Metadata FAIRness #}
            {% if publishedDataHowLongAUuid == uuids.publishedDataHowLongTechnicalAUuid -%}
              <p>{{ gettext("This data set will be kept available as long as technically possible.") }}</p>
            {%- elif publishedDataHowLongAUuid == uuids.publishedDataHowLongDeletedAUuid -%}
              <p> {{ gettext("This data set will be kept available until it needs to be deleted for legal, contractual or regulatory reasons.") }}</p>
            {%- elif publishedDataHowLongAUuid == uuids.publishedDataHowLongFixedAUuid -%}
              {%- set publishedDataHowLongFixedPath = [publishedDataHowLongPath, uuids.publishedDataHowLongFixedAUuid, uuids.publishedDataHowLongFixedQUuid]|reply_path -%}
              {%- set publishedDataHowLongFixed = repliesMap[publishedDataHowLongFixedPath]|reply_str_value -%}
              {% if publishedDataHowLongFixed|trim %}
                <p>{{ gettext("Retention period (prepaid): %(period)s.", period=publishedDataHowLongFixed|e) }}</p>
              {% else %}
                <p>{{ gettext("This data set will be kept available for a fixed period (prepaid).") }}</p>
              {% endif %}
              {% if not publishedDataHowLongFixed|trim %}
                <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="retention-period" data-status="missing-output">{{ gettext("The retention period has not been provided.") }}</p>{% endif %}</div>
              {% elif (publishedDataHowLongFixed|string|trim).replace('.', '', 1).isdigit() %}
                <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="retention-period" data-status="needs-review">{{ gettext("Please specify a time unit for the retention period.") }}</p>{% endif %}</div>
              {% endif %}
              {% if repliesMap[[uuids.preservingCUuid, uuids.repoChargesQUuid]|reply_path]|reply_str_value == uuids.repoChargesNoAUuid %}
                <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="retention-payment" data-status="needs-review">{{ gettext("Please check how the prepaid retention period relates to the answer that repository services have no charges.") }}</p>{% endif %}</div>
              {% endif %}
            {%- endif -%}
          {%- if publishedDataMetadataPersistentPath and publishedDataMetadataPersistentAUuid in km.entities.questions[uuids.publishedDataMetadataPersistentQUuid].answerUuids and publishedDataMetadataPersistentAUuid in km.entities.answers %}
            {%- if publishedDataMetadataPersistentAUuid == uuids.publishedDataMetadataPersistentYesAUuid %}
              <p data-fact-id="preservation-metadata-persistence" data-status="complete">{{ pgettext("questions/11-data-preservation", "The metadata will be available even when the data no longer exists.") }}</p>
            {%- elif publishedDataMetadataPersistentAUuid == uuids.publishedDataMetadataPersistentNoAUuid %}
              <p data-fact-id="preservation-metadata-persistence" data-status="explicit-no">{{ pgettext("questions/11-data-preservation", "The metadata will not remain available once the data no longer exists.") }}</p>
            {%- endif -%}
          {%- endif -%}
          {# Catalogue decisions are fixed prose in the same preservation summary,
             not a detached paragraph after repository or authored detail blocks. #}
          {%- if publishedDataCataloguePath and publishedDataCatalogueAUuid in km.entities.questions[uuids.publishedDataCatalogueQUuid].answerUuids and publishedDataCatalogueAUuid in km.entities.answers -%}
            {%- if publishedDataCatalogueAUuid == uuids.publishedDataCatalogueYesAUuid -%}
              <p data-fact-id="preservation-catalogue" data-status="complete">{{ pgettext("questions/11-data-preservation", "We will add a reference to the published data in at least one data catalogue.") }}</p>
            {%- elif publishedDataCatalogueAUuid == uuids.publishedDataCatalogueNoAUuid -%}
              <p data-fact-id="preservation-catalogue" data-status="explicit-no">{{ pgettext("questions/11-data-preservation", "We will not add a reference to the published data in a data catalogue.") }}</p>
            {%- elif publishedDataCatalogueAUuid == uuids.publishedDataCataloguePrimeAUuid -%}
              <p data-fact-id="preservation-catalogue" data-status="explicit-no">{{ pgettext("questions/11-data-preservation", "We will not add a separate data catalogue reference because the repository is the main source of reusable data in this field.") }}</p>
            {%- endif -%}
          {%- endif -%}
        {% endset %}
        {% set preservationTail %}
          {% include "src/preservation-paper.html.j2" %}
           {# Distributions #}
          {% set distrosPath = [isPublishedDataPath, uuids.isPublishedDataYesAUuid, uuids.publishedDistrosQUuid]|reply_path -%}
          {%- set distrosItems = repliesMap[distrosPath]|reply_items -%}
          {%- if isPublishedDataAUuid == uuids.isPublishedDataYesAUuid and distrosItems|length > 0 -%}
            {% set repositoryReading = namespace(simple=true) %}
            {% set repositoryItems %}
            {%- for j in distrosItems -%}
              {%- set distroPrefix = [distrosPath, j]|reply_path -%}
              {%- set distroRepositoryKindPath = [distroPrefix, uuids.publishedDataRepositoryKindQUuid]|reply_path -%}
              {%- set distroRepositoryKindAUuid = repliesMap[distroRepositoryKindPath]|reply_str_value -%}
              {%- set domainSpecificRepoContactBeforePath = [distroRepositoryKindPath, uuids.publishedDataRepositoryDomainSpecificAUuid, uuids.domainSpecificRepoContactBeforeQUuid]|reply_path -%}
              {%- set domainSpecificRepoContactBeforeAUuid = repliesMap[domainSpecificRepoContactBeforePath]|reply_str_value -%}
              {%- set repositoryOtherContact = distroRepositoryKindAUuid == uuids.publishedDataRepositoryDomainSpecificAUuid and domainSpecificRepoContactBeforeAUuid == uuids.domainSpecificRepoContactBeforeOtherAUuid -%}
              {# A missing/unknown destination has only a review diagnostic here.
                 Omit the whole submission row, not just its text; use the original
                 loop index for surviving labels and Q10 contact anchors. #}
              {%- set repositoryKnown = distroRepositoryKindAUuid in [uuids.publishedDataRepositoryDomainSpecificAUuid, uuids.publishedDataRepositoryGeneralPurposeAUuid, uuids.publishedDataRepositoryNationalAUuid, uuids.publishedDataRepositoryInstitutionalAUuid, uuids.publishedDataRepositorySpecialAUuid] -%}
              {% if repositoryKnown or output_profile|default('review') != 'submission' %}
                <li class="repository-distribution" data-item-id="{{ j }}">
                  {% if repositoryOtherContact %}<div class="answer-lead repository-contact-heading"><p>{% endif %}
                  {% if distrosItems|length > 1 %}{{ pgettext("questions/11-data-preservation", "<span class=\"repository-label\">Distribution %(loop_index)s:</span>", loop_index=loop.index) }} {% endif %}
                  {%- if distroRepositoryKindAUuid == uuids.publishedDataRepositoryDomainSpecificAUuid %}{{ pgettext("questions/11-data-preservation", "Domain-specific repository") }}{%- set domainSpecificRepoNamePath = [distroRepositoryKindPath, uuids.publishedDataRepositoryDomainSpecificAUuid, uuids.domainSpecificRepoNameQUuid]|reply_path -%}
                    {%- set domainSpecificRepoNameReply = repliesMap[domainSpecificRepoNamePath] -%}
                    {%- if macros.integrationFairSharing(domainSpecificRepoNameReply)|striptags|trim -%}
                              {{ pgettext("questions/11-data-preservation", ": ") }}{{ macros.integrationFairSharing(domainSpecificRepoNameReply) }}{{ pgettext("questions/11-data-preservation", ".") }}
                            {%- else -%}{{ pgettext("questions/11-data-preservation", ".") }}
                    {% endif -%}
                    {% if repositoryOtherContact %}</p></div>{% endif %}
                    {#- Contact the repository #}
                    {%- set repositorySentenceSeparator = "" if document_language|default('en') == 'zh-Hant' else " " -%}
                    {%- if domainSpecificRepoContactBeforeAUuid == uuids.domainSpecificRepoContactBeforeNoAUuid -%}
                      {{ repositorySentenceSeparator }}{{ pgettext("questions/11-data-preservation", "We do not need to contact the repository in advance because depositing data there is routine for us.") }}
                    {%- elif domainSpecificRepoContactBeforeAUuid == uuids.domainSpecificRepoContactBeforeYesAlreadyAUuid -%}
                      {{ repositorySentenceSeparator }}{{ pgettext("questions/11-data-preservation", "We have already contacted the repository.") }}
                    {%- elif domainSpecificRepoContactBeforeAUuid == uuids.domainSpecificRepoContactBeforeYesWillAUuid -%}
                      {{ repositorySentenceSeparator }}{{ pgettext("questions/11-data-preservation", "We are going to contact the repository.") }}
                    {%- elif domainSpecificRepoContactBeforeAUuid == uuids.domainSpecificRepoContactBeforeOtherAUuid %}
                      {%- set repositoryReading.simple = false -%}
                      {%- set domainSpecificRepoContactBeforeOtherPath = [domainSpecificRepoContactBeforePath, uuids.domainSpecificRepoContactBeforeOtherAUuid, uuids.domainSpecificRepoContactBeforeOtherQUuid]|reply_path -%}
                      {%- set domainSpecificRepoContactBeforeOther = repliesMap[domainSpecificRepoContactBeforeOtherPath]|reply_str_value %}
                      <div class="repository-contact" id="repository-contact-{{ repositoryDatasetIndex }}-{{ loop.index }}">
                        {% if domainSpecificRepoContactBeforeOther|trim %}
                          <div class="answer-lead">{{ pgettext("questions/11-data-preservation", "<p>Other repository contact arrangements:</p>") }}</div>
                          <div class="answer-detail" data-fact-id="repository-contact-arrangements" data-status="complete">{{ answerMarkdown.markdown(domainSpecificRepoContactBeforeOther) }}</div>
                        {% else %}
                          {%- set activeContactPath = activeAnswer.path(domainSpecificRepoContactBeforePath.split('.'), 'OptionsQuestion') if km is defined else domainSpecificRepoContactBeforePath -%}
                          {%- if activeContactPath and (km is not defined or (domainSpecificRepoContactBeforeAUuid in km.entities.questions[uuids.domainSpecificRepoContactBeforeQUuid].answerUuids and domainSpecificRepoContactBeforeAUuid in km.entities.answers)) and (repliesMap[domainSpecificRepoContactBeforePath].value is not defined or repliesMap[domainSpecificRepoContactBeforePath].value.type is not defined or repliesMap[domainSpecificRepoContactBeforePath].value.type == 'AnswerReply') -%}
                            {{ pgettext("questions/11-data-preservation", "<p data-fact-id=\"repository-contact-arrangements\" data-status=\"complete\">Other arrangements have been made for contacting the repository.</p>") }}
                          {%- endif -%}
                          {% if output_profile|default('review') != 'submission' %}{{ pgettext("questions/11-data-preservation", "<p class=\"data-gap\" data-fact-id=\"repository-contact-arrangements\" data-status=\"missing\">The other repository contact arrangements have not been described.</p>") }}{% endif %}
                        {% endif %}
                      </div>
                    {%- endif -%}
                  {%- elif distroRepositoryKindAUuid == uuids.publishedDataRepositoryGeneralPurposeAUuid %}{{ pgettext("questions/11-data-preservation", "<em>General-purpose repository</em>") }}{%- set generalPurposeRepoNamePath = [distroRepositoryKindPath, uuids.publishedDataRepositoryGeneralPurposeAUuid, uuids.generalPurposeRepoNameQUuid]|reply_path -%}
                    {%- set generalPurposeRepoNameReply = repliesMap[generalPurposeRepoNamePath] -%}
                    {%- if macros.integrationFairSharing(generalPurposeRepoNameReply)|striptags|trim -%}
                              {{ pgettext("questions/11-data-preservation", ": ") }}{{ macros.integrationFairSharing(generalPurposeRepoNameReply) }}{{ pgettext("questions/11-data-preservation", ".") }}
                            {%- else -%}{{ pgettext("questions/11-data-preservation", ". ") -}}
                    {% endif -%}
                  {%- elif distroRepositoryKindAUuid == uuids.publishedDataRepositoryNationalAUuid %}
                    {{ pgettext("questions/11-data-preservation", "Our national repository.") }}
                  {%- elif distroRepositoryKindAUuid == uuids.publishedDataRepositoryInstitutionalAUuid %}
                    {{ pgettext("questions/11-data-preservation", "Our institutional repository.") }}
                  {%- elif distroRepositoryKindAUuid == uuids.publishedDataRepositorySpecialAUuid %}
                    {%- include 'src/repository-special.html.j2' with context -%}
                  {%- elif distroRepositoryKindAUuid %}
                    {{ pgettext("questions/11-data-preservation", "<span data-requirement-id=\"SE-5b\" data-fact-id=\"repository-destination\" data-status=\"needs-review\">The selected repository type cannot be described by this template.</span>") }}
                  {%- else %}
                    {{ pgettext("questions/11-data-preservation", "<span data-requirement-id=\"SE-5b\" data-fact-id=\"repository-destination\" data-status=\"missing\">The repository for this distribution has not been specified.</span>") }}
                  {%- endif -%}
                </li>
              {% endif %}
            {%- endfor -%}
            {% endset %}
            {# Only bounded inline repository summaries, never authored blocks. #}
            {% for fragment in repositoryItems.split('<')[1:] %}
              {% if fragment.split('>')[0].split(' ')[0] not in ['li', '/li', 'span', '/span', 'strong', '/strong', 'em', '/em', 'a', '/a'] %}
                {% set repositoryReading.simple = false %}
              {% endif %}
            {% endfor %}
            {% set repositoryText = (repositoryItems|striptags).split()|join(' ') %}
            {% if repositoryText %}
            <div class="repository-destinations{{ ' short-repository-list' if repositoryReading.simple and distrosItems|length <= 3 and repositoryText|length <= 900 else '' }}">
              <div class="answer-lead"><p>{{ pgettext("questions/11-data-preservation", "Preservation destinations by distribution:") }}</p></div>
              <ul>{{ repositoryItems }}</ul>
            </div>
            {% endif %}
          {%- endif -%}
        {% endset %}
        {# Share only complete, active fixed choices. Never use rendered text,
           names, descriptions or repository/contact answers as an identity key.
           Custom periods, nonpublication reasons and missing/unknown states
           retain their original per-record policy and review notices. #}
        {% set durationActivePath = activeAnswer.path([uuids.preservingCUuid, uuids.producedDataQUuid, i, uuids.publishedDataHowLongQUuid], 'OptionsQuestion') %}
        {% set policyKey = '' %}
        {% if isPublishedDataAUuid == uuids.isPublishedDataYesAUuid and durationActivePath and
              publishedDataHowLongAUuid in [uuids.publishedDataHowLongTechnicalAUuid, uuids.publishedDataHowLongDeletedAUuid] and
              publishedDataHowLongAUuid in km.entities.questions[uuids.publishedDataHowLongQUuid].answerUuids and
              publishedDataHowLongAUuid in km.entities.answers and
              publishedDataMetadataPersistentPath and publishedDataMetadataPersistentAUuid in [uuids.publishedDataMetadataPersistentYesAUuid, uuids.publishedDataMetadataPersistentNoAUuid] and
              publishedDataMetadataPersistentAUuid in km.entities.questions[uuids.publishedDataMetadataPersistentQUuid].answerUuids and
              publishedDataMetadataPersistentAUuid in km.entities.answers and
              publishedDataCataloguePath and publishedDataCatalogueAUuid in [uuids.publishedDataCatalogueYesAUuid, uuids.publishedDataCatalogueNoAUuid, uuids.publishedDataCataloguePrimeAUuid] and
              publishedDataCatalogueAUuid in km.entities.questions[uuids.publishedDataCatalogueQUuid].answerUuids and
              publishedDataCatalogueAUuid in km.entities.answers %}
          {% set policyKey = [isPublishedDataAUuid, publishedDataHowLongAUuid, publishedDataMetadataPersistentAUuid, publishedDataCatalogueAUuid]|join(':') %}
        {% endif %}
        {% set record = {'id': i, 'index': repositoryDatasetIndex, 'name': producedDataName, 'context': preservationContext, 'policy': preservationPolicy, 'tail': preservationTail, 'key': policyKey} %}
        {% do preservationRecords.append(record) %}
        {% if policyKey %}
          {% if policyKey not in preservationGroups %}{% do preservationGroups.update({policyKey: {'members': [], 'policy': preservationPolicy, 'number': 0}}) %}{% endif %}
          {% do preservationGroups[policyKey].members.append(record) %}
        {% endif %}
      {%- endfor -%}
      {# Three or more repetitions justify a common block and explicit references.
         Record order and original list ordinals do not change. #}
      {% set sharedPolicies = namespace(count=0) %}
      {% for group in preservationGroups.values() %}
        {% if group.members|length >= 3 %}
          {% set sharedPolicies.count = sharedPolicies.count + 1 %}
          {% do group.update({'number': sharedPolicies.count}) %}
        {% endif %}
      {% endfor %}
      {# Explain common policies before individual records refer to them. #}
      {% for group in preservationGroups.values() %}
        {% if group.number %}
        {% set policyMemberIndices = group.members|map(attribute='index')|join('、' if document_language|default('en') == 'zh-Hant' else ', ') %}
        <div class="preservation-shared-policy" id="preservation-policy-{{ group.number }}" data-member-ids="{{ group.members|map(attribute='id')|join(' ') }}">
          <h4>{{ pgettext("questions/11-data-preservation", "Shared preservation policy %(group_number)s", group_number=group.number) }}</h4>
          <div class="answer-lead"><p>{{ pgettext("questions/11-data-preservation", "This policy applies separately to produced datasets %(policyMemberIndices)s.", policyMemberIndices=policyMemberIndices) }}</p></div>
          <div class="dataset-policy">{{ group.policy }}</div>
        </div>
        {% endif %}
      {% endfor %}
      {% for record in preservationRecords %}
        {% set group = preservationGroups[record.key] if record.key else none %}
        {% set recordContent = record.context ~ record.policy ~ record.tail %}
        {% if output_profile|default('review') != 'submission' or recordContent|striptags|trim or '<img' in recordContent or '<table' in recordContent %}
        {% set displayedPolicy %}{% if group and group.number %}
          {% set policyReference %}<a href="#preservation-policy-{{ group.number }}">{{ pgettext("questions/11-data-preservation", "Shared preservation policy %(group_number)s", group_number=group.number) }}</a>{% endset %}
          <p class="preservation-policy-reference">{{ pgettext("questions/11-data-preservation", "Preservation policy: see %(policyReference)s.", policyReference=policyReference) }}</p>
        {% else %}{{ record.policy }}{% endif %}{% endset %}
        {% set displayedRecord = record.context ~ displayedPolicy ~ record.tail %}
        {% set datasetHeading %}{% if sharedPolicies.count %}{{ macros.datasetLabel(macros.DATASET_PRODUCED, record.index) }}{% if record.name|trim %}{{ pgettext("questions/11-data-preservation", ": ") }}{{ record.name|e }}{% elif output_profile|default('review') != 'submission' %}{{ pgettext("questions/11-data-preservation", ": (no name given)") }}{% endif %}{% elif output_profile|default('review') == 'submission' and not record.name|trim %}{{ macros.datasetLabel(macros.DATASET_PRODUCED, record.index) }}{% else %}{{ record.name|e if record.name|trim else pgettext("questions/11-data-preservation", "(no name given)") }}{% endif %}{% endset %}
        {% set shortRecord = macros.shortDatasetRecord(displayedRecord, datasetHeading) and '<ul' not in record.context|lower and displayedRecord.lower().count('<ul') <= 1 and ('<ul' not in record.tail|lower or 'short-repository-list' in record.tail) %}
        <div class="dataset-section{{ ' short-dataset-record' if shortRecord else '' }}" data-item-id="{{ record.id }}">
          <h5>{{ datasetHeading }}</h5>
          <div class="preservation-summary dataset-policy">
            {{ record.context }}
            {{ displayedPolicy }}
          </div>
          {{ record.tail }}
        </div>
        {% endif %}
      {% endfor %}
    {%- endif -%}
    {% set archiveChoice = repliesMap[[uuids.preservingCUuid, uuids.archivedAfterQUuid]|reply_path]|reply_str_value %}
    {% set resourceContent %}
    <div class="preservation-resources dataset-policy">
    {# Repository charges #}
    {%- set repoChargesParts = [uuids.preservingCUuid, uuids.repoChargesQUuid] -%}
    {%- set repoChargesPath = activeAnswer.path(repoChargesParts, 'OptionsQuestion') if km is defined else repoChargesParts|reply_path -%}
    {%- set repoChargesAUuid = repliesMap[repoChargesPath]|reply_str_value if repoChargesPath else '' -%}
    {%- if km is defined and repoChargesPath and (repoChargesAUuid not in km.entities.questions[uuids.repoChargesQUuid].answerUuids or repoChargesAUuid not in km.entities.answers) -%}
      {%- set repoChargesAUuid = '' -%}
    {%- endif -%}
    {%- if repoChargesAUuid == uuids.repoChargesNoAUuid -%}
      <p>{{ pgettext("questions/11-data-preservation", "The repositories we use do not charge for their services.") }}</p>
    {%- elif repoChargesAUuid == uuids.repoChargesYesAUuid -%}
      {%- set repoChargesHowPayParts = [uuids.preservingCUuid, uuids.repoChargesQUuid, uuids.repoChargesYesAUuid, uuids.repoChargesHowPayQUuid] -%}
      {%- set repoChargesHowPayPath = activeAnswer.path(repoChargesHowPayParts, 'OptionsQuestion') if km is defined else repoChargesHowPayParts|reply_path -%}
      {%- set repoChargesHowPayAUuid = repliesMap[repoChargesHowPayPath]|reply_str_value if repoChargesHowPayPath else '' -%}
      {%- if km is defined and repoChargesHowPayPath and (repoChargesHowPayAUuid not in km.entities.questions[uuids.repoChargesHowPayQUuid].answerUuids or repoChargesHowPayAUuid not in km.entities.answers) -%}
        {%- set repoChargesHowPayAUuid = '' -%}
      {%- endif -%}
      {%- if repoChargesHowPayAUuid == uuids.repoChargesHowPayBudgetedAUuid -%}
        <p>{{ pgettext("questions/11-data-preservation", "The project budget includes the repository service fees.") }}</p>
      {%- elif repoChargesHowPayAUuid == uuids.repoChargesHowPayDepartmentAUuid -%}
        <p>{{ pgettext("questions/11-data-preservation", "A participating department will cover the repository service fees.") }}</p>
      {%- elif repoChargesHowPayAUuid == uuids.repoChargesHowPayInstituteAUuid -%}
        <p>{{ pgettext("questions/11-data-preservation", "A participating institute will cover the repository service fees.") }}</p>
      {%- elif repoChargesHowPayAUuid == uuids.repoChargesHowPayOtherAUuid -%}
        {%- set repoChargesHowPayOtherParts = [uuids.preservingCUuid, uuids.repoChargesQUuid, uuids.repoChargesYesAUuid, uuids.repoChargesHowPayQUuid, uuids.repoChargesHowPayOtherAUuid, uuids.repoChargesHowPayOtherQUuid] -%}
        {%- set repoChargesHowPayOtherPath = activeAnswer.path(repoChargesHowPayOtherParts, 'ValueQuestion') if km is defined else repoChargesHowPayOtherParts|reply_path -%}
        {%- set repoChargesHowPayOther = repliesMap[repoChargesHowPayOtherPath]|reply_str_value if repoChargesHowPayOtherPath else '' -%}
        {%- if repoChargesHowPayOther|trim -%}
          <div class="answer-lead"><p>{{ pgettext("questions/11-data-preservation", "Other arrangements for paying repository costs:") }}</p></div>
          <div class="answer-detail">{{ answerMarkdown.markdown(repoChargesHowPayOther) }}</div>
        {%- else -%}
          <p>{{ pgettext("questions/11-data-preservation", "Other arrangements are planned for paying repository service fees.") }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {# Budget time and effort #}
    {%- set budgetTimeEffortParts = [uuids.preservingCUuid, uuids.budgetTimeEffortQUuid] -%}
    {%- set budgetTimeEffortPath = activeAnswer.path(budgetTimeEffortParts, 'OptionsQuestion') if km is defined else budgetTimeEffortParts|reply_path -%}
    {%- set budgetTimeEffortAUuid = repliesMap[budgetTimeEffortPath]|reply_str_value if budgetTimeEffortPath else '' -%}
    {%- if km is defined and budgetTimeEffortPath and (budgetTimeEffortAUuid not in km.entities.questions[uuids.budgetTimeEffortQUuid].answerUuids or budgetTimeEffortAUuid not in km.entities.answers) -%}
      {%- set budgetTimeEffortAUuid = '' -%}
    {%- endif -%}
    {%- if budgetTimeEffortAUuid == uuids.budgetTimeEffortYesAUuid -%}
      <p>{{ pgettext("questions/11-data-preservation", "We have allocated funds for the time and effort needed to prepare the data for publication.") }}</p>
      {%- set budgetTimeEffortAmountParts = [uuids.preservingCUuid, uuids.budgetTimeEffortQUuid, uuids.budgetTimeEffortYesAUuid, uuids.budgetTimeEffortAmountQUuid] -%}
      {%- set budgetTimeEffortAmountPath = activeAnswer.path(budgetTimeEffortAmountParts, 'ValueQuestion') if km is defined else budgetTimeEffortAmountParts|reply_path -%}
      {%- set budgetTimeEffortAmount = repliesMap[budgetTimeEffortAmountPath]|reply_str_value if budgetTimeEffortAmountPath else '' -%}
      {%- if budgetTimeEffortAmount|trim -%}
        <div class="answer-lead"><p>{{ pgettext("questions/11-data-preservation", "Budget for making data or other research outputs FAIR:") }}</p></div>
        <div class="answer-detail" data-fact-id="preparation-budget-amount" data-status="complete">{{ budgetTimeEffortAmount|markdown }}</div>
      {%- endif -%}
    {%- elif budgetTimeEffortAUuid == uuids.budgetTimeEffortNoAUuid -%}
      <p>{{ pgettext("questions/11-data-preservation", "We have not budgeted for the time and effort needed to prepare the data for publication.") }}</p>
    {%- endif -%}
    </div>
    {% endset %}
    {% if resourceContent|striptags|trim or '<img' in resourceContent or '<table' in resourceContent %}
      {% if (sharedPolicies is defined and sharedPolicies.count) or archiveChoice in [uuids.archivedAfterYesAUuid, uuids.archivedAfterNoAUuid] %}
        <h4>{{ pgettext("questions/11-data-preservation", "Repository costs and publication preparation") }}</h4>
      {% endif %}
      {{ resourceContent }}
    {% endif %}
    {% include "src/post-project-archive.html.j2" %}
  {% endset %}
  {% if answerContent|striptags|trim or '<img' in answerContent or '<table' in answerContent %}
    {{ answerContent }}
    {%- if output_profile|default('review') != 'submission' -%}
    <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-5b" data-fact-id="preservation-selection-review" data-status="needs-review">{{ pgettext("questions/11-data-preservation", "Preservation selection still requires review: publication decisions and archive renewal criteria do not by themselves explain which datasets and versions must be retained or destroyed.") }}</p>{% endif %}</div>
    {%- endif -%}
  {% else %}
    {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-5b" data-status="missing-output">{{ pgettext("questions/11-data-preservation", "This document does not yet contain an answer about data selection and long-term preservation.") }}</p>{% endif %}
  {% endif %}
  </div>
</div>
