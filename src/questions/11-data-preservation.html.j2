<div id="q-data-preservation" class="question">
  <h3>11. How will data for preservation be selected, and where will data be preserved long-term (for example a data repository or archive)?</h3>

  <div class="answer">
  {% set answerContent %}
    {% include 'src/reference-maintenance-plan.html.j2' %}
    {# Produced datasets #}
    {%- set producedDataPath = [uuids.preservingCUuid, uuids.producedDataQUuid]|reply_path -%}
    {%- set producedDataItems = repliesMap[producedDataPath]|reply_items -%}
    {%- if producedDataItems|length > 0 -%}
      {%- for i in producedDataItems -%}
        {%- set repositoryDatasetIndex = loop.index -%}
        {%- set pathPrefix = [producedDataPath, i]|reply_path -%}
        {%- set producedDataName = repliesMap[[pathPrefix, uuids.producedDataNameQUuid]|reply_path]|reply_str_value -%}
        {% set preservationDatasetContent %}
          <div class="preservation-summary dataset-policy">
          {# One owned prose run for dataset context and preservation arrangements.
             Authored answer-detail and reading-gap blocks remain hard boundaries. #}
          {% include "src/preservation-dataset.html.j2" %}
          {# If will be published #}
          {%- set isPublishedDataPath = [pathPrefix, uuids.isPublishedDataQUuid]|reply_path -%}
          {%- set isPublishedDataAUuid = repliesMap[isPublishedDataPath]|reply_str_value -%}
          {% if isPublishedDataAUuid == uuids.isPublishedDataNoAUuid %}
            <p>This dataset will not be published.</p>
            {% include "src/preservation-publication-reason.html.j2" %}
          {% elif isPublishedDataAUuid == uuids.isPublishedDataYesAUuid %}
            <p>This dataset will be published.</p>
          {% else %}
            <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="preservation-publication-decision" data-status="missing">It has not yet been specified whether this dataset will be published.</p>{% endif %}</div>
          {% endif -%}
          {# How long will be stored + Metadata FAIRness #}
          {%- set publishedDataHowLongPath = [pathPrefix, uuids.publishedDataHowLongQUuid]|reply_path -%}
          {%- set publishedDataHowLongAUuid = repliesMap[publishedDataHowLongPath]|reply_str_value -%}
          {%- set publishedDataMetadataPersistentPath = [pathPrefix, uuids.publishedDataMetadataPersistentQUuid]|reply_path -%}
          {%- set publishedDataMetadataPersistentAUuid = repliesMap[publishedDataMetadataPersistentPath]|reply_str_value -%}
          {%- if publishedDataHowLongAUuid or (publishedDataMetadataPersistentAUuid == uuids.publishedDataMetadataPersistentYesAUuid) %}
            {% if publishedDataHowLongAUuid == uuids.publishedDataHowLongTechnicalAUuid -%}
              <p>This data set will be kept available as long as technically possible.</p>
            {%- elif publishedDataHowLongAUuid == uuids.publishedDataHowLongDeletedAUuid -%}
              <p> This data set will be kept available until it needs to be deleted for legal, contractual or regulatory reasons.</p>
            {%- elif publishedDataHowLongAUuid == uuids.publishedDataHowLongFixedAUuid -%}
              {%- set publishedDataHowLongFixedPath = [publishedDataHowLongPath, uuids.publishedDataHowLongFixedAUuid, uuids.publishedDataHowLongFixedQUuid]|reply_path -%}
              {%- set publishedDataHowLongFixed = repliesMap[publishedDataHowLongFixedPath]|reply_str_value -%}
              {% if publishedDataHowLongFixed %}
                <p>Retention period (prepaid): {{ publishedDataHowLongFixed|e }}.</p>
              {% else %}
                <p>This data set will be kept available for a fixed period (prepaid).</p>
              {% endif %}
              {% if not publishedDataHowLongFixed %}
                <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="retention-period" data-status="missing-output">The retention period has not been provided.</p>{% endif %}</div>
              {% elif (publishedDataHowLongFixed|string|trim).replace('.', '', 1).isdigit() %}
                <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="retention-period" data-status="needs-review">Please specify a time unit for the retention period.</p>{% endif %}</div>
              {% endif %}
              {% if repliesMap[[uuids.preservingCUuid, uuids.repoChargesQUuid]|reply_path]|reply_str_value == uuids.repoChargesNoAUuid %}
                <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="retention-payment" data-status="needs-review">Please check how the prepaid retention period relates to the answer that repository services have no charges.</p>{% endif %}</div>
              {% endif %}
            {%- endif -%}
            {%- if publishedDataMetadataPersistentAUuid == uuids.publishedDataMetadataPersistentYesAUuid %}
              <p>The metadata will be available even when the data no longer exists.</p>
            {%- endif -%}
          {%- endif -%}
          </div>
          {% include "src/preservation-paper.html.j2" %}
           {# Distributions #}
          {% set distrosPath = [isPublishedDataPath, uuids.isPublishedDataYesAUuid, uuids.publishedDistrosQUuid]|reply_path -%}
          {%- set distrosItems = repliesMap[distrosPath]|reply_items -%}
          {%- if isPublishedDataAUuid == uuids.isPublishedDataYesAUuid and distrosItems|length > 0 -%}
            {% set repositoryReading = namespace(simple=true) %}
            {% set repositoryItems %}
            {%- for j in distrosItems -%}
              {%- set distroPrefix = [distrosPath, j]|reply_path -%}
              {%- set distroRepositoryKindPath = [distroPrefix, uuids.publishedDataRepositoryKindQUuid]|reply_path -%}
              {%- set distroRepositoryKindAUuid = repliesMap[distroRepositoryKindPath]|reply_str_value -%}
              {%- set domainSpecificRepoContactBeforePath = [distroRepositoryKindPath, uuids.publishedDataRepositoryDomainSpecificAUuid, uuids.domainSpecificRepoContactBeforeQUuid]|reply_path -%}
              {%- set domainSpecificRepoContactBeforeAUuid = repliesMap[domainSpecificRepoContactBeforePath]|reply_str_value -%}
              {%- set repositoryOtherContact = distroRepositoryKindAUuid == uuids.publishedDataRepositoryDomainSpecificAUuid and domainSpecificRepoContactBeforeAUuid == uuids.domainSpecificRepoContactBeforeOtherAUuid -%}
              {# A missing/unknown destination has only a review diagnostic here.
                 Omit the whole submission row, not just its text; use the original
                 loop index for surviving labels and Q10 contact anchors. #}
              {%- set repositoryKnown = distroRepositoryKindAUuid in [uuids.publishedDataRepositoryDomainSpecificAUuid, uuids.publishedDataRepositoryGeneralPurposeAUuid, uuids.publishedDataRepositoryNationalAUuid, uuids.publishedDataRepositoryInstitutionalAUuid, uuids.publishedDataRepositorySpecialAUuid] -%}
              {% if repositoryKnown or output_profile|default('review') != 'submission' %}
                <li class="repository-distribution" data-item-id="{{ j }}">
                  {% if repositoryOtherContact %}<div class="answer-lead repository-contact-heading"><p>{% endif %}
                  {% if distrosItems|length > 1 %}<span class="repository-label">Distribution {{ loop.index }}:</span> {% endif %}
                  {%- if distroRepositoryKindAUuid == uuids.publishedDataRepositoryDomainSpecificAUuid %}Domain-specific repository{%- set domainSpecificRepoNamePath = [distroRepositoryKindPath, uuids.publishedDataRepositoryDomainSpecificAUuid, uuids.domainSpecificRepoNameQUuid]|reply_path -%}
                    {%- set domainSpecificRepoNameReply = repliesMap[domainSpecificRepoNamePath] -%}
                    {%- if domainSpecificRepoNameReply -%}
                      : {{ macros.integrationFairSharing(domainSpecificRepoNameReply) }}.
                    {%- else -%}.
                    {% endif -%}
                    {% if repositoryOtherContact %}</p></div>{% endif %}
                    {# Contact the repository #}
                    {%- if domainSpecificRepoContactBeforeAUuid == uuids.domainSpecificRepoContactBeforeNoAUuid %}
                      We don't need to contact the repository because it is a routine for us.
                    {%- elif domainSpecificRepoContactBeforeAUuid == uuids.domainSpecificRepoContactBeforeYesAlreadyAUuid %}
                      We have already contacted the repository.
                    {%- elif domainSpecificRepoContactBeforeAUuid == uuids.domainSpecificRepoContactBeforeYesWillAUuid %}
                      We are going to contact the repository.
                    {%- elif domainSpecificRepoContactBeforeAUuid == uuids.domainSpecificRepoContactBeforeOtherAUuid %}
                      {%- set repositoryReading.simple = false -%}
                      {%- set domainSpecificRepoContactBeforeOtherPath = [domainSpecificRepoContactBeforePath, uuids.domainSpecificRepoContactBeforeOtherAUuid, uuids.domainSpecificRepoContactBeforeOtherQUuid]|reply_path -%}
                      {%- set domainSpecificRepoContactBeforeOther = repliesMap[domainSpecificRepoContactBeforeOtherPath]|reply_str_value %}
                      <div class="repository-contact" id="repository-contact-{{ repositoryDatasetIndex }}-{{ loop.index }}">
                        {% if domainSpecificRepoContactBeforeOther|trim %}
                          <div class="answer-lead"><p>Other repository contact arrangements:</p></div>
                          <div class="answer-detail" data-fact-id="repository-contact-arrangements" data-status="complete">{{ domainSpecificRepoContactBeforeOther|markdown }}</div>
                        {% else %}
                          {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-fact-id="repository-contact-arrangements" data-status="missing">The other repository contact arrangements have not been described.</p>{% endif %}
                        {% endif %}
                      </div>
                    {%- endif -%}
                  {%- elif distroRepositoryKindAUuid == uuids.publishedDataRepositoryGeneralPurposeAUuid %}<em>General-purpose repository</em>{%- set generalPurposeRepoNamePath = [distroRepositoryKindPath, uuids.publishedDataRepositoryGeneralPurposeAUuid, uuids.generalPurposeRepoNameQUuid]|reply_path -%}
                    {%- set generalPurposeRepoNameReply = repliesMap[generalPurposeRepoNamePath] -%}
                    {%- if generalPurposeRepoNameReply -%}
                      : {{ macros.integrationFairSharing(generalPurposeRepoNameReply) }}.
                    {%- else -%}.
                    {% endif -%}
                  {%- elif distroRepositoryKindAUuid == uuids.publishedDataRepositoryNationalAUuid %}
                    Our national repository.
                  {%- elif distroRepositoryKindAUuid == uuids.publishedDataRepositoryInstitutionalAUuid %}
                    Our institutional repository.
                  {%- elif distroRepositoryKindAUuid == uuids.publishedDataRepositorySpecialAUuid %}
                    {%- include 'src/repository-special.html.j2' with context -%}
                  {%- elif distroRepositoryKindAUuid %}
                    <span data-requirement-id="SE-5b" data-fact-id="repository-destination" data-status="needs-review">The selected repository type cannot be described by this template.</span>
                  {%- else %}
                    <span data-requirement-id="SE-5b" data-fact-id="repository-destination" data-status="missing">The repository for this distribution has not been specified.</span>
                  {%- endif -%}
                </li>
              {% endif %}
            {%- endfor -%}
            {% endset %}
            {# Only bounded inline repository summaries, never authored blocks. #}
            {% for fragment in repositoryItems.split('<')[1:] %}
              {% if fragment.split('>')[0].split(' ')[0] not in ['li', '/li', 'span', '/span', 'strong', '/strong', 'em', '/em', 'a', '/a'] %}
                {% set repositoryReading.simple = false %}
              {% endif %}
            {% endfor %}
            {% set repositoryText = (repositoryItems|striptags).split()|join(' ') %}
            {% if repositoryText %}
            <div class="repository-destinations{{ ' short-repository-list' if repositoryReading.simple and distrosItems|length <= 3 and repositoryText|length <= 900 else '' }}">
              <div class="answer-lead"><p>Preservation destinations by distribution:</p></div>
              <ul>{{ repositoryItems }}</ul>
            </div>
            {% endif %}
          {%- endif -%}
          {# Catalogue #}
          {%- set publishedDataCataloguePath = [isPublishedDataPath, uuids.isPublishedDataYesAUuid, uuids.publishedDataCatalogueQUuid]|reply_path -%}
          {%- set publishedDataCatalogueAUuid = repliesMap[publishedDataCataloguePath]|reply_str_value -%}
          {%- if isPublishedDataAUuid == uuids.isPublishedDataYesAUuid and publishedDataCatalogueAUuid == uuids.publishedDataCatalogueYesAUuid -%}
            <p>We will add a reference to the published data in at least one data catalogue.</p>
          {%- endif -%}
        {% endset %}
        {% if output_profile|default('review') != 'submission' or preservationDatasetContent|striptags|trim or '<img' in preservationDatasetContent or '<table' in preservationDatasetContent %}
        <div class="dataset-section" data-item-id="{{ i }}">
          <h5>{% if output_profile|default('review') == 'submission' and not producedDataName|trim %}{{ macros.datasetLabel(macros.DATASET_PRODUCED, producedDataItems.index(i) + 1) }}{% else %}{{ producedDataName|e if producedDataName|trim else "(no name given)" }}{% endif %}</h5>
          {{ preservationDatasetContent }}
        </div>
        {% endif %}
      {%- endfor -%}
    {%- endif -%}
    {% set archiveChoice = repliesMap[[uuids.preservingCUuid, uuids.archivedAfterQUuid]|reply_path]|reply_str_value %}
    {% set resourceContent %}
    <div class="preservation-resources dataset-policy">
    {# Repository charges #}
    {%- set repoChargesPath = [uuids.preservingCUuid, uuids.repoChargesQUuid]|reply_path -%}
    {%- set repoChargesAUuid = repliesMap[repoChargesPath]|reply_str_value -%}
    {%- if repoChargesAUuid == uuids.repoChargesNoAUuid -%}
      <p>The repositories we use do not charge for their services.</p>
    {%- elif repoChargesAUuid == uuids.repoChargesYesAUuid -%}
      {%- set repoChargesHowPayPath = [repoChargesPath, uuids.repoChargesYesAUuid, uuids.repoChargesHowPayQUuid]|reply_path -%}
      {%- set repoChargesHowPayAUuid = repliesMap[repoChargesHowPayPath]|reply_str_value -%}
      {%- if repoChargesHowPayAUuid == uuids.repoChargesHowPayBudgetedAUuid -%}
        <p>The project budget includes the repository service fees.</p>
      {%- elif repoChargesHowPayAUuid == uuids.repoChargesHowPayDepartmentAUuid -%}
        <p>A participating department will cover the repository service fees.</p>
      {%- elif repoChargesHowPayAUuid == uuids.repoChargesHowPayInstituteAUuid -%}
        <p>A participating institute will cover the repository service fees.</p>
      {%- elif repoChargesHowPayAUuid == uuids.repoChargesHowPayOtherAUuid -%}
        {%- set repoChargesHowPayOtherPath = [repoChargesHowPayPath, uuids.repoChargesHowPayOtherAUuid, uuids.repoChargesHowPayOtherQUuid]|reply_path -%}
        {%- set repoChargesHowPayOther = repliesMap[repoChargesHowPayOtherPath]|reply_str_value -%}
        {%- if repoChargesHowPayOther -%}
          <div class="answer-lead"><p>Other arrangements for paying repository costs:</p></div>
          <div class="answer-detail">{{ repoChargesHowPayOther|markdown }}</div>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {# Budget time and effort #}
    {%- set budgetTimeEffortPath = [uuids.preservingCUuid, uuids.budgetTimeEffortQUuid]|reply_path -%}
    {%- set budgetTimeEffortAUuid = repliesMap[budgetTimeEffortPath]|reply_str_value -%}
    {%- if budgetTimeEffortAUuid == uuids.budgetTimeEffortYesAUuid -%}
      <p>We have allocated funds for the time and effort needed to prepare the data for publication.</p>
    {%- endif -%}
    </div>
    {% endset %}
    {% if resourceContent|striptags|trim or '<img' in resourceContent or '<table' in resourceContent %}
      {% if archiveChoice in [uuids.archivedAfterYesAUuid, uuids.archivedAfterNoAUuid] %}
        <h4>Repository costs and publication preparation</h4>
      {% endif %}
      {{ resourceContent }}
    {% endif %}
    {% include "src/post-project-archive.html.j2" %}
  {% endset %}
  {% if answerContent|striptags|trim or '<img' in answerContent or '<table' in answerContent %}
    {{ answerContent }}
    {%- if output_profile|default('review') != 'submission' -%}
    <div class="reading-gap">{% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-5b" data-fact-id="preservation-selection-review" data-status="needs-review">Preservation selection still requires review: publication decisions and archive renewal criteria do not by themselves explain which datasets and versions must be retained or destroyed.</p>{% endif %}</div>
    {%- endif -%}
  {% else %}
    {% if output_profile|default('review') != 'submission' %}<p class="data-gap" data-requirement-id="SE-5b" data-status="missing-output">This document does not yet contain an answer about data selection and long-term preservation.</p>{% endif %}
  {% endif %}
  </div>
</div>
