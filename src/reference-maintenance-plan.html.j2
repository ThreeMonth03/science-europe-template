{%- import 'src/full-km-followups.j2' as followups with context -%}
{%- import "src/answer-markdown.html.j2" as answerMarkdown with context -%}
{%- set followupPath = followups.active_path(followups.referenceChapter, followups.referenceBranch, followups.maintenanceLeaf) -%}
{%- if followupPath -%}
  {%- set authored = repliesMap[followupPath]|reply_str_value -%}
  {%- if authored|trim -%}
    <div class="dataset-policy reference-maintenance-plan" data-requirement-id="SE-5b">
      <div class="answer-lead"><p>{{ pgettext("reference-maintenance-plan", "Maintenance of reference data created by the project:") }}</p></div>
      <div class="answer-detail" data-fact-id="reference-data-maintenance">{{ answerMarkdown.markdown(authored) }}</div>
    </div>
  {%- elif output_profile|default('review') != 'submission' -%}
    <div class="reading-gap"><p class="data-gap" data-requirement-id="SE-5b" data-fact-id="reference-data-maintenance" data-status="missing">{{ pgettext("reference-maintenance-plan", "Information not provided: how reference data created by the project will be maintained.") }}</p></div>
  {%- endif -%}
{%- endif -%}
