{# One actor anchor owns this list of duty phrases. Keep each role's complete
   meaning, including the curator's alternatives, without repeating the name.
   Append to the caller's fresh lists; include assignments would be local. #}
{% if uuids.contributorRoleDataCuratorAUuid in roles %}
  {%- do responsibilitySentences.append(pgettext("responsibility-sentences", "reviewing, enhancing, cleaning or standardizing metadata and associated data submitted to a data centre or repository for storage, use and maintenance")) -%}
  {% do mappedRoles.append(uuids.contributorRoleDataCuratorAUuid) %}
{% endif %}
{% if uuids.contributorRoleDataCollectorAUuid in roles %}
  {%- do responsibilitySentences.append(pgettext("responsibility-sentences", "finding, gathering and collecting data")) -%}
  {% do mappedRoles.append(uuids.contributorRoleDataCollectorAUuid) %}
{% endif %}
{% if uuids.contributorRoleDataManagerAUuid in roles %}
  {%- do responsibilitySentences.append(pgettext("responsibility-sentences", "maintaining the completed resource")) -%}
  {% do mappedRoles.append(uuids.contributorRoleDataManagerAUuid) %}
{% endif %}
{% if uuids.contributorRoleDataStewardAUuid in roles %}
  {%- do responsibilitySentences.append(pgettext("responsibility-sentences", "managing data and supporting its effective use, including data processing, policies, guidelines and availability")) -%}
  {% do mappedRoles.append(uuids.contributorRoleDataStewardAUuid) %}
{% endif %}
{% if uuids.contributorRoleDistributorAUuid in roles %}
  {%- do responsibilitySentences.append(pgettext("responsibility-sentences", "producing and disseminating electronic or print copies of the resource")) -%}
  {% do mappedRoles.append(uuids.contributorRoleDistributorAUuid) %}
{% endif %}
{% if uuids.contributorRoleDataProtectorAUuid in roles %}
  {%- do responsibilitySentences.append(pgettext("responsibility-sentences", "addressing personal-data protection and data-protection policies")) -%}
  {% do mappedRoles.append(uuids.contributorRoleDataProtectorAUuid) %}
{% endif %}
{% if uuids.contributorRoleCreatorOfDMPAUuid in roles %}
  {%- do responsibilitySentences.append(pgettext("responsibility-sentences", "authorship of the data management plan")) -%}
  {% do mappedRoles.append(uuids.contributorRoleCreatorOfDMPAUuid) %}
{% endif %}
