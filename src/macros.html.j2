{% import "src/answer-markdown.html.j2" as answerMarkdown with context %}
{# Formatting macros #}
{# A bounded presentation hint, not a rewrite. Unknown tags or inline styles
   may be tall despite little text and must retain ordinary pagination. #}
{%- macro shortDatasetRecord(content, label='', limit=300) -%}
  {%- set small = namespace(ok=content|length <= 5000 and label|striptags|trim|length <= 80 and (content|striptags|trim|length + label|striptags|trim|length) <= limit and content.lower().count('<p') <= 6 and content.lower().count('<li') <= 3 and content.lower().count('<div') <= 12) -%}
  {%- for fragment in content.split('<')[1:] -%}
    {%- set tag = fragment.split('>', 1)[0].split()[0]|lower if fragment.split('>', 1)[0].split() else '' -%}
    {%- if 'style' in fragment.split('>', 1)[0]|lower or tag not in ['p', '/p', 'div', '/div', 'a', '/a', 'span', '/span', 'strong', '/strong', 'em', '/em', 'ul', '/ul', 'li', '/li'] -%}{%- set small.ok = false -%}{%- endif -%}
  {%- endfor -%}
  {{- '1' if small.ok else '' -}}
{%- endmacro -%}

{%- macro projectPhase(context, knowledgeModel) -%}
  {# A present project field is authoritative, including null or empty values.
     Only older contexts without that field may use the legacy top-level value. #}
  {%- set phaseUuid = context.project.phaseUuid if context.project is defined and context.project.phaseUuid is defined else context.phaseUuid|default(none) -%}
  {%- if phaseUuid and phaseUuid in knowledgeModel.entities.phases -%}
    {%- set title = knowledgeModel.entities.phases[phaseUuid].title|default('', true) -%}
    {# Translate only unchanged official labels; retain custom/translated KM text. #}
    {%- if phaseUuid == 'b101f2d0-2476-452d-aa8d-95a41a02b52c' and title == 'Before Submitting the Proposal' -%}
      {{- pgettext("project-phase", "Before Submitting the Proposal") -}}
    {%- elif phaseUuid == '1796fa3c-9f53-475f-89ff-c66a0453c42e' and title == 'Before Submitting the DMP' -%}
      {{- pgettext("project-phase", "Before Submitting the DMP") -}}
    {%- elif phaseUuid == 'adc9133d-afcd-4616-9aea-db5f475898a2' and title == 'Before Finishing the Project' -%}
      {{- pgettext("project-phase", "Before Finishing the Project") -}}
    {%- elif phaseUuid == '1ace0fc6-a949-495f-a32e-e948f3f6bed1' and title == 'After Finishing the Project' -%}
      {{- pgettext("project-phase", "After Finishing the Project") -}}
    {%- else -%}
      {{- title|e -}}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{%- macro provenanceReading(value) -%}
  {# Conservative keep hint, never a Markdown rewrite. Unknown/complex HTML
     remains breakable. Bounds include the lead, header and every data cell. #}
  {%- set rendered = answerMarkdown.markdown(value) -%}
  {%- set small = namespace(ok=rendered.count('<table>') == 1 and rendered.count('</table>') == 1 and rendered.count('<tr>') >= 2 and rendered.count('<tr>') <= 4 and rendered|striptags|length <= 500) -%}
  {%- for fragment in rendered.split('<')[1:] -%}
    {%- if fragment.split('>')[0] not in ['p', '/p', 'table', '/table', 'thead', '/thead', 'tbody', '/tbody', 'tr', '/tr', 'th', '/th', 'td', '/td', 'strong', '/strong', 'em', '/em', 'code', '/code'] -%}
      {%- set small.ok = false -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for row in rendered.split('<tr>')[1:] -%}
    {%- set cells = row.split('</tr>')[0] -%}
    {%- if cells.count('<td>') + cells.count('<th>') > 4 -%}{%- set small.ok = false -%}{%- endif -%}
  {%- endfor -%}
  {%- set normalized = rendered|replace('<th>', '<td>')|replace('</th>', '</td>') -%}
  {%- for cell in normalized.split('<td>')[1:] -%}
    {%- if cell.split('</td>')[0]|striptags|length > 80 -%}{%- set small.ok = false -%}{%- endif -%}
  {%- endfor -%}
  {% if small.ok %}<div class="short-table-unit">{{ rendered }}</div>{% else %}{{ rendered }}{% endif %}
{%- endmacro -%}

{%- macro formatEmail(email) -%}
  <span class="contact-email"><a href="mailto:{{ email }}">{{ email }}</a></span>
{%- endmacro -%}

{%- macro formatOrcid(reply) -%}
  {%- if reply and reply.value.value.type == "IntegrationType" -%}
    {%- if reply.value.value.raw -%}
      {%- set replyObject = reply.value.value.raw -%}
      <span class="contact-orcid">{{ pgettext("macros", "ORCID:") }} <a href="https://orcid.org/{{ replyObject["orcid-id"] }}" target="_blank">{{ replyObject["orcid-id"] }}</a></span>
    {%- else -%}
      {# Extract ORCID number from the value string #}
      {%- set value = reply.value.value.value %}
      {%- set orcid = value.split('ORCID:')[-1].strip().split()[0]|replace("**", "")|markdown|replace("<p>", "")|replace("</p>", "") if 'ORCID:' in value else None %}
      {%- if orcid and orcid|length >= 15 -%}
        <span class="contact-orcid">{{ pgettext("macros", "ORCID: %(orcid)s", orcid=orcid) }}</span>
      {%- else -%}
        <span class="contact-orcid">{{ pgettext("macros", "ORCID: Not found") }}</span>
      {%- endif -%}
    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
    <span class="contact-orcid">{{ pgettext("macros", "ORCID:") }} <a href="https://orcid.org/{{ reply.value.value.value }}" target="_blank">{{ reply.value.value.value }}</a></span>
  {%- endif -%}
{%- endmacro -%}

{# Keep a short owned quantity together in PDF and Word; never bind a long free answer. #}
{%- macro quantity(value, unit) -%}
  {%- if value|trim|length <= 24 -%}
    <span class="quantity">{{ value|e }}&#160;{{ unit|e }}</span>
  {%- else -%}
    {{ value|e }} {{ unit|e }}
  {%- endif -%}
{%- endmacro -%}

{# A date-shaped field, not date validation or a rewrite of arbitrary prose. #}
{%- macro calendarDate(value) -%}
  {%- set dateText = value|string -%}
  {%- if dateText|length == 10 and dateText[4] == '-' and dateText[7] == '-' and (dateText[:4] ~ dateText[5:7] ~ dateText[8:]).isascii() and (dateText[:4] ~ dateText[5:7] ~ dateText[8:]).isdigit() -%}
    <span class="date-value" data-iso-date="{{ dateText|e }}">{{ dateText|e }}</span>
  {%- else -%}
    {{ dateText|e }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationFairSharing(reply) -%}
  {%- if reply and reply.value.value.type == "IntegrationType" -%}
    {%- if reply.value.value.raw -%}
      {%- set replyObject = reply.value.value.raw -%}
      {%- if replyObject.doi -%}
        <a href="https://doi.org/{{ replyObject.doi }}" target="_blank">{{ replyObject.name }}</a>
      {%- else -%}
        <a href="https://fairsharing.org/{{ replyObject.id }}" target="_blank">{{ replyObject.name }}</a>
      {%- endif -%}
    {%- else -%}
      {{ reply.value.value.value.rsplit(" ![]")[0]|replace("**", "")|markdown|replace("<p>", "")|replace("</p>", "") }}
    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
    {{ reply.value.value.value }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationCrossref(reply) -%}
  {%- if reply and reply.value.value.type == "IntegrationType" -%}
    {%- if reply.value.value.raw -%}
      {%- set replyObject = reply.value.value.raw -%}
      {%- set funderUri = replyObject.uri|default('', true) -%}
      {%- set funderName = replyObject.name|default('', true) -%}
      {%- set funderText = funderName if funderName|trim else funderUri -%}
      {%- if funderText|trim -%}
        {%- if funderUri|trim -%}<a href="{{ funderUri|e }}" target="_blank">{{ funderText|e }}</a>{%- else -%}{{ funderText|e }}{%- endif -%}
      {%- endif -%}
    {%- else -%}
      {{ reply.value.value.value.rsplit(" ![]")[0]|replace("**", "")|e|markdown|replace("<p>", "")|replace("</p>", "") }}
    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
    {{ reply.value.value.value|e }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationROR(reply) -%}
  {%- if reply and reply.value.value.type == "IntegrationType" -%}
    {%- if reply.value.value.raw -%}
      {%- set item = reply.value.value.raw -%}
      {% for name in item.names -%}
        {% if "ror_display" in name.types -%}
          <a href="{{ item.id }}" target="_blank">{{ name.value }}</a>
        {%- endif %}
      {%- endfor %}
      {% for name in item.names -%}
        {% if "acronym" in name.types -%}
          ({{ name.value }})
        {%- endif %}
      {%- endfor %}
    {%- else -%}
      {{ reply.value.value.value.rsplit(" ![]")[0]|replace("**", "")|markdown|replace("<p>", "")|replace("</p>", "") }}
    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
    {{ reply.value.value.value }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationCurrency(reply) -%}
  {%- if reply and reply.value.value.type == "IntegrationType" -%}
    {%- if reply.value.value.raw -%}
      {%- set replyObject = reply.value.value.raw -%}
      {{replyObject.code}} ({{replyObject.name}})
    {%- else -%}
      {{ reply.value.value.value.rsplit(" ![]")[0]|replace("**", "")|markdown|replace("<p>", "")|replace("</p>", "") }}
    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
    {{ reply.value.value.value }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationValue(reply) -%}
    {{ reply.value.value.value }}
{%- endmacro -%}

{%- set DATASET_INSTRUMENT = "instrument" -%}
{%- set DATASET_REFERENCE = "reference" -%}
{%- set DATASET_NON_REFERENCE = "non-reference" -%}
{%- set DATASET_NON_EQUIPMENT = "non-equipment" -%}
{%- set DATASET_PRODUCED = "produced" -%}
{%- macro datasetLabel(kind, index) -%}<span class="dataset-label" data-list-kind="{{ kind }}" data-list-index="{{ index }}">{%- if kind == "instrument" -%}{{ pgettext("macros", "Instrument dataset") }}{%- elif kind == "reference" -%}{{ pgettext("macros", "Reference dataset") }}{%- elif kind == "non-reference" -%}{{ pgettext("macros", "Non-reference dataset") }}{%- elif kind == "non-equipment" -%}{{ pgettext("macros", "Non-equipment dataset") }}{%- elif kind == "produced" -%}{{ pgettext("macros", "Produced dataset") }}{%- endif %} {{ index }}</span>{%- endmacro -%}

{%- macro projectLabel(index) -%}{{ pgettext("macros", "Project %(index)s", index=index) }}{%- endmacro -%}

{%- macro resourceLabel(index) -%}{{ pgettext("macros", "Resource %(index)s", index=index) }}{%- endmacro -%}

{%- macro softwareLabel(index) -%}{{ pgettext("macros", "Software tool %(index)s", index=index) }}{%- endmacro -%}

{%- macro contributorLabel(index) -%}{{ pgettext("macros", "Contributor %(index)s", index=index) }}{%- endmacro -%}

{# Original list indices remain stable when submission omits entirely empty rows. #}
{%- macro instrumentEntry(index, name, description) -%}
  <p{% if description|trim %} class="answer-lead"{% endif %}><strong>{% if name|trim %}{{ name|e }}{% else %}{{ pgettext("macros", "Instrument %(index)s", index=index) }}{% endif %}</strong>
  {% if not name|trim and not description|trim %}<span class="data-gap" data-fact-id="instrument-details" data-status="missing">{{ pgettext("macros", "Information not provided: instrument name and description.") }}</span>{% endif %}</p>
  {% if description|trim %}<div class="answer-detail">{{ answerMarkdown.markdown(description) }}</div>{% endif %}
{%- endmacro -%}
